@page
@model EduHelpdesk.Pages.People.QuickStartModel
@using EduHelpdesk.Services
@{
    Layout = null;
    var brand = Model.Branding;
    var withoutPassword = Model.Sheets.Count(x => x.Password is null);
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@(Model.Sheets.Count == 1 ? $"Quick start guide · {Model.Sheets[0].Name}" : $"Quick start guides ({Model.Sheets.Count})")</title>
<style>
    @@page { size: A4; margin: 14mm 16mm; }
    :root { --brand: @brand.PrimaryColor; --soft: @brand.AccentColor; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #eef1f1; font-family: Arial, Helvetica, sans-serif; color: #1b1f1f; font-size: 10.5pt; line-height: 1.45; }
    .toolbar { max-width: 210mm; margin: 16px auto 0; padding: 0 16px; }
    .toolbar .notice { background: #fff; border-left: 4px solid var(--brand); padding: 10px 14px; margin: 0 0 10px; font-size: 14px; }
    .toolbar .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
    .toolbar .notice a { color: var(--brand); font-weight: 700; }
    .toolbar .actions button, .toolbar .actions a { font: inherit; font-size: 14px; padding: 8px 16px; border-radius: 6px; cursor: pointer; text-decoration: none; border: 1px solid #c9d2d2; background: #fff; color: #1b1f1f; }
    .toolbar .actions .primary { background: var(--brand); border-color: var(--brand); color: #fff; }
    .sheet { max-width: 210mm; margin: 0 auto 24px; background: #fff; padding: 14mm 16mm; box-shadow: 0 1px 4px rgba(0,0,0,.12); }
    header { display: flex; align-items: center; gap: 12px; border-bottom: 3px solid var(--brand); padding-bottom: 10px; margin-bottom: 14px; }
    header img { max-height: 44px; max-width: 120px; }
    header .school { font-size: 15pt; font-weight: 700; }
    header .kind { margin-left: auto; font-size: 9pt; text-transform: uppercase; letter-spacing: .06em; color: #555; }
    h1 { font-size: 19pt; margin: 0 0 2px; color: var(--brand); }
    .for { margin: 0 0 14px; color: #444; }
    h2 { font-size: 12pt; margin: 16px 0 6px; color: var(--brand); }
    .details { border: 2px solid var(--brand); border-radius: 8px; padding: 10px 14px; background: var(--soft); }
    .details dl { display: grid; grid-template-columns: 30mm 1fr; gap: 6px 10px; margin: 0; }
    .details dt { font-weight: 700; font-size: 9.5pt; padding-top: 2px; }
    .details dd { margin: 0; font-family: Consolas, "Courier New", monospace; font-size: 12.5pt; overflow-wrap: anywhere; }
    .details .blank { display: inline-block; min-width: 70mm; border-bottom: 1px solid #333; height: 1.3em; }
    .details .hint { display: block; font-family: Arial, Helvetica, sans-serif; font-size: 8.5pt; color: #555; }
    ol, ul { margin: 0; padding-left: 20px; }
    li { margin: 0 0 5px; }
    .tips { margin-top: 16px; border-top: 1px dashed #999; padding-top: 10px; font-size: 9.5pt; color: #333; }
    footer { margin-top: 18px; font-size: 8.5pt; color: #666; display: flex; justify-content: space-between; gap: 12px; }
    @@media print {
        body { background: #fff; }
        .toolbar { display: none !important; }
        .sheet { box-shadow: none; margin: 0; padding: 0; max-width: none; }
        /* A batch prints one guide to a page, so each can be handed to its person. */
        .sheet + .sheet { break-before: page; }
        .details { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>
<script src="~/js/actions.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="toolbar">
        @if (Model.JustAdded) { <p class="notice"><strong>@Model.Sheets[0].Name's account is ready.</strong> Print this guide and give it to them.</p> }
        @if (Model.IsBatch)
        {
            <p class="notice"><strong>@Model.Sheets.Count quick start guide@(Model.Sheets.Count == 1 ? "" : "s"), one to a page, each with a temporary password.</strong> Print them now and hand them out: the passwords are only shown here for an hour, and only to you.</p>
        }
        @if (withoutPassword > 0)
        {
            <p class="notice">@(Model.Sheets.Count == 1 ? "The password isn't on this copy" : $"{withoutPassword} of these have no password on them"): it was set more than an hour ago, or the helpdesk has restarted since, and only a scrambled copy is kept. Write it on the line, or use <strong>Give them a temporary password</strong> on their account page to print a new one.</p>
        }
        @if (Model.AddressGuessed)
        {
            <p class="notice">The address, @Model.Address, was worked out from the one you're using now. @if (Model.CanSetAddress) { <a asp-page="/Settings/SignIn" asp-fragment="address">Set the address staff should use</a> } else { <text>Someone with Settings access can set the address staff should use in Settings → Sign-in security.</text> }</p>
        }
        @if (Model.Sheets.Count == 0) { <p class="notice">Nobody in this batch still has an account to print a guide for.</p> }
        <div class="actions">
            <button type="button" class="primary" data-action="print">Print@(Model.Sheets.Count > 1 ? $" all {Model.Sheets.Count}" : "")</button>
            <a href="@Model.BackUrl">Done</a>
        </div>
    </div>

    @foreach (var sheet in Model.Sheets)
    {
    <main class="sheet">
        <header>
            @if (Model.LogoVersion is { } logoVersion) { <img src="@Url.Content("~/branding/logo")?v=@logoVersion" alt="" /> }
            <span class="school">@brand.BrandName</span>
            <span class="kind">@(sheet.ForTechnician ? "IT helpdesk" : "Staff portal")</span>
        </header>

        <h1>@(sheet.ForTechnician ? "Welcome to the IT helpdesk" : "Reporting IT problems")</h1>
        <p class="for">A quick start guide for <strong>@sheet.Name</strong>@if (sheet.Technician is { } tech) { <text> · @tech.Role@(string.IsNullOrWhiteSpace(tech.Team) ? "" : $", {tech.Team}")</text> } else if (!string.IsNullOrWhiteSpace(sheet.Person!.Department)) { <text> · @sheet.Person.Department</text> }</p>

        <section class="details" aria-label="Your sign-in details">
            <dl>
                <dt>Go to</dt><dd>@Model.SignInAddress</dd>
                <dt>Email</dt><dd>@sheet.Email</dd>
                <dt>@(sheet.MustChange ? "Temporary password" : "Password")</dt>
                <dd>@if (sheet.Password is { } password) { @password } else { <span class="blank"></span><span class="hint">Given to you separately.</span> }</dd>
            </dl>
        </section>

        <h2>Signing in for the first time</h2>
        <ol>
            <li>Open a web browser on a computer in school and go to <strong>@Model.SignInAddress</strong>.@(sheet.ForTechnician ? "" : " Adding it to your favourites saves typing it next time.")</li>
            <li>Type your email and the password above, then choose <strong>Sign in</strong>.@if (!sheet.ForTechnician) { <text> Tick <em>Keep me signed in</em> only on a computer nobody else uses.</text> }</li>
            @if (sheet.MustChange) { <li>You'll be asked to <strong>choose your own password</strong> straight away. Use at least @PasswordRules.MinimumLength characters. Three random words together is easy to remember and hard to guess.</li> }
            @if (sheet.ForTechnician && Model.TwoFactorRequired)
            {
                <li>Then set up <strong>two-step sign-in</strong>. Install an authenticator app on your phone, such as Microsoft Authenticator or Google Authenticator, and scan the code the helpdesk shows. Keep the recovery codes it gives you somewhere safe: they get you in if you lose your phone.</li>
            }
            @if (sheet.ForTechnician && Model.RecoveryKeysAllowed)
            {
                <li>Make a <strong>recovery key</strong> from <em>Recovery key</em> under your name (top right), and save the recovery file somewhere private. If you ever forget your password, <em>Forgotten your password?</em> on the sign-in page uses it to set a new one.</li>
            }
        </ol>

        @if (sheet.Technician is { } technician)
        {
            <h2>Finding your way around</h2>
            <ul>
                <li><strong>Tickets</strong>: every problem reported. <em>My tickets</em> shows the ones assigned to you. Open a ticket to reply to the person who reported it, add an internal note only IT can see, change its status or assign it.</li>
                <li><strong>＋ Log a ticket</strong> (top right): for a problem you're told about by phone, by email or in person.</li>
                <li><strong>Inventory</strong>: the asset register, where you can search by asset tag or serial number to see a device's history, plus loans, kits and parts.</li>
                <li><strong>Your name</strong> (top right): change your password, @(Model.TwoFactorRequired ? "manage" : "turn on") two-step sign-in, open the staff portal, and sign out.</li>
            </ul>
            <p>What you can see and change depends on your role, <strong>@technician.Role</strong>. If something you need is missing, ask whoever looks after the helpdesk.</p>
        }
        else
        {
            <h2>Using the staff portal</h2>
            <ul>
                <li><strong>＋ Report a problem</strong>: say what's wrong and where it is. A photo of an error message helps. You'll get a ticket number to quote.</li>
                <li><strong>My tickets</strong>: follow each problem you've reported. A <em>new</em> badge means IT has replied. Open the ticket to read the reply and answer it.</li>
                @if (sheet.Person!.MayRaiseProjects) { <li><strong>＋ Request a project</strong>: ask IT to find quotes for something that needs buying. IT will put together a proposal.</li> }
                @if (sheet.Person.IsProjectLead) { <li><strong>Awaiting assignment</strong>: as project lead, you confirm each new project's priority and pass it to a technician.</li> }
                <li><strong>Change password</strong> is at the top of the page once you're signed in. If you forget your password, ask IT to set you a new one.</li>
            </ul>
        }

        <div class="tips">
            <strong>Keep your account safe.</strong> Never share your password. IT will never ask you for it. Sign out when you leave a shared computer.
            @if (sheet.Password is not null) { <text> This sheet shows a password, so keep it private and shred it once you've signed in@(sheet.MustChange ? " and chosen your own" : "").</text> }
        </div>

        <footer><span>@brand.BrandName · @(sheet.ForTechnician ? "IT helpdesk" : "staff portal") quick start</span><span>Printed @DateTime.Now.ToString("d MMMM yyyy")</span></footer>
    </main>
    }
</body>
</html>
