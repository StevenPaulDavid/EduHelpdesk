@page
@model EduHelpdesk.Pages.People.RoleModel
@{ ViewData["Title"] = Model.CurrentName is null ? "Add role" : "Edit role"; }
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/People">← Back</a></div>
<section class="panel"><form method="post" class="settings-form permission-form">
    <input type="hidden" name="currentName" value="@Model.CurrentName" />
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <label class="field-narrow">Name<input name="name" value="@Model.Role?.Name" required /></label>

    <div>
        <p class="eyebrow">What this role can reach</p>
        <p class="muted">Each level includes the ones below it — Edit can also view, Delete can also edit. A module set to no access is hidden from the menu entirely.</p>
        @* Levels were a two-column table, which forced a wide row for every module and put a full-width dropdown beside
           a paragraph of description. Cards wrap to whatever the panel is, so nothing is pushed past its edge. *@
        <div class="permission-legend">
            @foreach (var level in EduHelpdesk.Pages.People.RoleModel.AllLevels)
            {
                <span><b>@EduHelpdesk.Pages.People.RoleModel.LevelLabel(level)</b> @EduHelpdesk.Pages.People.RoleModel.LevelDescription(level)</span>
            }
        </div>
        <div class="permission-cards">
        @foreach (var module in Model.AllModules)
        {
            <div class="permission-card">
                <span><strong>@module.Label</strong><small class="muted">@module.Description</small></span>
                <select name="level.@module.Key">
                    <option value="None" selected="@(Model.LevelOf(module.Key) == PermissionLevel.None)">No access</option>
                    @foreach (var level in EduHelpdesk.Pages.People.RoleModel.LevelsFor(module))
                    {
                        <option value="@level" selected="@(Model.LevelOf(module.Key) == level)">@EduHelpdesk.Pages.People.RoleModel.LevelLabel(level)</option>
                    }
                </select>
            </div>
        }
        </div>
    </div>

    @foreach (var group in Model.AllFlags.GroupBy(x => x.Group))
    {
        <div>
            <p class="eyebrow">@group.Key</p>
            <div class="permission-cards">
            @foreach (var f in group)
            {
                <label class="permission-card permission-toggle">
                    <input type="checkbox" name="flag" value="@f.Key" checked="@Model.HasFlag(f.Key)" />
                    <span><strong>@f.Label</strong><small class="muted">@f.Description</small></span>
                </label>
            }
            </div>
        </div>
    }

    <div><button class="button button-primary">Save role</button></div>
</form></section>
