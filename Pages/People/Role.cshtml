@page
@using EduHelpdesk.Pages.People
@model RoleModel
@{ ViewData["Title"] = Model.CurrentName is null ? "Add role" : "Edit role"; }
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/People" asp-route-tab="roles">← Back</a></div>
<section class="panel"><form method="post" class="settings-form permission-form">
    <input type="hidden" name="currentName" value="@Model.CurrentName" />
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <label class="field-narrow">Name<input name="name" value="@Model.Role?.Name" required /></label>

    <div>
        <p class="eyebrow">What this role can do</p>
        <p class="muted">Every box is on its own — ticking Delete does not tick Access. A module with nothing ticked is hidden from the menu entirely. Blank cells are actions that module does not have.</p>
        <div class="table-wrap"><table class="permission-grid">
            <thead>
                <tr>
                    <th scope="col">Module</th>
                    @foreach (var action in RoleModel.AllActions)
                    {
                        <th scope="col">
                            @RoleModel.ActionLabel(action)
                            <small class="muted">@RoleModel.ActionDescription(action)</small>
                            @* Ticks or clears the whole column. Progressive enhancement: with scripting off the header
                               box simply does nothing and every row is still set by hand. *@
                            <input type="checkbox" class="permission-all" data-column="@action" aria-label="Tick @RoleModel.ActionLabel(action) for every module" />
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var module in Model.AllModules)
            {
                <tr>
                    <th scope="row"><strong>@module.Label</strong><small class="muted">@module.Description</small></th>
                    @foreach (var action in RoleModel.AllActions)
                    {
                        <td data-label="@RoleModel.ActionLabel(action)">
                            @if (RoleModel.Offers(module, action))
                            {
                                <input type="checkbox" name="grant" value="@(module.Key + "." + action)" data-column="@action"
                                       checked="@Model.IsTicked(module.Key, action)"
                                       aria-label="@module.Label: @RoleModel.ActionLabel(action)" />
                            }
                            else
                            {
                                <span class="permission-na" aria-label="Not available">—</span>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table></div>
    </div>

    @foreach (var group in Model.AllFlags.GroupBy(x => x.Group))
    {
        <div>
            <p class="eyebrow">@group.Key</p>
            <div class="permission-cards">
            @foreach (var f in group)
            {
                <label class="permission-card permission-toggle">
                    <input type="checkbox" name="flag" value="@f.Key" checked="@Model.HasFlag(f.Key)" />
                    <span><strong>@f.Label</strong><small class="muted">@f.Description</small></span>
                </label>
            }
            </div>
        </div>
    }

    <div><button class="button button-primary">Save role</button></div>
</form></section>

@section Scripts {
<script src="~/js/pages/role-editor.js" asp-append-version="true"></script>
}
