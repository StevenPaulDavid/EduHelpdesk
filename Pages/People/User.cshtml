@page
@model EduHelpdesk.Pages.People.UserModel
@{ ViewData["Title"] = Model.Person is null ? "Add user" : "Edit user"; }
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/People">← Back</a></div>
<section class="panel"><form method="post" class="settings-form"><input type="hidden" name="id" value="@Model.Person?.Id" /><div asp-validation-summary="All" class="validation-summary-errors"></div><label>Name<input name="name" value="@Model.Person?.Name" required /></label><label>Email<input name="email" type="email" value="@Model.Person?.Email" required /></label><label>Department<select name="department"><option value="">Select a department</option>@foreach(var x in Model.Departments){<option value="@x" selected="@(x==Model.Person?.Department)">@x</option>}</select></label><label>Location<select name="location"><option value="">Unassigned</option>@foreach(var x in Model.Locations){<option value="@x" selected="@(x==Model.Person?.Location)">@x</option>}</select></label><button class="button button-primary">Save user</button></form></section>
