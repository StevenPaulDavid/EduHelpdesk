@page
@model EduHelpdesk.Pages.People.UserModel
@{ ViewData["Title"] = "Add requester"; }
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/People">← Back</a></div>
@* field-narrow keeps the inputs at a readable measure - unconstrained they stretch the full width of the panel. *@
<section class="panel"><form method="post" class="settings-form field-narrow"><div asp-validation-summary="All" class="validation-summary-errors"></div><label>Name<input name="name" required /></label><label>Email<input name="email" type="email" required /></label><label>Department<select name="department"><option value="">Select a department</option>@foreach(var x in Model.Departments){<option value="@x">@x</option>}</select></label><label>Location<select name="location"><option value="">Unassigned</option>@foreach(var x in Model.Locations){<option value="@x">@x</option>}</select></label><label>Active account?<select name="active"><option value="true" selected>Active - can sign in to the staff portal</option><option value="false">Inactive - blocked from the staff portal</option></select></label><label class="toggle-label"><input type="checkbox" name="canRaiseProjects" value="true" /> Can raise projects <small class="muted">For line managers and SLT: lets them ask IT to source and quote for purchases from the staff portal.</small></label><label class="toggle-label"><input type="checkbox" name="isProjectLead" value="true" /> Project lead <help-tip key="person.projects" /> <small class="muted">Confirms each project's priority and assigns the technician, from the staff portal. Can also raise projects.</small></label><label>Password<input name="password" type="password" placeholder="Leave blank for a temporary password" autocomplete="new-password" maxlength="@EduHelpdesk.Services.PasswordRules.MaximumLength" /><small class="muted">For the staff portal. Left blank, the helpdesk makes up a temporary password and they choose their own the first time they sign in. A password you type here is theirs to keep.</small></label><button class="button button-primary">Add requester</button></form></section>
