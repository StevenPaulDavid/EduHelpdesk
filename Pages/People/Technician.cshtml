@page
@model EduHelpdesk.Pages.People.TechnicianModel
@{ ViewData["Title"] = Model.Technician is null ? "Add technician" : "Edit technician"; }
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/People" asp-route-tab="technicians">← Back</a></div>
@* field-narrow keeps the inputs at a readable measure - unconstrained they stretch the full width of the panel. *@
<section class="panel"><form method="post" class="settings-form field-narrow"><input type="hidden" name="id" value="@Model.Technician?.Id" /><div asp-validation-summary="All" class="validation-summary-errors"></div><label>Name<input name="name" value="@Model.Technician?.Name" required /></label><label>Email<input name="email" type="email" value="@Model.Technician?.Email" required /></label><label>Team<select name="team" required><option value="">Select a team</option>@foreach(var x in Model.Teams){<option value="@x" selected="@(x==Model.Technician?.Team)">@x</option>}</select></label>@if (Model.IsSelf) { <label>Role<input value="@Model.Technician!.Role" disabled /><small class="muted">You can't change your own role or switch off your own account - another administrator can.</small></label><input type="hidden" name="role" value="@Model.Technician.Role" /><input type="hidden" name="active" value="true" /> } else { <label>Role<select name="role" required>@foreach(var x in Model.Roles){<option value="@x" selected="@(x==(Model.Technician?.Role ?? EduHelpdesk.Models.StaffRoles.DefaultRole))">@x</option>}</select></label><label>Active account?<select name="active"><option value="true" selected="@(Model.Technician is null || Model.Technician.IsActive)">Active - can sign in</option><option value="false" selected="@(Model.Technician is { IsActive: false })">Inactive - blocked from signing in</option></select></label> }<label>@(Model.Technician is null ? "Password" : "Reset password")<input name="password" type="password" placeholder="@(Model.Technician is null ? "Leave blank if they'll sign in later" : "Leave blank to keep the current password")" autocomplete="new-password" maxlength="@EduHelpdesk.Services.PasswordRules.MaximumLength" /><small class="muted">At least @EduHelpdesk.Services.PasswordRules.MinimumLength characters. @(Model.IsSelf ? "" : "They'll be asked to choose their own the first time they sign in.")</small></label><button class="button button-primary">Save technician</button></form></section>
@if (!string.IsNullOrWhiteSpace(TempData["Message"] as string)) { <div class="notice">@TempData["Message"]</div> }
@if (Model.Technician is { } person && !Model.IsSelf)
{
    <section class="panel">
        <h2>Two-step sign-in</h2>
        @if (person.TwoFactor is { } twoFactor)
        {
            <p>On since @twoFactor.EnabledAt.ToLocalTime().ToString("d MMMM yyyy"), with @twoFactor.RecoveryCodeHashes.Count recovery code@(twoFactor.RecoveryCodeHashes.Count == 1 ? "" : "s") left.</p>
            <p class="muted">If they have lost their phone and their recovery codes, reset it. They then sign in with their password alone @(Model.TwoFactorRequired ? "and are asked to set it up again straight away." : "until they set it up again.")</p>
            <form method="post" asp-page-handler="ResetTwoFactor" data-confirm="Reset @person.Name's two-step sign-in? Their authenticator app and recovery codes stop working.">
                <input type="hidden" name="id" value="@person.Id" />
                <button class="button button-danger">Reset two-step sign-in</button>
            </form>
        }
        else
        {
            <p class="muted">Not set up.@(Model.TwoFactorRequired ? " It is required, so they'll be asked to set it up the next time they use the helpdesk." : " They can turn it on from Two-step sign-in in their account menu.")</p>
        }
    </section>
}
