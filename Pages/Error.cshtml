@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK</p><h1>Something went wrong</h1><p class="hero-copy">The helpdesk couldn't finish that request.</p></div>
</div>
<section class="panel">
    <p>If you were saving something, check whether it was saved before trying again.</p>
    <p>If it keeps happening, tell whoever looks after the helpdesk and give them this reference: <code>@Model.RequestId</code>. The details are in the helpdesk's error log (Settings → Error log) under that reference.</p>
    <p><a class="button button-secondary" href="/">Back to the start</a></p>
</section>
