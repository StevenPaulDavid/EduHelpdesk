@page
@model PartsModel
@{ ViewData["Title"] = "Parts"; }<div class="page-heading"><div><p class="eyebrow">INVENTORY</p><h1>Parts</h1></div><a class="button button-primary" asp-page="/Parts/Edit">＋ Add part</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }
<section class="panel directory-panel"><div class="panel-heading"><h2>Parts inventory</h2><span class="badge">@Model.Parts.Count</span></div>
@foreach (var item in Model.Parts)
{
    <div class="directory-row">
        <div class="directory-person">
            <div class="avatar">@(item.Name.Length > 0 ? item.Name[..1].ToUpperInvariant() : "P")</div>
            <div><strong><a asp-page="/Parts/Edit" asp-route-id="@item.Id">@item.Name</a></strong><span>@(string.IsNullOrWhiteSpace(item.Sku) ? "No SKU" : item.Sku) · @(string.IsNullOrWhiteSpace(item.Category) ? "Uncategorized" : item.Category)@(string.IsNullOrWhiteSpace(item.Location) ? "" : $" · {item.Location}")</span></div>
        </div>
        <div class="row-actions">
            <span class="badge @(Model.IsLow(item) ? "badge-warning" : "")">@item.QuantityOnHand in stock</span>
            <a class="icon-button" asp-page="/Parts/Edit" asp-route-id="@item.Id">✎</a>
            <a class="icon-button delete-icon" asp-page="/Parts/Delete" asp-route-id="@item.Id">♜</a>
        </div>
    </div>
}
@if (Model.Parts.Count == 0) { <p class="empty">No parts have been added yet.</p> }
</section>
