@page
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Loans.ReportModel
@{ ViewData["Title"] = "Loan report"; }
<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / LOAN KITS</p><h1>Loan report</h1><p class="hero-copy">Who is borrowing loan kits, how often, and why.</p></div>
    <div class="heading-actions">
        <a class="button button-secondary" asp-page="/Loans">← Loans</a>
        <a class="button button-primary" asp-page="/Loans/ReportPrint" asp-route-period="@Model.PeriodKey" asp-route-reason="@Model.Reason" target="_blank">🖨 Print / Save as PDF</a>
    </div>
</div>

<section class="panel">
    <form method="get" class="audit-filters">
        <label>Period<select name="period">@foreach (var p in EduHelpdesk.Pages.Loans.ReportModel.Periods) { <option value="@p.Key" selected="@(p.Key == Model.PeriodKey)">@p.Label</option> }</select></label>
        <label>Reason<select name="reason"><option value="">All reasons</option>@foreach (var r in Model.Reasons) { <option value="@r" selected="@string.Equals(r, Model.Reason, StringComparison.OrdinalIgnoreCase)">@r</option> }</select></label>
        <div class="audit-filter-actions"><button class="button button-primary" type="submit">Apply</button><a class="button button-secondary" asp-page="/Loans/Report">Reset</a></div>
    </form>
</section>

<div class="metrics">
    <div class="metric"><span>Loans in period</span><strong>@Model.Loans.Count</strong><small>@Model.PeriodLabel</small></div>
    <div class="metric"><span>Different borrowers</span><strong>@Model.Borrowers.Count</strong><small>People who took a kit</small></div>
    <div class="metric"><span>Flagged</span><strong>@Model.Flagged.Count</strong><small>@Model.RepeatCount+ in @Model.RepeatDays days</small></div>
    <div class="metric"><span>Out now</span><strong>@Model.Out.Count</strong><small>@Model.OverdueCount overdue</small></div>
</div>

<section class="panel" id="flagged">
    <div class="panel-heading"><div><p class="eyebrow">NEEDS A CONVERSATION</p><h2>Repeat borrowers</h2></div><span class="badge @(Model.Flagged.Count > 0 ? "badge-warning" : "")">@Model.Flagged.Count</span></div>
    <p class="muted">Anyone who has taken <strong>@Model.RepeatCount or more</strong> kits in the last <strong>@Model.RepeatDays days</strong>. The threshold is set in Settings. Reasons are shown so genuine cases — supply staff, devices in repair — can be told apart from people repeatedly forgetting their own.</p>
    <div class="table-wrap"><table><thead><tr><th>Person</th><th>Loans</th><th>Reasons</th><th>Most recent</th><th>Still out</th></tr></thead><tbody>
    @foreach (var row in Model.Flagged)
    {
        <tr>
            <td><strong>@row.Name</strong></td>
            <td><span class="badge badge-warning">@row.Count</span></td>
            <td>@string.Join(", ", row.ByReason.Select(x => $"{x.Reason} ({x.Count})"))</td>
            <td>@row.LastIssued.ToLocalTime().ToString("dd MMM yyyy")</td>
            <td>@(row.StillOut > 0 ? row.StillOut.ToString() : "—")</td>
        </tr>
    }
    @if (Model.Flagged.Count == 0) { <tr><td colspan="5" class="empty">Nobody has hit the threshold in the last @Model.RepeatDays days.</td></tr> }
    </tbody></table></div>
</section>

<section class="panel" id="borrowers">
    <div class="panel-heading"><div><p class="eyebrow">BY PERSON</p><h2>Everyone who borrowed a kit</h2></div><span class="badge">@Model.PeriodLabel</span></div>
    @foreach (var row in Model.Borrowers)
    {
        <details class="loan-person" open="@(Model.IsFlagged(row))">
            <summary>
                <strong>@row.Name</strong>
                <span class="badge @(Model.IsFlagged(row) ? "badge-warning" : "")">@row.Count loan@(row.Count == 1 ? "" : "s")</span>
                <span class="muted">@string.Join(", ", row.ByReason.Select(x => $"{x.Reason} ({x.Count})"))</span>
            </summary>
            <div class="table-wrap"><table><thead><tr><th>Issued</th><th>Kit</th><th>Reason</th><th>Due back</th><th>Returned</th><th>Kept</th></tr></thead><tbody>
            @foreach (var loan in row.Loans)
            {
                <tr>
                    <td>@loan.IssuedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                    <td>@Model.KitName(loan.KitId)</td>
                    <td>@loan.Reason</td>
                    <td>@AssetInsights.Format(loan.DueBack)</td>
                    <td>@(loan.ReturnedAt is null ? "—" : loan.ReturnedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm"))</td>
                    <td>@Model.Duration(loan)@if (loan.ReturnedAt is null) { <text> </text><span class="badge @(loan.DueBack < Model.Today ? "badge-warning" : "")">still out</span> }</td>
                </tr>
            }
            </tbody></table></div>
        </details>
    }
    @if (Model.Borrowers.Count == 0) { <p class="empty">No kits were issued in this period.</p> }
</section>

<section class="panel" id="reasons">
    <div class="panel-heading"><div><p class="eyebrow">WHY</p><h2>Reason breakdown</h2></div><span class="badge">@Model.Loans.Count loans</span></div>
    <div class="table-wrap"><table><thead><tr><th>Reason</th><th>Loans</th><th>Share</th></tr></thead><tbody>
    @foreach (var (reason, count) in Model.ReasonBreakdown)
    {
        var share = Model.Loans.Count == 0 ? 0 : count * 100.0 / Model.Loans.Count;
        <tr>
            <td>@reason</td>
            <td>@count</td>
            <td class="report-share"><div class="bar"><span style="width:@share.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div><small class="muted">@share.ToString("0")%</small></td>
        </tr>
    }
    @if (Model.ReasonBreakdown.Count == 0) { <tr><td colspan="3" class="empty">No loans in this period.</td></tr> }
    </tbody></table></div>
</section>

<section class="panel" id="out">
    <div class="panel-heading"><div><p class="eyebrow">STILL OUT</p><h2>Currently on loan</h2></div><span class="badge @(Model.OverdueCount > 0 ? "badge-warning" : "")">@Model.Out.Count</span></div>
    <div class="table-wrap"><table><thead><tr><th>Kit</th><th>Borrower</th><th>Reason</th><th>Issued</th><th>Due back</th><th>Out for</th></tr></thead><tbody>
    @foreach (var loan in Model.Out)
    {
        var overdue = loan.DueBack < Model.Today;
        <tr>
            <td><strong>@Model.KitName(loan.KitId)</strong></td>
            <td>@loan.BorrowerName</td>
            <td>@loan.Reason</td>
            <td>@loan.IssuedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
            <td><span class="badge @(overdue ? "badge-warning" : "")">@AssetInsights.Format(loan.DueBack)</span></td>
            <td>@Model.Duration(loan)</td>
        </tr>
    }
    @if (Model.Out.Count == 0) { <tr><td colspan="6" class="empty">Every kit is back in.</td></tr> }
    </tbody></table></div>
</section>
