@page
@using EduHelpdesk.Services
@model AssetsModel
@{
    ViewData["Title"] = "Assets";
}

<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / ASSET REGISTER</p><h1>Assets</h1><p class="hero-copy">Track school equipment and keep its ticket history connected.</p></div>
    <div class="heading-actions"><a class="button button-secondary" asp-page="/Index">← Overview</a>@if (Model.CanAdd) { <a class="button button-secondary" asp-page="/Assets/Import">Import from CSV</a><a class="button button-primary" asp-page="/Assets/Add">＋ Add asset</a> }</div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<section class="panel">
    <form method="get" class="audit-filters asset-filters">
        <label class="audit-search">Search<input type="search" name="q" value="@Model.Search" placeholder="Tag, serial number, make, model, location, holder, purchase order" /></label>
        <label>Status<select name="status"><option value="">Any status</option>@foreach (var item in Model.Statuses) { <option value="@item" selected="@string.Equals(item, Model.Status, StringComparison.OrdinalIgnoreCase)">@item</option> }</select></label>
        <label>Type<select name="type"><option value="">Any type</option>@foreach (var item in Model.AssetTypes) { <option value="@item" selected="@string.Equals(item, Model.Type, StringComparison.OrdinalIgnoreCase)">@item</option> }</select></label>
        <label>Make<select name="make"><option value="">Any make</option>@foreach (var item in Model.AssetMakes) { <option value="@item" selected="@string.Equals(item, Model.Make, StringComparison.OrdinalIgnoreCase)">@item</option> }</select></label>
        <label>Location<select name="location"><option value="">Any location</option><option value="@AssetListQuery.None" selected="@(Model.Location == AssetListQuery.None)">(No location)</option>@foreach (var item in Model.Locations) { <option value="@item" selected="@string.Equals(item, Model.Location, StringComparison.OrdinalIgnoreCase)">@item</option> }</select></label>
        <label>Held by<select name="holder" data-picker><option value="">Anyone</option><option value="none" selected="@(Model.Holder == "none")">Unassigned</option>@foreach (var item in Model.Users) { <option value="@item.Id" selected="@(item.Id.ToString() == Model.Holder)">@item.Name</option> }</select></label>
        <label>Show<select name="flag"><option value="">All assets</option><option value="review" selected="@(Model.Flag == "review")">Needs review</option><option value="loan" selected="@(Model.Flag == "loan")">On loan</option><option value="overdue" selected="@(Model.Flag == "overdue")">Loan overdue</option></select></label>
        <label>Per page<select name="size">@foreach (var size in AssetsModel.PageSizes) { <option value="@size" selected="@(size == Model.Size)">@size</option> }</select></label>
        <input type="hidden" name="sort" value="@(Model.Sort == "tag" ? "" : Model.Sort)" />
        <input type="hidden" name="dir" value="@(Model.Descending ? "desc" : "")" />
        <div class="audit-filter-actions"><button class="button button-primary" type="submit">Apply filters</button><a class="button button-secondary" asp-page="/Assets">Clear</a></div>
    </form>
</section>

<section class="panel directory-panel">
    <div class="panel-heading"><div><p class="eyebrow">EQUIPMENT</p><h2>Asset register</h2></div><span class="badge">@(Model.IsFiltered ? $"{Model.MatchCount} of {Model.TotalAssets}" : Model.TotalAssets.ToString())</span></div>
    <form method="post" asp-page-handler="Bulk" id="bulk-form" data-match-count="@Model.MatchCount" data-noun="asset" data-nouns="assets">
        <input type="hidden" name="q" value="@Model.Search" />
        <input type="hidden" name="status" value="@Model.Status" />
        <input type="hidden" name="type" value="@Model.Type" />
        <input type="hidden" name="make" value="@Model.Make" />
        <input type="hidden" name="location" value="@Model.Location" />
        <input type="hidden" name="holder" value="@Model.Holder" />
        <input type="hidden" name="flag" value="@Model.Flag" />
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="dir" value="@Model.Dir" />
        <input type="hidden" name="p" value="@Model.PageNumber" />
        <input type="hidden" name="size" value="@Model.Size" />
        <input type="hidden" name="selectAll" id="select-all-matching" value="false" />
        <div class="select-banner" id="select-banner" hidden></div>
        <div class="table-wrap"><table class="asset-table stack-table"><thead><tr>
            <th data-stack="check">@if (Model.CanView) { <input id="select-page" type="checkbox" aria-label="Select all assets on this page" /> }</th>
            <th data-stack="head"><a class="sort-link" href="@Model.SortUrl("tag")">Asset@(Model.SortMark("tag"))</a> <span class="muted">/</span> <a class="sort-link" href="@Model.SortUrl("model")">Make and model@(Model.SortMark("model"))</a></th>
            <th><a class="sort-link" href="@Model.SortUrl("type")">Type@(Model.SortMark("type"))</a></th>
            <th><a class="sort-link" href="@Model.SortUrl("serial")">Serial number@(Model.SortMark("serial"))</a></th>
            <th><a class="sort-link" href="@Model.SortUrl("holder")">Held by@(Model.SortMark("holder"))</a></th>
            <th><a class="sort-link" href="@Model.SortUrl("location")">Location@(Model.SortMark("location"))</a></th>
            <th><a class="sort-link" href="@Model.SortUrl("status")">Status@(Model.SortMark("status"))</a></th>
            <th><a class="sort-link" href="@Model.SortUrl("warranty")">Warranty ends@(Model.SortMark("warranty"))</a></th>
            <th>Tickets</th><th></th>
        </tr></thead><tbody>
        @foreach (var asset in Model.Rows)
        {
            var holder = asset.AssignedUserId is { } holderId ? Model.UserNames.GetValueOrDefault(holderId) : null;
            var overdue = asset.AssignedUserId is not null && asset.LoanDueDate is { } due && due < Model.Today;
            var expired = asset.WarrantyEnd is { } ends && ends < Model.Today;
            <tr>
                <td>@if (Model.CanView) { <input class="asset-select" type="checkbox" name="ids" value="@asset.Id" aria-label="Select asset @asset.AssetTag" /> }</td>
                <td><strong>@if (Model.CanView) { <a asp-page="/Asset" asp-route-id="@asset.Id">@asset.AssetTag</a> } else { @asset.AssetTag }</strong><br /><span class="muted">@asset.Make @asset.Model</span></td>
                <td>@asset.Type</td>
                <td>@asset.SerialNumber</td>
                <td>@(holder ?? "—")@if (asset.AssignedUserId is not null && asset.LoanDueDate is { } loanDue) { <br /><span class="badge @(overdue ? "badge-warning" : "")">Loan due @AssetInsights.Format(loanDue)</span> }</td>
                <td>@asset.Location</td>
                <td><span class="status">@asset.Status</span></td>
                <td>@if (asset.WarrantyEnd is { } warrantyEnd) { <span>@AssetInsights.Format(warrantyEnd)</span> @if (expired) { <br /><span class="badge badge-warning">Expired</span> } } else { <span class="muted">—</span> }</td>
                <td>@if (Model.TicketCounts.GetValueOrDefault(asset.Id) > 0) { <a asp-page="/Jobs" asp-route-asset="@asset.Id" asp-route-view="all" title="Show these tickets"><span class="badge">@Model.TicketCounts.GetValueOrDefault(asset.Id)</span></a> } else { <span class="badge">0</span> }</td>
                <td class="asset-row-actions">@if (Model.CanView) { <a class="icon-button" asp-page="/Asset" asp-route-id="@asset.Id" title="Edit asset">✎</a> }@if (Model.CanDelete) { <a class="icon-button delete-icon" asp-page="/Assets/Delete" asp-route-id="@asset.Id" title="Delete asset">♜</a> }</td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="10" class="empty">@(Model.IsFiltered ? "No assets match these filters." : "No assets have been added yet.")</td></tr> }
        </tbody></table></div>

        @if (Model.Rows.Count > 0 && Model.CanView)
        {
            <div class="bulk-actions">
                <strong>With selected assets</strong>
                <span class="muted" id="selected-count">None selected</span>
                <label>Action<select name="operation" id="bulk-operation">@if (Model.CanEdit) { <option value="status">Change status</option><option value="owner">Reassign owner</option><option value="location">Change location</option> }<option value="export" data-button="Export selected">Export to CSV</option></select></label>
                @if (Model.CanEdit)
                {
                    <label id="bulk-status-field">New status<select name="newStatus">@foreach (var item in Model.Statuses) { <option value="@item">@item</option> }</select></label>
                    <label id="bulk-owner-field" hidden>New owner<select name="newOwner" disabled data-picker><option value="none">Nobody (unassigned)</option>@foreach (var item in Model.Users) { <option value="@item.Id">@item.Name</option> }</select></label>
                    <label id="bulk-location-field" hidden>New location<select name="newLocation" disabled><option value="@AssetListQuery.None">No location</option>@foreach (var item in Model.Locations) { <option value="@item">@item</option> }</select></label>
                }
                <button class="button button-primary" type="submit" id="bulk-apply">Apply to selected</button>
            </div>
        }
    </form>

    @if (Model.TotalPages > 1)
    {
        <div class="audit-pager">
            @if (Model.PageNumber > 1) { <a class="button button-secondary" href="@Model.PageUrl(Model.PageNumber - 1)">← Previous</a> } else { <span></span> }
            <span class="muted">Showing @((Model.PageNumber - 1) * Model.Size + 1)–@Math.Min(Model.PageNumber * Model.Size, Model.MatchCount) of @Model.MatchCount · page @Model.PageNumber of @Model.TotalPages</span>
            @if (Model.PageNumber < Model.TotalPages) { <a class="button button-secondary" href="@Model.PageUrl(Model.PageNumber + 1)">Next →</a> } else { <span></span> }
        </div>
    }
</section>

@section Scripts {
<script src="~/js/bulk-select.js" asp-append-version="true"></script>
}
