@page
@model AssetsModel
@{
    ViewData["Title"] = "Assets";
}

<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / ASSET REGISTER</p><h1>Assets</h1><p class="hero-copy">Track school equipment and keep its ticket history connected.</p></div>
    <div class="heading-actions"><a class="button button-secondary" asp-page="/Index">← Overview</a><a class="button button-primary" asp-page="/Assets/Add">＋ Add asset</a></div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<section class="panel directory-panel">
    <div class="panel-heading"><div><p class="eyebrow">EQUIPMENT</p><h2>Asset register</h2></div><span class="badge">@Model.Assets.Count</span></div>
    <div class="directory-list">
    @foreach (var asset in Model.Assets)
    {
        var owner = Model.Users.FirstOrDefault(x => x.Id == asset.AssignedUserId);
        var assetTickets = Model.Tickets.Where(x => x.AssetIds.Contains(asset.Id)).ToList();
        <div class="directory-row"><div class="directory-person"><div class="avatar asset-avatar">▣</div><div><strong><a asp-page="/Asset" asp-route-id="@asset.Id">@asset.AssetTag · @asset.Make @asset.Model</a></strong><span>@asset.Type · @asset.SerialNumber · @(owner?.Name ?? "Unassigned") · @asset.Location</span></div></div><div class="row-actions"><span class="badge">@assetTickets.Count tickets</span><a class="icon-button" asp-page="/Asset" asp-route-id="@asset.Id" title="Edit asset">✎</a><a class="icon-button delete-icon" asp-page="/Assets/Delete" asp-route-id="@asset.Id" title="Delete asset">♜</a></div></div>
    }
    @if (Model.Assets.Count == 0) { <p class="empty">No assets have been added yet.</p> }
    </div>
</section>
