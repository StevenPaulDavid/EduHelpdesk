@page
@model EduHelpdesk.Pages.Portal.IndexModel
@{ ViewData["Title"] = "Staff portal"; }
<div class="portal-shell">
    <div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>Report a problem</h1><p class="hero-copy">Log a job with the IT team, or check on one you've already sent in.</p></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }
    @if (Model.CurrentUser is null)
    {
        <section class="panel portal-panel">
            <h2>Who are you?</h2>
            <form method="post" asp-page-handler="Choose" class="settings-form">
                <label>Your name<select name="userId" required><option value="">Select your name…</option>@foreach (var user in Model.Users) { <option value="@user.Id">@user.Name · @user.Department</option> }</select></label>
                <button class="button button-primary portal-button" type="submit">Continue</button>
            </form>
        </section>
    }
    else
    {
        <p class="muted">Signed in as <strong>@Model.CurrentUser.Name</strong> · <form method="post" asp-page-handler="Switch" style="display:inline"><button type="submit" class="link-button">Not you? Switch</button></form></p>
        <div class="portal-actions">
            <a class="button button-primary portal-button" asp-page="/Portal/NewTicket">＋ Report a problem</a>
            <a class="button button-secondary portal-button" asp-page="/Portal/MyTickets">My tickets</a>
        </div>
    }
</div>
