@page
@model EduHelpdesk.Pages.Portal.IndexModel
@{ ViewData["Title"] = "Staff portal"; }
<div class="portal-shell">
    <div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>Report a problem</h1><p class="hero-copy">Log a job with the IT team, or check on one you've already sent in.</p></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }
    @if (Model.CurrentUser is null && Model.SignedInTechnician is { } technician)
    {
        <section class="panel portal-panel">
            <h2>Continue as @technician.Name</h2>
            <p class="muted">You're signed in to the helpdesk, so there's no need for a separate portal password.</p>
            <a class="button button-primary portal-button" asp-page="/Portal/Index" asp-page-handler="Technician">Continue as @technician.Name</a>
        </section>
    }
    else if (Model.CurrentUser is null)
    {
        <section class="panel portal-panel">
            <h2>Sign in</h2>
            <form method="post" asp-page-handler="Login" class="settings-form">
                <div asp-validation-summary="All" class="validation-summary-errors"></div>
                <label>Email<input asp-for="Email" type="email" maxlength="254" autocomplete="username" required autofocus /></label>
                <label>Password<input asp-for="Password" type="password" maxlength="256" autocomplete="current-password" required /></label>
                <label class="toggle-label"><input asp-for="Remember" type="checkbox" /> Keep me signed in on this device for 30 days</label>
                <p class="muted">Leave that unticked on a shared or staffroom computer - you'll be signed out when the browser closes, or after two hours without using the portal.</p>
                <button class="button button-primary portal-button" type="submit">Sign in</button>
                <p class="muted">Forgotten your password? Ask the IT team to set you a new one.</p>
            </form>
        </section>
    }
    else
    {
        @* A div, not a p: a form can't sit inside a paragraph, so the browser used to end it early and drop Sign out onto a line of its own. *@
        <div class="muted portal-account">Signed in as <strong>@Model.CurrentUser.Name</strong> · @if (Model.SessionKind != EduHelpdesk.Services.PortalIdentity.Kind.Technician) { <a asp-page="/Portal/Password">Change password</a><text> · </text> }<form method="post" asp-page-handler="Switch" style="display:inline"><button type="submit" class="link-button">Sign out</button></form></div>
        <div class="portal-actions">
            <a class="button button-primary portal-button" asp-page="/Portal/NewTicket">＋ Report a problem</a>
            <a class="button button-secondary portal-button" asp-page="/Portal/MyTickets">My tickets @if (Model.TicketsWithNews > 0) { <span class="badge badge-reply" title="Tickets with a reply you haven't read yet">@Model.TicketsWithNews new</span> }</a>
        </div>
        @if (Model.CurrentUser.MayRaiseProjects || Model.HasProjects)
        {
            <h2 class="portal-subheading">Projects</h2>
            <p class="muted">@(Model.CurrentUser.IsProjectLead ? "Assign new projects to a technician, or raise one yourself." : "Need something bought? Ask the IT team to gather quotes and put together a proposal.")</p>
            <div class="portal-actions">
                @if (Model.CurrentUser.MayRaiseProjects) { <a class="button button-primary portal-button" asp-page="/Portal/NewProject">＋ Request a project</a> }
                @if (Model.CurrentUser.IsProjectLead)
                {
                    <a class="button button-secondary portal-button" asp-page="/Portal/Projects">Awaiting assignment <span class="badge @(Model.AwaitingAssignment > 0 ? "badge-warning" : "")">@Model.AwaitingAssignment</span></a>
                }
                else { <a class="button button-secondary portal-button" asp-page="/Portal/Projects">My projects</a> }
            </div>
        }
    }
    <p class="muted portal-tech-link">IT technician? <a asp-page="/Login">Login as Technician →</a></p>
</div>
