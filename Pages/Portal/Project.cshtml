@page "{number:int}"
@using EduHelpdesk.Models
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Portal.ProjectModel
@{
    var project = Model.Project!;
    ViewData["Title"] = project.Reference;
}
<div class="portal-shell">
    <div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>@project.Reference</h1><p class="hero-copy">@project.Title</p></div><a class="button button-secondary" asp-page="/Portal/Projects">← @(Model.IsLead ? "Projects" : "My projects")</a></div>
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }
    @if (Model.IsLead && project.IsActive)
    {
        var assigned = project.TechnicianId is not null;
        @* Once a technician has it, the form folds away behind Edit so the page reads as the project again, not a
           half-finished assignment. Unassigned projects still open straight onto the form - that is the job to do. *@
        <section class="panel portal-panel">
            <div class="assignment-heading">
                <div>
                    <h2>@(assigned ? "Assignment" : "Assign this project")</h2>
                    @if (assigned) { <p class="muted">@(Model.TechnicianName ?? "Unknown technician") · @ProjectPriorities.Label(project.EffectivePriority)</p> }
                </div>
                @if (assigned) { <button class="button button-secondary" type="button" id="assignment-edit" onclick="toggleAssignment(true)">Edit assignment</button> }
            </div>
            <form method="post" asp-page-handler="Assign" asp-route-number="@project.Number" class="settings-form" id="assignment-form" hidden="@assigned">
                <label>Priority
                    <select name="priority">@foreach (var level in ProjectPriorities.All) { <option value="@level" selected="@(level == project.EffectivePriority)">@ProjectPriorities.Label(level) — @ProjectPriorities.Describe(level)</option> }</select>
                    <small class="muted">@(project.Priority is null ? $"{Model.RequesterName ?? "The requester"} suggested {ProjectPriorities.Label(project.SuggestedPriority)}." : $"Confirmed as {ProjectPriorities.Label(project.Priority.Value)}.")</small>
                </label>
                <partial name="_WorkloadPicker" model="@(new WorkloadPicker(Model.Workloads, project.TechnicianId))" />
                <div class="heading-actions assignment-actions">
                    <button class="button button-primary portal-button" type="submit">Save</button>
                    @if (assigned) { <button class="button button-secondary" type="button" onclick="toggleAssignment(false)">Cancel</button> }
                </div>
            </form>
        </section>
        <script>
            function toggleAssignment(editing) {
                document.getElementById("assignment-form").hidden = !editing;
                document.getElementById("assignment-edit").hidden = editing;
            }
        </script>
    }
    <section class="panel portal-panel">
        <div class="detail-block"><p class="eyebrow">STATUS</p><strong class="field-value">@project.Status@(project.Outcome is { } outcome ? $" · {outcome}" : "")</strong>@if (!string.IsNullOrWhiteSpace(project.OutcomeNote)) { <p class="job-description">@project.OutcomeNote</p> }</div>
        @if (!Model.IsOwnProject) { <div class="detail-block"><p class="eyebrow">REQUESTED BY</p><p>@(Model.RequesterName ?? "Unknown")</p></div> }
        <div class="detail-block"><p class="eyebrow">WHO HAS IT</p><p>@(Model.TechnicianName ?? "Waiting to be assigned to a technician")</p></div>
        <div class="detail-block"><p class="eyebrow">PROPOSAL NEEDED BY</p><p>@project.DueDate.ToString("dddd d MMMM yyyy")</p></div>
        <div class="detail-block"><p class="eyebrow">PRIORITY</p><p>@ProjectPriorities.Label(project.EffectivePriority)@(project.Priority is null ? (Model.IsOwnProject ? " (your suggestion - the project lead will confirm it)" : " (suggested, not confirmed yet)") : "")</p></div>
        <div class="detail-block"><p class="eyebrow">@(Model.IsOwnProject ? "WHAT YOU ASKED FOR" : "WHAT WAS ASKED FOR")</p><p class="job-description">@project.ItemsWanted</p></div>
        @if (project.Items.Count > 0)
        {
            @* The list as the technician tidied it up - what is being quoted for. Suppliers and quotes stay helpdesk-side. *@
            <div class="detail-block"><p class="eyebrow">ITEMS BEING QUOTED FOR</p>
                <ul class="plain-list portal-items">
                    @foreach (var item in project.Items)
                    {
                        <li><strong>@item.Quantity × @item.Name</strong>@if (item.SubItems.Count > 0) { <br /><span class="muted">with @string.Join(", ", item.SubItems.Select(x => $"{x.Quantity} × {x.Name}"))</span> }</li>
                    }
                </ul>
            </div>
        }
        <div class="detail-block"><p class="eyebrow">PURCHASING REQUIREMENTS</p><p>@HelpdeskStore.DescribeRequirements(project)</p></div>
        <div class="detail-block">
            <p class="eyebrow">UPDATES</p>
            @if (Model.Notes.Count == 0) { <p class="muted">No updates yet.</p> }
            <div class="comment-list">
                @foreach (var note in Model.Notes)
                {
                    <article class="comment"><p>@note.Text</p><small>@(note.By is { } by ? $"{by.Name} · " : "")@note.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small></article>
                }
            </div>
            <form method="post" asp-page-handler="Note" asp-route-number="@project.Number" class="comment-form">
                <label for="portal-project-note">Add a message</label>
                <textarea id="portal-project-note" asp-for="Note" rows="3" maxlength="@HelpdeskStore.MaxProjectTextLength" placeholder="e.g. we'd also like a spare charger, or the date has moved…" required></textarea>
                <button class="button button-primary" type="submit">Send</button>
            </form>
        </div>
    </section>
</div>
