@page
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Portal.PasswordModel
@{ ViewData["Title"] = "Change password"; }
<div class="portal-shell">
    <div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>@(Model.Forced ? "Choose your password" : "Change password")</h1></div>@if (!Model.Forced) { <a class="button button-secondary" asp-page="/Portal/Index">← Back</a> }</div>
    @if (Model.ViaHelpdesk)
    {
        <section class="panel portal-panel"><p>You're using the portal through your helpdesk sign-in, so there's no separate portal password to change. To change your helpdesk password, use Change password in the helpdesk's account menu.</p></section>
    }
    else
    {
        @if (Model.Forced) { <div class="notice">Your password was set by the IT team, so choose a new one that only you know before carrying on.</div> }
        <section class="panel portal-panel">
            <form method="post" class="settings-form">
                <div asp-validation-summary="All" class="validation-summary-errors"></div>
                <label>Current password<input name="CurrentPassword" type="password" maxlength="256" autocomplete="current-password" required autofocus /></label>
                <label>New password<input name="NewPassword" type="password" required minlength="@PasswordRules.MinimumLength" maxlength="@PasswordRules.MaximumLength" autocomplete="new-password" /><small class="muted">@PasswordRules.Hint</small></label>
                <label>Confirm new password<input name="ConfirmPassword" type="password" required minlength="@PasswordRules.MinimumLength" maxlength="@PasswordRules.MaximumLength" autocomplete="new-password" /></label>
                <button class="button button-primary portal-button" type="submit">@(Model.Forced ? "Save and continue" : "Change password")</button>
            </form>
            @if (Model.Forced)
            {
                <form method="post" asp-page="/Portal/Index" asp-page-handler="Switch"><button type="submit" class="link-button">Sign out instead</button></form>
            }
        </section>
    }
</div>
