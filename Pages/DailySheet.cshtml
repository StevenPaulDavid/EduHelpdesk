@page
@using EduHelpdesk.Services
@model DailySheetModel
@{
    Layout = "_ReportPrint";
    ViewData["ReportTitle"] = "Daily job sheet";
    ViewData["ReportSubtitle"] = Model.Subtitle;
}
<p class="note">@(Model.Count == 1 ? "1 open job" : $"{Model.Count} open jobs"), by room. Tick each one done and note anything the office should know; hand the sheet back at the end of the shift.</p>
@if (Model.Count == 0)
{
    <p>No open jobs right now.</p>
}
@foreach (var (room, tickets) in Model.Rooms)
{
    <section>
        <h2>@room</h2>
        <table>
            <thead><tr><th style="width:8mm">Done</th><th style="width:22mm">Job</th><th>What</th><th style="width:20mm">Priority</th><th style="width:28mm">Due</th><th style="width:30mm">Assigned</th><th style="width:45mm">Notes</th></tr></thead>
            <tbody>
                @foreach (var ticket in tickets)
                {
                    var due = TicketInsights.DueStateOf(ticket, Model.Now, 0);
                    <tr class="@(due == DueState.Overdue ? "flag" : "")">
                        <td>☐</td>
                        <td class="count">@Model.Ref(ticket)</td>
                        <td>@ticket.Title<br /><span class="sub">@ticket.Category · @ticket.Status</span></td>
                        <td>@ticket.Priority</td>
                        <td>@(ticket.DueDate?.ToLocalTime().ToString("ddd d MMM, HH:mm") ?? "-")@if (due == DueState.Overdue) { <br /><span class="pill pill-warn">Overdue</span> }</td>
                        <td>@(ticket.TechnicianId is { } who ? Model.Names.GetValueOrDefault(who, "") : ticket.TeamName ?? "Anyone")</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
