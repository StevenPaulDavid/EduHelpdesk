@page
@model PeopleModel
@{
    ViewData["Title"] = "People";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">EDUHELPDESK / DIRECTORY</p>
        <h1>People and technicians</h1>
        <p class="hero-copy">Maintain the people available when technicians log and assign jobs.</p>
    </div>
    <a class="button button-secondary" asp-page="/Index">← Back to workspace</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<div class="grid two people-grid">
    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">REQUESTERS</p><h2>Users</h2></div><span class="badge">@Model.Users.Count</span></div>
        <div class="people-list">
        @foreach (var user in Model.Users)
        {
            <div class="person-card"><form method="post" asp-page-handler="SaveUser">
                <input type="hidden" name="id" value="@user.Id" />
                <div class="person-card-heading"><div class="avatar">@user.Name[..1].ToUpperInvariant()</div><div><strong>@user.Name</strong><span>@user.Email</span></div></div>
                <label>Name<input name="name" value="@user.Name" required /></label>
                <label>Email<input name="email" type="email" value="@user.Email" required /></label>
                <div class="form-grid compact"><label>Department<input name="department" value="@user.Department" /></label><label>Location<input name="location" value="@user.Location" /></label></div>
                <button class="button button-secondary" type="submit">Save changes</button>
            </form>
            <div class="person-actions">
                <form method="post" asp-page-handler="DeleteUser" onsubmit="return confirm('Delete this user? This is only allowed when they have no linked tickets or assets.');"><input type="hidden" name="id" value="@user.Id" /><button class="button button-danger" type="submit">Delete</button></form>
            </div>
            </div>
        }
        @if (Model.Users.Count == 0) { <p class="empty">No users have been imported yet.</p> }
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">JOB OWNERS</p><h2>Technicians</h2></div><span class="badge">@Model.Technicians.Count</span></div>
        <div class="people-list">
        @foreach (var technician in Model.Technicians)
        {
            <div class="person-card"><form method="post" asp-page-handler="SaveTechnician">
                <input type="hidden" name="id" value="@technician.Id" />
                <div class="person-card-heading"><div class="avatar technician-avatar">@technician.Name[..1].ToUpperInvariant()</div><div><strong>@technician.Name</strong><span>@technician.Email</span></div></div>
                <label>Name<input name="name" value="@technician.Name" required /></label>
                <label>Email<input name="email" type="email" value="@technician.Email" required /></label>
                <label>Team<input name="team" value="@technician.Team" /></label>
                <button class="button button-secondary" type="submit">Save changes</button>
            </form>
            <div class="person-actions">
                <form method="post" asp-page-handler="DeleteTechnician" onsubmit="return confirm('Delete this technician? This is only allowed when they have no assigned tickets.');"><input type="hidden" name="id" value="@technician.Id" /><button class="button button-danger" type="submit">Delete</button></form>
            </div>
            </div>
        }
        @if (Model.Technicians.Count == 0) { <p class="empty">No technicians have been imported yet.</p> }
        </div>
    </section>
</div>
