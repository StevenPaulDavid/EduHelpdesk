@page
@model SettingsModel
@{ ViewData["Title"]="Settings"; }
<div class="page-heading"><div><p class="eyebrow">EDUHELPDESK / CONFIGURATION</p><h1>Settings</h1><p class="hero-copy">Manage the values used throughout the helpdesk.</p></div><a class="button button-secondary" asp-page="/Index">← Overview</a></div>
@if(!string.IsNullOrWhiteSpace(Model.Message)){<div class="notice">@Model.Message</div>}
<section class="panel"><h2>Branding</h2><form method="post" asp-page-handler="SaveBranding" class="settings-form"><label>Primary colour<input asp-for="Branding.PrimaryColor"/></label><label>Accent colour<input asp-for="Branding.AccentColor"/></label><label>Background colour<input asp-for="Branding.BackgroundColor"/></label><button class="button button-primary">Save branding</button></form></section>
<section class="panel"><div class="panel-heading"><h2>Directory and asset options</h2></div><div class="settings-links"><a class="button button-secondary" asp-page="/Settings/Teams">Teams</a><a class="button button-secondary" asp-page="/Settings/Departments">Departments</a><a class="button button-secondary" asp-page="/Settings/Locations">Locations</a><a class="button button-secondary" asp-page="/Settings/AssetOptions">Asset makes, types and models</a><a class="button button-secondary" asp-page="/Settings/AssetAttributes">Custom asset attributes</a></div></section>
<section class="panel"><div class="panel-heading"><h2>Ticket options</h2></div><div class="settings-links"><a class="button button-secondary" asp-page="/Settings/TicketOptions">Categories, statuses and priorities</a><a class="button button-secondary" asp-page="/Settings/TicketAttributes">Ticket custom attributes</a><a class="button button-secondary" asp-page="/Settings/Slas">SLAs</a></div></section>
<section class="panel"><h2>Imports</h2><form method="post" enctype="multipart/form-data" asp-page-handler="ImportUsers"><label>Users CSV<input asp-for="UserCsv"/></label><button class="button button-primary">Import users</button></form><form method="post" enctype="multipart/form-data" asp-page-handler="ImportTechnicians"><label>Technicians CSV<input asp-for="TechnicianCsv"/></label><button class="button button-primary">Import technicians</button></form></section>
