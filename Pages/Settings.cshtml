@page
@model SettingsModel
@{ ViewData["Title"]="Settings"; }
<div class="page-heading"><div><p class="eyebrow">EDUHELPDESK / CONFIGURATION</p><h1>Settings</h1><p class="hero-copy">Manage the values used throughout the helpdesk.</p></div><a class="button button-secondary" asp-page="/Index">← Overview</a></div>
@if(!string.IsNullOrWhiteSpace(Model.Message)){<div class="notice">@Model.Message</div>}
<section class="panel"><h2>Branding</h2><form method="post" asp-page-handler="SaveBranding" class="settings-form branding-form"><label>Brand name<input asp-for="Branding.BrandName" /></label><label>Dashboard eyebrow<input asp-for="Branding.DashboardEyebrow" /></label><label>Dashboard title<input asp-for="Branding.DashboardTitle" /></label><label>Dashboard description<textarea asp-for="Branding.DashboardDescription" rows="3"></textarea></label><div class="color-grid"><label>Primary colour<input asp-for="Branding.PrimaryColor" pattern="^#[0-9A-Fa-f]{6}$" /></label><label>Accent colour<input asp-for="Branding.AccentColor" pattern="^#[0-9A-Fa-f]{6}$" /></label><label>Background colour<input asp-for="Branding.BackgroundColor" pattern="^#[0-9A-Fa-f]{6}$" /></label></div><label class="toggle-label"><input asp-for="Branding.DarkMode" /> Enable dark mode</label><button class="button button-primary">Save branding</button></form></section>
<section class="panel"><div class="panel-heading"><h2>Directory and asset options</h2></div><div class="settings-links"><a class="button button-secondary" asp-page="/Settings/Teams">Teams</a><a class="button button-secondary" asp-page="/Settings/Departments">Departments</a><a class="button button-secondary" asp-page="/Settings/Locations">Locations</a><a class="button button-secondary" asp-page="/Settings/AssetTypes">Asset types</a><a class="button button-secondary" asp-page="/Settings/AssetMakes">Asset makes</a><a class="button button-secondary" asp-page="/Settings/AssetModels">Asset models</a><a class="button button-secondary" asp-page="/Settings/AssetStatuses">Asset statuses</a><a class="button button-secondary" asp-page="/Settings/AssetAttributes">Custom asset attributes</a></div></section>
<section class="panel"><div class="panel-heading"><h2>Asset review</h2></div><p class="muted">The overview lists assets whose warranty ends, or that are due for replacement, within this many days, along with any already past. Overdue loans are always listed.</p><form method="post" asp-page-handler="SaveAssetReview" class="import-row"><label>Review window (days)<input name="days" type="number" min="0" max="3650" step="1" value="@Model.AssetReviewDays" required /></label><button class="button button-primary">Save</button></form></section>
<section class="panel"><div class="panel-heading"><h2>Ticket queues</h2></div><p class="muted">The Overdue / due soon queue on the ticket list shows open tickets that are past their due date, or due within this many hours. Overdue tickets are always included.</p><form method="post" asp-page-handler="SaveTicketDueSoon" class="import-row"><label>Due soon window (hours)<input name="hours" type="number" min="0" max="720" step="1" value="@Model.TicketDueSoonHours" required /></label><button class="button button-primary">Save</button></form></section>
<section class="panel"><div class="panel-heading"><h2>Ticket options</h2></div><div class="settings-links"><a class="button button-secondary" asp-page="/Settings/Categories">Categories</a><a class="button button-secondary" asp-page="/Settings/Statuses">Statuses</a><a class="button button-secondary" asp-page="/Settings/Priorities">Priorities</a><a class="button button-secondary" asp-page="/Settings/TicketAttributes">Ticket custom attributes</a><a class="button button-secondary" asp-page="/Settings/Slas">SLAs</a><a class="button button-secondary" asp-page="/Settings/TicketTemplates">Ticket templates</a></div></section>
<section class="panel"><div class="panel-heading"><h2>System audit</h2></div><p class="muted">A filterable record of every change made in the helpdesk: tickets, assets, people, suppliers, parts, lists, SLAs, custom attributes and settings.</p><div class="settings-links"><a class="button button-secondary" asp-page="/Settings/Audit">Open the audit log</a></div></section>
<section class="panel"><div class="panel-heading"><h2>Closing requirements</h2></div><p class="muted">Tick a priority or category to require technicians to enter a closing message before a matching ticket can be marked closed. Everything else can still be closed with one click.</p><form method="post" asp-page-handler="SaveCloseRequirements" class="settings-form"><div class="checkbox-grid"><div><p class="eyebrow">Priorities requiring a message</p>@foreach (var priority in Model.Priorities) { <label class="toggle-label"><input type="checkbox" name="priorities" value="@priority" checked="@Model.RequireCloseMessagePriorities.Contains(priority, StringComparer.OrdinalIgnoreCase)" /> @priority</label> }@if (Model.Priorities.Count == 0) { <p class="empty">No priorities configured yet.</p> }</div><div><p class="eyebrow">Categories requiring a message</p>@foreach (var category in Model.Categories) { <label class="toggle-label"><input type="checkbox" name="categories" value="@category" checked="@Model.RequireCloseMessageCategories.Contains(category, StringComparer.OrdinalIgnoreCase)" /> @category</label> }@if (Model.Categories.Count == 0) { <p class="empty">No categories configured yet.</p> }</div></div><button class="button button-primary" type="submit">Save closing requirements</button></form></section>
<section class="panel"><div class="panel-heading"><h2>Ticket print template</h2>@if(Model.HasPrintTemplate){<span class="badge">Template uploaded</span>}</div><p class="muted">Upload a Word (.docx) document to control how tickets look when printed. Use placeholders such as <code>{{Job.Number}}</code>, <code>{{Job.Title}}</code>, <code>{{Job.Status}}</code>, <code>{{Job.Comments}}</code> (comments only, never internal notes), <code>{{Requester.Name}}</code>, <code>{{Technician.Name}}</code> and <code>{{Asset.Tag}}</code> in the document — they'll be replaced with each ticket's actual details when printed.</p><form method="post" enctype="multipart/form-data" asp-page-handler="UploadPrintTemplate" class="import-row"><label>Template file (.docx)<input asp-for="PrintTemplate" accept=".docx"/></label><button class="button button-primary">Upload template</button></form></section>
<section class="panel"><h2>Imports</h2>
<p class="muted">Assets are imported on their own page, with column matching and a preview: <a asp-page="/Assets/Import">Import assets from a CSV file</a>.</p>
<p class="muted">Users CSV columns, in order, with a header row: <code>Name, Email, Department, Location</code></p>
<form method="post" enctype="multipart/form-data" asp-page-handler="ImportUsers" class="import-row"><label>Users CSV<input asp-for="UserCsv"/></label><button class="button button-primary">Import users</button><a class="button button-secondary" asp-page="/Settings" asp-page-handler="UserImportTemplate">Download template</a></form>
<p class="muted">Technicians CSV columns, in order, with a header row: <code>Name, Email, Team, Role</code>. Role is optional and defaults to Technician; it must match the name of an existing role (see the Roles panel on the People page). Imported accounts have no password until someone sets one from the People page.</p>
<form method="post" enctype="multipart/form-data" asp-page-handler="ImportTechnicians" class="import-row"><label>Technicians CSV<input asp-for="TechnicianCsv"/></label><button class="button button-primary">Import technicians</button><a class="button button-secondary" asp-page="/Settings" asp-page-handler="TechnicianImportTemplate">Download template</a></form>
<p class="muted">List CSVs have one column, <code>Name</code>, with a header row and one value per row. Asset models also take an optional second column, <code>Make</code>, to link each model to its make; a make that doesn't exist yet is created, and a model that already exists without a make is linked to it. Blank rows and values that already exist are skipped. Each template includes example rows, so replace them with your own before importing.</p>
@foreach (var list in SettingsModel.ImportLists)
{
<form method="post" enctype="multipart/form-data" asp-page-handler="ImportOptions" class="import-row"><input type="hidden" name="kind" value="@list.Kind" /><label>@list.Label CSV<input type="file" name="optionCsv" accept=".csv" required /></label><button class="button button-primary">Import @list.Label.ToLowerInvariant()</button><a class="button button-secondary" asp-page="/Settings" asp-page-handler="OptionImportTemplate" asp-route-kind="@list.Kind">Download template</a></form>
}
</section>
<section class="panel danger-zone"><div class="panel-heading"><h2>Reset to factory settings</h2></div>
<p>This erases <strong>everything</strong> and puts the helpdesk back to how a new install starts: all tickets, comments and history, assets and loans, users, technicians, suppliers and parts, SLAs, custom attributes, every list you added to (teams, departments, locations, asset types, makes, models, statuses, categories and priorities), the print template, attached files, and your branding and review settings. Only the small demo set that a new install comes with is left. <strong>This cannot be undone</strong> unless you keep the backup below.</p>
<form method="post" asp-page-handler="ResetFactory" class="settings-form" onsubmit="return confirm('Erase all helpdesk data and reset to factory settings? This cannot be undone.');">
    <label class="toggle-label"><input type="checkbox" name="keepBackup" value="true" checked /> Save a backup copy of the current data first</label>
    <p class="muted import-hint">Saved in <code>@Model.BackupFolder</code>. To restore it later, stop the app, copy the backup over <code>App_Data\helpdesk.db</code>, and copy the <code>attachments-before-reset</code> folder back as <code>App_Data\attachments</code>. Untick this to leave no copy of the old data behind.</p>
    <label class="toggle-label"><input type="checkbox" name="eraseAudit" value="true" /> Also erase the audit log</label>
    <p class="muted import-hint">Off by default: the audit log is kept, and the reset is recorded in it.</p>
    <label>Type <strong>DELETE</strong> to confirm<input name="confirmation" autocomplete="off" required /></label>
    <button class="button button-danger" type="submit">Erase everything and reset</button>
</form></section>
