@page
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / SETTINGS</p><h1>System settings</h1><p class="hero-copy">Brand the dashboard and import existing school directory records.</p></div>
    <a class="button button-secondary" asp-page="/Index">← Back to workspace</a>
</div>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">BRANDING</p><h2>Dashboard appearance</h2></div></div>
    <form method="post" asp-page-handler="SaveBranding" class="settings-form branding-form">
        <label>Brand name<input asp-for="Branding.BrandName" /></label>
        <label>Dashboard eyebrow<input asp-for="Branding.DashboardEyebrow" /></label>
        <label>Dashboard title<input asp-for="Branding.DashboardTitle" /></label>
        <label>Dashboard description<textarea asp-for="Branding.DashboardDescription" rows="3"></textarea></label>
        <div class="color-grid"><label>Primary colour<input asp-for="Branding.PrimaryColor" type="text" pattern="^#[0-9A-Fa-f]{6}$" placeholder="#067A78" /></label><label>Accent colour<input asp-for="Branding.AccentColor" type="text" pattern="^#[0-9A-Fa-f]{6}$" placeholder="#E8F0EF" /></label><label>Background colour<input asp-for="Branding.BackgroundColor" type="text" pattern="^#[0-9A-Fa-f]{6}$" placeholder="#F5F8F8" /></label></div>
        <label class="toggle-label"><input asp-for="Branding.DarkMode" type="checkbox" /> Enable dark mode</label>
        <button class="button button-primary" type="submit">Save branding</button>
    </form>
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">PRINTING</p><h2>Word print template</h2></div><span class="badge">@(Model.HasPrintTemplate ? "Uploaded" : "Built-in")</span></div>
    <p class="muted">Upload a .docx template to replace the built-in print layout. Add placeholders as plain text in Word; the matching values are filled in when a job is printed.</p>
    <form method="post" enctype="multipart/form-data" asp-page-handler="UploadPrintTemplate" class="settings-form"><label>Word document<input type="file" asp-for="PrintTemplate" accept=".docx" required /></label><code>{{Job.Number}} · {{Job.Title}} · {{Job.Description}} · {{Job.Status}} · {{Job.Priority}} · {{Job.Category}} · {{Requester.Name}} · {{Technician.Name}} · {{Asset.Tag}}</code><button class="button button-primary" type="submit">Upload print template</button></form>
</section>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<div class="grid two">
    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">REQUESTERS</p><h2>Import users</h2></div></div>
        <p class="muted">Each valid row creates a new requester record.</p>
        <form method="post" enctype="multipart/form-data" asp-page-handler="ImportUsers" class="settings-form"><label>Users CSV<input type="file" asp-for="UserCsv" accept=".csv" required /></label><code>name,email,department,location</code><button class="button button-primary" type="submit">Import users</button></form>
    </section>
    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">JOB OWNERS</p><h2>Import technicians</h2></div></div>
        <p class="muted">Each valid row creates a technician available for assignment.</p>
        <form method="post" enctype="multipart/form-data" asp-page-handler="ImportTechnicians" class="settings-form"><label>Technicians CSV<input type="file" asp-for="TechnicianCsv" accept=".csv" required /></label><code>name,email,team</code><button class="button button-primary" type="submit">Import technicians</button></form>
    </section>
</div>
