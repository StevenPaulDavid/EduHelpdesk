@page
@model SettingsModel
@{ ViewData["Title"] = "Settings"; }
<div class="page-heading"><div><p class="eyebrow">EDUHELPDESK / CONFIGURATION</p><h1>Settings</h1><p class="hero-copy">Everything the helpdesk can be set up to do, grouped by what it's about.</p></div><a class="button button-secondary" asp-page="/Index">← Overview</a></div>

@if (!Model.CanEdit)
{
    <div class="notice">Your role can see what's here, but not change it. Ask an administrator if something needs setting up differently.</div>
}
@* Anything that is putting the school's data at risk comes first, not buried in its group. *@
@if (Model.CanEdit && Model.Backups.NeedsAttention(DateTime.UtcNow))
{
    <div class="notice notice-warning"><strong>Backups need attention.</strong> @(Model.Backups.LastError.Length > 0 ? $"The last attempt failed: {Model.Backups.LastError}" : Model.Backups.Enabled ? "The last successful backup is more than a day old." : "Automatic backups are switched off.") <a asp-page="/Settings/Backups">Backups &amp; data</a></div>
}
@if (Model.CanEdit && Model.DataSyncedBy is { } synced)
{
    <div class="notice notice-warning"><strong>The data folder is inside @synced,</strong> which can corrupt a live database. <a asp-page="/Settings/Backups">See Backups &amp; data</a> for how to move it.</div>
}
@if (!Model.IsHttps)
{
    <div class="notice notice-warning"><strong>Not encrypted.</strong> This page came over plain http://, so from any other computer, passwords and tickets cross the network unencrypted. To fix it, run <code>Enable-Https.cmd</code> from the folder the helpdesk was installed from: it asks whether to make a self-signed certificate or use one you already have, then switches the helpdesk over.</div>
}

<div class="settings-find">
    <label for="settings-find">Find a setting</label>
    <input id="settings-find" type="search" placeholder="e.g. logo, reorder, SLA, dark" autocomplete="off" />
    <p class="muted" id="settings-find-none" hidden>Nothing matches that. Try a different word.</p>
</div>

@foreach (var group in Model.Groups)
{
    <section class="settings-group">
        <h2 class="section-heading">@group.Title</h2>
        <div class="settings-cards">
            @foreach (var card in group.Cards)
            {
                var badgeClass = card.Warn ? "badge badge-warning" : card.Good ? "badge badge-good" : "badge";
                if (card.Info)
                {
                    <div class="settings-card settings-card-info" data-keywords="@card.Keywords">
                        <span class="settings-card-title"><strong>@card.Title</strong>@if (card.Badge is not null) { <span class="@badgeClass">@card.Badge</span> }</span>
                        <small>@card.Description</small>
                    </div>
                }
                else if (card.Open)
                {
                    <a class="settings-card" asp-page="@card.Page" asp-all-route-data="@(card.Route ?? new Dictionary<string, string>())" data-keywords="@card.Keywords">
                        <span class="settings-card-title"><strong>@card.Title</strong>@if (card.Badge is not null) { <span class="@badgeClass">@card.Badge</span> }</span>
                        <small>@card.Description</small>
                    </a>
                }
                else
                {
                    <div class="settings-card is-locked" data-keywords="@card.Keywords">
                        <span class="settings-card-title"><strong>@card.Title</strong>@if (card.Badge is not null) { <span class="@badgeClass">@card.Badge</span> }</span>
                        <small>@card.Description</small>
                    </div>
                }
            }
        </div>
    </section>
}

@section Scripts {
<script src="~/js/settings-find.js" asp-append-version="true"></script>
}
