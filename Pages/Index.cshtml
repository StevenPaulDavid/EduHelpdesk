@page
@model IndexModel
@{
    ViewData["Title"] = "Technician workspace";
}

<div class="hero">
    <div>
        <p class="eyebrow">EDUHELPDESK / TECHNICIAN WORKSPACE</p>
        <h1>Keep every school device moving.</h1>
        <p class="hero-copy">Log jobs, link them to assets, and keep a complete repair history without exposing a staff-facing portal.</p>
    </div>
    <button class="button button-primary" type="button" onclick="openBlade('new-job')">＋ Log a job</button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<div class="metrics">
    <div class="metric"><span>Open jobs</span><strong>@Model.OpenTickets</strong><small>Needs technician action</small></div>
    <div class="metric"><span>Assets tracked</span><strong>@Model.Assets.Count</strong><small>With searchable history</small></div>
    <div class="metric"><span>Users imported</span><strong>@Model.Users.Count</strong><small>Requesters available</small></div>
    <div class="metric"><span>Technicians</span><strong>@Model.Technicians.Count</strong><small>Can log and own jobs</small></div>
</div>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>Jobs</h2></div><div class="heading-actions"><span class="badge">@Model.Tickets.Count total</span><button class="button button-primary" type="button" onclick="openBlade('new-job')">＋ Log a job</button></div></div>
    <div class="table-wrap"><table><thead><tr><th>Job</th><th>Requester</th><th>Asset</th><th>Technician</th><th>Priority</th><th>Status</th><th>Created</th></tr></thead><tbody>
    @foreach (var ticket in Model.Tickets) {
        var user = Model.Users.FirstOrDefault(x => x.Id == ticket.RequesterId);
        var tech = Model.Technicians.FirstOrDefault(x => x.Id == ticket.TechnicianId);
        var asset = Model.Assets.FirstOrDefault(x => x.Id == ticket.AssetId);
        <tr><td><strong>#@ticket.Number</strong><br /><span class="muted">@ticket.Title</span></td><td>@user?.Name</td><td>@(asset is null ? "—" : $"{asset.AssetTag} · {asset.Model}")</td><td>@tech?.Name</td><td><span class="priority @ticket.Priority.ToLowerInvariant()">@ticket.Priority</span></td><td><span class="status">@ticket.Status</span></td><td>@ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td></tr>
    }
    @if (Model.Tickets.Count == 0) { <tr><td colspan="7" class="empty">No jobs have been logged yet.</td></tr> }
    </tbody></table></div>
</section>

<div class="blade-backdrop" id="new-job"><aside class="blade"><button class="blade-close" type="button" onclick="closeBlades()">×</button><p class="eyebrow">NEW WORK ITEM</p><h2>Log a technician job</h2>
        <form method="post" asp-page-handler="CreateTicket" class="blade-form">
            <label>Requester <select asp-for="Ticket.RequesterId" required><option value="">Select a user…</option>@foreach (var user in Model.Users) { <option value="@user.Id">@user.Name · @user.Department</option> }</select><span asp-validation-for="Ticket.RequesterId" class="field-error"></span></label>
            <label>Assigned technician <select asp-for="Ticket.TechnicianId" required><option value="">Select technician…</option>@foreach (var tech in Model.Technicians) { <option value="@tech.Id">@tech.Name · @tech.Team</option> }</select><span asp-validation-for="Ticket.TechnicianId" class="field-error"></span></label>
            <label>Job title <input asp-for="Ticket.Title" placeholder="e.g. Projector has no signal" required /></label>
            <label>Asset <select asp-for="Ticket.AssetId"><option value="">No asset / general request</option>@foreach (var asset in Model.Assets) { <option value="@asset.Id">@asset.AssetTag · @asset.Type @asset.Model</option> }</select></label>
            <label>Priority <select asp-for="Ticket.Priority"><option>Normal</option><option>Low</option><option>High</option><option>Urgent</option></select></label>
            <label>Category <select asp-for="Ticket.Category"><option>Hardware</option><option>Software</option><option>Account</option><option>Network</option><option>Classroom AV</option><option>Other</option></select></label>
            <label>Description <textarea asp-for="Ticket.Description" rows="4" placeholder="Symptoms, checks already completed, and next action…" required></textarea></label>
            <div asp-validation-summary="All" class="field-error"></div>
            <button class="button button-primary" type="submit">Create job</button>
        </form>
</aside></div>

@section Scripts {
<script>
function openBlade(id){ closeBlades(); document.getElementById(id).classList.add("open"); }
function closeBlades(){ document.querySelectorAll(".blade-backdrop.open").forEach(x => x.classList.remove("open")); }
document.addEventListener("click", e => { if (e.target.classList.contains("blade-backdrop")) closeBlades(); });
</script>
}
