@page
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Reports.TicketsPrintModel
@{
    Layout = "_ReportPrint";
    ViewData["ReportTitle"] = "Ticket report";
    ViewData["ReportSubtitle"] = $"{Model.PeriodLabel} · {Model.TypeLabel}";

    // One table of on-time figures for a grouping of tickets - the print twin of the helper in Tickets.cshtml.
    async Task SlaTable(string heading, string firstColumn, IReadOnlyList<TicketReports.SlaRow> rows)
    {
        <h3>@heading</h3>
        <table>
            <thead><tr><th>@firstColumn</th><th class="num">Tickets</th><th class="num">On time</th><th class="num">Late</th><th class="num">Open and overdue</th><th class="num">No due date</th><th class="num">On-time rate</th><th class="num">Average resolution</th></tr></thead>
            <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td>@row.Name</td><td class="num">@row.Tickets</td><td class="num">@row.OnTime</td><td class="num">@row.Late</td>
                    <td class="num">@row.OpenOverdue</td><td class="num">@row.NoDueDate</td>
                    <td class="num">@(row.OnTimeRate is { } rate ? TicketReportsModel.Percent(rate) : "—")</td>
                    <td class="num">@TicketReports.Duration(row.AverageResolutionHours)</td>
                </tr>
            }
            @if (rows.Count == 0) { <tr><td colspan="8" class="empty">No tickets in this period.</td></tr> }
            </tbody>
        </table>
    }
}

<div class="note">
    <strong>@Model.TicketsInPeriod</strong> ticket@(Model.TicketsInPeriod == 1 ? "" : "s") raised @Model.WhenText, with an on-time rate of
    <strong>@TicketReportsModel.Percent(Model.Overall.OnTimeRate)</strong>@(Model.Overall.Judged == 0 ? " (no deadlines judged yet)" : $" across {Model.Overall.Judged} judged against a due date").
    <strong>@Model.OpenNow</strong> @(Model.OpenNow == 1 ? "is" : "are") open right now, of which <strong>@Model.OverdueNow</strong> @(Model.OverdueNow == 1 ? "is" : "are") overdue.
</div>

<section>
    <h2>Meeting deadlines</h2>
    @{ await SlaTable("Overall", "All tickets", [Model.Overall]); }
    @{ await SlaTable("By type", "Type", Model.ByType); }
    @{ await SlaTable("By priority", "Priority", Model.ByPriority); }
    @{ await SlaTable("By category", "Category", Model.ByCategory); }
    @{ await SlaTable("By technician", "Technician", Model.ByTechnician); }
</section>

<section>
    <h2>Open and overdue now (@Model.OverdueOpen.Count)</h2>
    <table>
        <thead><tr><th>Ticket</th><th>Title</th><th>Priority</th><th>Status</th><th>Due</th></tr></thead>
        <tbody>
        @foreach (var ticket in Model.OverdueOpen)
        {
            <tr class="flag"><td class="count">#@ticket.Number</td><td>@ticket.Title</td><td>@ticket.Priority</td><td>@ticket.Status</td><td>@ticket.DueDate?.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td></tr>
        }
        @if (Model.OverdueOpen.Count == 0) { <tr><td colspan="5" class="empty">Nothing is open and overdue.</td></tr> }
        </tbody>
    </table>
</section>

<section>
    <h2>Workload by technician</h2>
    <table>
        <thead><tr><th>Technician</th><th>Team</th><th class="num">Open</th><th class="num">Incidents</th><th class="num">Requests</th><th class="num">Overdue</th><th class="num">Closed @Model.WhenText</th><th class="num">Average resolution</th></tr></thead>
        <tbody>
        @foreach (var row in Model.Workload)
        {
            <tr><td>@row.Name</td><td>@row.Team</td><td class="num">@row.Open</td><td class="num">@row.OpenIncidents</td><td class="num">@row.OpenRequests</td><td class="num">@row.Overdue</td><td class="num">@row.ClosedInPeriod</td><td class="num">@TicketReports.Duration(row.AverageResolutionHours)</td></tr>
        }
        @if (Model.Workload.Count == 0) { <tr><td colspan="8" class="empty">No technicians to report on.</td></tr> }
        </tbody>
    </table>

    <h3>By team</h3>
    <table>
        <thead><tr><th>Team</th><th class="num">Technicians</th><th class="num">Open</th><th class="num">Overdue</th><th class="num">Closed @Model.WhenText</th></tr></thead>
        <tbody>
        @foreach (var row in Model.Teams)
        {
            <tr><td>@row.Team</td><td class="num">@row.Technicians</td><td class="num">@row.Open</td><td class="num">@row.Overdue</td><td class="num">@row.ClosedInPeriod</td></tr>
        }
        @if (Model.Teams.Count == 0) { <tr><td colspan="5" class="empty">No teams to report on.</td></tr> }
        </tbody>
    </table>
</section>

<section>
    <h2>What keeps coming back</h2>
    <h3>Assets with the most tickets</h3>
    <table>
        <thead><tr><th>Asset</th><th>Type</th><th class="num">Tickets</th><th class="num">Incidents</th><th class="num">Open</th><th>Most recent</th></tr></thead>
        <tbody>
        @foreach (var row in Model.Assets)
        {
            <tr><td class="count">@row.Asset.AssetTag</td><td>@row.Asset.Type</td><td class="num">@row.Tickets</td><td class="num">@row.Incidents</td><td class="num">@row.Open</td><td>@row.LastTicket.ToLocalTime().ToString("dd MMM yyyy")</td></tr>
        }
        @if (Model.Assets.Count == 0) { <tr><td colspan="6" class="empty">No tickets are linked to assets in this period.</td></tr> }
        </tbody>
    </table>

    <h3>Repeat faults — the same asset and category</h3>
    <table>
        <thead><tr><th>Asset</th><th>Category</th><th class="num">Tickets</th><th>First</th><th>Last</th></tr></thead>
        <tbody>
        @foreach (var row in Model.RepeatFaults)
        {
            <tr><td class="count">@row.Asset.AssetTag</td><td>@row.Category</td><td class="num">@row.Tickets</td><td>@row.First.ToLocalTime().ToString("dd MMM yyyy")</td><td>@row.Last.ToLocalTime().ToString("dd MMM yyyy")</td></tr>
        }
        @if (Model.RepeatFaults.Count == 0) { <tr><td colspan="5" class="empty">No repeat faults in this period.</td></tr> }
        </tbody>
    </table>

    <h3>Requesters with the most tickets</h3>
    <table>
        <thead><tr><th>Person</th><th>Department</th><th class="num">Tickets</th><th class="num">Open</th><th>Most recent</th></tr></thead>
        <tbody>
        @foreach (var row in Model.Requesters)
        {
            <tr><td>@row.User.Name</td><td>@row.User.Department</td><td class="num">@row.Tickets</td><td class="num">@row.Open</td><td>@row.LastTicket.ToLocalTime().ToString("dd MMM yyyy")</td></tr>
        }
        @if (Model.Requesters.Count == 0) { <tr><td colspan="5" class="empty">No tickets in this period.</td></tr> }
        </tbody>
    </table>
</section>

<section>
    <h2>Category mix</h2>
    <table>
        <thead><tr><th>Category</th><th class="num">Tickets</th><th class="num">Share</th>@if (Model.HasPreviousPeriod) { <th class="num">Previous period</th><th class="num">Change</th> }</tr></thead>
        <tbody>
        @foreach (var row in Model.Categories)
        {
            <tr>
                <td>@row.Category</td><td class="num">@row.Tickets</td><td class="num">@row.SharePercent.ToString("0")%</td>
                @if (Model.HasPreviousPeriod)
                {
                    var change = row.Tickets - row.Previous;
                    <td class="num">@row.Previous</td>
                    <td class="num">@(change > 0 ? "+" : "")@change</td>
                }
            </tr>
        }
        @if (Model.Categories.Count == 0) { <tr><td colspan="@(Model.HasPreviousPeriod ? 5 : 3)" class="empty">No tickets in this period.</td></tr> }
        </tbody>
    </table>
</section>
