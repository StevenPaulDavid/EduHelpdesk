@page
@model EduHelpdesk.Pages.Parts.EditModel
@{ViewData["Title"]=Model.Part.Id==Guid.Empty?"Add part":"Edit part";}<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/Parts">← Back</a></div><section class="panel"><form method="post" class="settings-form"><input type="hidden" asp-for="Part.Id"/><input type="hidden" asp-for="Part.CreatedAt"/><div asp-validation-summary="All" class="validation-summary-errors"></div><p class="muted required-legend">Only <strong>Name</strong> is required — every other field is optional.</p><label>Name <span class="required-marker">*</span><input asp-for="Part.Name" required /></label><label>SKU / part number<input asp-for="Part.Sku"/></label><label>Category<select asp-for="Part.Category"><option value="">Uncategorized</option>@foreach (var x in Model.Categories) { <option value="@x">@x</option> }</select></label><label>Location / bin<select asp-for="Part.Location"><option value="">Unassigned</option>@foreach (var x in Model.Locations) { <option value="@x">@x</option> }</select></label><label>Quantity on hand<input asp-for="Part.QuantityOnHand" type="number" min="0" step="1"/></label><label>Reorder threshold<input asp-for="Part.ReorderThreshold" type="number" min="0" step="1" placeholder="Use default (@Model.DefaultReorderThreshold)"/></label>
<div><p class="eyebrow">Suppliers</p>@if (Model.Suppliers.Count == 0) { <p class="empty">No suppliers set up yet.</p> } else { <div class="checkbox-grid">@foreach (var supplier in Model.Suppliers) { <label class="toggle-label"><input type="checkbox" name="SupplierIds" value="@supplier.Id" checked="@Model.SupplierIds.Contains(supplier.Id)" /> @supplier.Name</label> }</div> }</div>
<button class="button button-primary">Save part</button></form></section>
