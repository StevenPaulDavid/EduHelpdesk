@page
@model EduHelpdesk.Pages.Parts.EditModel
@{ViewData["Title"]=Model.Part.Id==Guid.Empty?"Add part":"Edit part";}<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/Parts">← Back</a></div><section class="panel"><form method="post" class="settings-form"><input type="hidden" asp-for="Part.Id"/><input type="hidden" asp-for="Part.CreatedAt"/><div asp-validation-summary="All" class="validation-summary-errors"></div><p class="muted required-legend">Only <strong>Name</strong> is required — every other field is optional.</p><label>Name <span class="required-marker">*</span><input asp-for="Part.Name" required /></label><label>SKU / part number<input asp-for="Part.Sku"/></label><label>Category<input asp-for="Part.Category" placeholder="e.g. Toner, Cable, Battery"/></label><label>Quantity on hand<input asp-for="Part.QuantityOnHand" type="number" min="0" step="1"/></label><button class="button button-primary">Save part</button></form></section>
