@page
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Parts.EditModel
@{
    var part = Model.Stored;
    ViewData["Title"] = part is null ? "Add part" : Model.Editing ? $"Edit {part.Name}" : part.Name;
    string Or(string? value, string blank) => string.IsNullOrWhiteSpace(value) ? blank : value;
}
<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / PARTS</p><h1>@(part?.Name ?? "Add part")</h1>@if (!string.IsNullOrWhiteSpace(part?.Sku)) { <p class="hero-copy">SKU @part.Sku</p> }</div>
    <a class="button button-secondary" asp-page="/Parts">← Back to parts</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<section class="panel">
    <div class="panel-heading">
        <div><p class="eyebrow">DETAILS</p><h2>@(Model.Adding ? "New part" : Model.Editing ? "Editing details" : "Part details")</h2></div>
        @if (part is not null && !Model.Editing) { <a class="button button-secondary" asp-page="/Parts/Edit" asp-route-id="@part.Id" asp-route-edit="true">Edit details</a> }
    </div>

    @if (part is not null && !Model.Editing)
    {
        <dl class="detail-list">
            <dt>SKU / part number</dt><dd>@Or(part.Sku, "—")</dd>
            <dt>Category</dt><dd>@Or(part.Category, "Uncategorized")</dd>
            <dt>Location / bin</dt><dd>@Or(part.Location, "Unassigned")</dd>
            <dt>Reorder threshold</dt><dd>@(part.ReorderThreshold is { } own ? own.ToString() : $"Default ({Model.DefaultReorderThreshold})")</dd>
            <dt>Suppliers</dt><dd>@(Model.SupplierNames.Count == 0 ? "None" : string.Join(", ", Model.SupplierNames))</dd>
            <dt>Compatible asset types</dt><dd>@(part.AssetTypes.Count == 0 ? "Not recorded" : string.Join(", ", part.AssetTypes))</dd>
            <dt>Added</dt><dd>@part.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>
        </dl>
    }
    else
    {
        <form method="post" class="settings-form">
            <input type="hidden" asp-for="Part.Id"/><input type="hidden" asp-for="Part.CreatedAt"/>
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
            <p class="muted required-legend">Only <strong>Name</strong> is required — every other field is optional.</p>
            <label>Name <span class="required-marker">*</span><input asp-for="Part.Name" required autofocus /></label>
            <label>SKU / part number<input asp-for="Part.Sku"/></label>
            <label>Category<select asp-for="Part.Category"><option value="">Uncategorized</option>@foreach (var x in Model.Categories) { <option value="@x">@x</option> }</select></label>
            <label>Location / bin<select asp-for="Part.Location"><option value="">Unassigned</option>@foreach (var x in Model.Locations) { <option value="@x">@x</option> }</select></label>
            @* Only asked for when adding. After that the count moves through the stock panel, so every change has a reason. *@
            @if (Model.Adding) { <label>Quantity on hand<input asp-for="Part.QuantityOnHand" type="number" min="0" step="1"/></label> }
            <label>Reorder threshold<input asp-for="Part.ReorderThreshold" type="number" min="0" step="1" placeholder="Use default (@Model.DefaultReorderThreshold)"/></label>
            <div><p class="eyebrow">Suppliers</p>@if (Model.Suppliers.Count == 0) { <p class="empty">No suppliers set up yet.</p> } else { <div class="checkbox-grid">@foreach (var supplier in Model.Suppliers) { <label class="toggle-label"><input type="checkbox" name="SupplierIds" value="@supplier.Id" checked="@Model.SupplierIds.Contains(supplier.Id)" /> @supplier.Name</label> }</div> }</div>
            <div><p class="eyebrow">Compatible asset types (optional)</p>@if (Model.AssetTypeOptions.Count == 0) { <p class="empty">No asset types configured yet.</p> } else { <div class="checkbox-grid">@foreach (var type in Model.AssetTypeOptions) { <label class="toggle-label"><input type="checkbox" name="AssetTypes" value="@type" checked="@Model.AssetTypes.Contains(type, StringComparer.OrdinalIgnoreCase)" /> @type</label> }</div> }</div>
            <div class="heading-actions form-actions">
                <button class="button button-primary">@(Model.Adding ? "Add part" : "Save part")</button>
                @if (part is not null) { <a class="button button-secondary" asp-page="/Parts/Edit" asp-route-id="@part.Id">Cancel</a> }
            </div>
        </form>
    }
</section>

@if (part is not null)
{
    <section class="panel">
        <div class="panel-heading">
            <div><p class="eyebrow">STOCK</p><h2>Stock</h2></div>
            <div class="heading-actions">
                @if (Model.IsLow) { <span class="badge badge-warning">At or below reorder level (@Model.ReorderAt)</span> }
                <span class="badge">@part.QuantityOnHand in stock</span>
            </div>
        </div>

        @* A delivery is added to what is already there - 2 on the shelf plus 3 delivered makes 5. *@
        <form method="post" asp-page-handler="Restock" class="import-row">
            <input type="hidden" name="id" value="@part.Id" />
            <label>Delivered<input name="delivered" id="restock-delivered" type="number" min="1" max="@HelpdeskStore.MaxPartDelivery" step="1" required /></label>
            <label>Note (optional)<input name="note" placeholder="e.g. PO 4411, from CPC" /></label>
            <button class="button button-primary">Add to stock</button>
        </form>
        <p class="muted restock-preview" id="restock-preview" data-current="@part.QuantityOnHand">Enter how many arrived and it is added to the @part.QuantityOnHand already in stock.</p>

        <details class="stock-correct">
            <summary>Count wrong? Set the exact quantity instead</summary>
            <p class="muted">For a stocktake, breakage or anything that has gone missing. This replaces the count rather than adding to it.</p>
            <form method="post" asp-page-handler="AdjustStock" class="import-row">
                <input type="hidden" name="id" value="@part.Id" />
                <label>Actual quantity<input name="newQuantity" type="number" min="0" step="1" value="@part.QuantityOnHand" required /></label>
                <label>Reason<input name="reason" placeholder="e.g. Stocktake correction, two damaged" required /></label>
                <button class="button button-secondary">Correct count</button>
            </form>
        </details>

        <div class="table-wrap"><table><thead><tr><th>When</th><th>Who</th><th>Change</th></tr></thead><tbody>
        @foreach (var entry in Model.StockHistory)
        {
            <tr><td>@entry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><td>@(entry.By?.Name ?? "—")</td><td>@entry.Details</td></tr>
        }
        @if (Model.StockHistory.Count == 0) { <tr><td colspan="3" class="empty">No stock changes recorded yet.</td></tr> }
        </tbody></table></div>
    </section>
}

@section Scripts {
<script src="~/js/pages/part-restock.js" asp-append-version="true"></script>
}
