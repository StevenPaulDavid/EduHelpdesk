@page
@model SuppliersModel
@{ ViewData["Title"]="Suppliers"; }<div class="page-heading"><div><p class="eyebrow">PROCUREMENT</p><h1>Suppliers</h1></div>@if (Model.CanEdit) { <a class="button button-primary" asp-page="/Suppliers/Edit">＋ Add supplier</a> }</div>
@if(!string.IsNullOrWhiteSpace(Model.Message)){<div class="notice">@Model.Message</div>}<section class="panel directory-panel"><div class="panel-heading"><h2>Supplier directory</h2><span class="badge">@Model.Suppliers.Count</span></div>
@foreach(var item in Model.Suppliers){<div class="directory-row"><div class="directory-person"><div class="avatar">S</div><div><strong>@if (Model.CanView) { <a asp-page="/Supplier" asp-route-id="@item.Id">@item.Name</a> } else { @item.Name }</strong><span>@item.ContactName · @item.Email · @item.Phone</span></div></div><div class="row-actions">@if (Model.CanEdit) { <a class="icon-button" asp-page="/Suppliers/Edit" asp-route-id="@item.Id">✎</a> }@if (Model.CanDelete) { <a class="icon-button delete-icon" asp-page="/Suppliers/Delete" asp-route-id="@item.Id">♜</a> }</div></div>}@if(Model.Suppliers.Count==0){<p class="empty">No suppliers have been added yet.</p>}</section>
