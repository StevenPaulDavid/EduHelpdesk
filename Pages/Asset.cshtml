@page
@using EduHelpdesk.Services
@model AssetModel
@{
    ViewData["Title"] = $"Edit {Model.Asset?.AssetTag}";
    var asset = Model.Asset!;
    var linkedTicketRecords = Model.Tickets.Where(x => x.AssetIds.Contains(asset.Id)).ToList();
    var unlinkedTickets = Model.Tickets.Where(x => !x.AssetIds.Contains(asset.Id)).ToList();
    var replacementHint = asset.ReplacementDate is not null
        ? "A typed date. Clear it to use the lifespan set for this asset type."
        : Model.ReplacementDue is { } calculated
            ? $"Blank, so it is due {AssetInsights.Format(calculated)} from this asset type's lifespan."
            : "Optional. Set a lifespan on the asset type in Settings, or type a date here.";
    var holderText = Model.HolderName is not null ? $"Held by {Model.HolderName}" : Model.HeldByKit is { } kitHeld ? $"Out with {kitHeld.Loan.BorrowerName}" : "Not assigned";
    var warrantyExpired = asset.WarrantyEnd is { } warrantyEnds && warrantyEnds < Model.Today;
    // A saved building or condition that has since left its Settings list is still offered, so saving keeps it.
    var buildingOptions = Model.Buildings.Concat(string.IsNullOrWhiteSpace(asset.Building) || Model.Buildings.Contains(asset.Building, StringComparer.OrdinalIgnoreCase) ? [] : new[] { asset.Building }).ToList();
    var conditionOptions = Model.Conditions.Concat(string.IsNullOrWhiteSpace(asset.Condition) || Model.Conditions.Contains(asset.Condition, StringComparer.OrdinalIgnoreCase) ? [] : new[] { asset.Condition }).ToList();
    var checkState = Model.CheckState;
    var supportState = Model.SupportState;
    var checkFlagged = checkState is AssetChecks.State.Overdue or AssetChecks.State.Soon;
    var supportFlagged = supportState is AssetChecks.State.Overdue or AssetChecks.State.Soon;
}

<a class="back-link" asp-page="/Assets">← Back to assets</a>
<div class="page-heading">
    <div>
        <p class="eyebrow">EDUHELPDESK / ASSET</p>
        <h1>@asset.AssetTag</h1>
        <p class="hero-copy asset-heading-meta">
            <span>@asset.Make @asset.Model · @asset.Type</span>
            <span class="status">@asset.Status</span>
            <span>@holderText</span>
            @if (asset.AssignedUserId is not null && asset.LoanDueDate is { } headingDue) { <span class="badge @(Model.LoanOverdue ? "badge-warning" : "")">On loan, due back @AssetInsights.Format(headingDue)</span> }
            @if (warrantyExpired) { <span class="badge badge-warning">Warranty expired</span> }
            @if (!Model.IsDisposed && checkFlagged) { <span class="badge @AssetChecks.Tone(checkState)">@AssetChecks.CheckLabel(checkState)</span> }
            @if (!Model.IsDisposed && supportFlagged) { <span class="badge @AssetChecks.Tone(supportState)">@AssetChecks.SupportLabel(asset, supportState)</span> }
        </p>
    </div>
    <div class="heading-actions">
        <partial name="_RawDataLink" model='("asset", asset.Id.ToString())' />
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

@* One page, in tabs, rather than four long sections one under another. Each form comes back to its own tab: asp-fragment
   puts the tab in the form's address, and the browser keeps it through the redirect after saving. *@
<div class="ticket-tab-buttons asset-tabs" role="tablist" aria-label="Asset">
    <button class="ticket-tab-button active" type="button" role="tab" aria-selected="true" aria-controls="asset-details">Details</button>
    <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="asset-purchase">Purchase &amp; warranty</button>
    <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="asset-checks">Checks &amp; support@(checkFlagged || supportFlagged ? " ⚠" : "")</button>
    <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="asset-loans">Ownership &amp; loans</button>
    <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="asset-tickets">Tickets <span class="badge">@linkedTicketRecords.Count</span></button>
    <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="asset-comments">Comments <span class="badge">@asset.Comments.Count</span></button>
    <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="asset-history">History <span class="badge">@asset.History.Count</span></button>
</div>

@* ---- Details: what it is, where it is and who has it. The purchase fields further down belong to this same form. ---- *@
<section id="asset-details" class="ticket-tab-panel active panel" role="tabpanel">
    <form method="post" asp-page-handler="Save" asp-fragment="asset-details" id="asset-form">
        <input type="hidden" name="id" value="@asset.Id" />
        <div class="form-grid asset-form-grid">
            <label>Asset tag<input name="assetTag" value="@asset.AssetTag" required /></label>
            <label>Status<select name="status">@foreach (var item in Model.Statuses) { <option value="@item" selected="@string.Equals(item, asset.Status, StringComparison.OrdinalIgnoreCase)">@item</option> }</select></label>
            <label>Make<select name="make" id="asset-make-select" data-model-filter="asset-model-select" data-keep-initial required><option value="">Select a make</option>@foreach (var make in Model.AssetMakes) { <option value="@make" selected="@(string.Equals(make, asset.Make, StringComparison.OrdinalIgnoreCase))">@make</option> }</select></label>
            <label>Model<select name="model" id="asset-model-select" required><option value="">Select a model</option>@foreach (var assetModel in Model.AssetModels) { <option value="@assetModel" data-make="@Model.AssetModelMakes.GetValueOrDefault(assetModel)" selected="@(string.Equals(assetModel, asset.Model, StringComparison.OrdinalIgnoreCase))">@assetModel</option> }</select></label>
            <label>Type<select name="type" required><option value="">Select a type</option>@foreach (var type in Model.AssetTypes) { <option value="@type" selected="@(string.Equals(type, asset.Type, StringComparison.OrdinalIgnoreCase))">@type</option> }</select></label>
            <label>Serial number<input name="serialNumber" value="@asset.SerialNumber" /></label>
            <label>Operating system<input name="operatingSystem" value="@asset.OperatingSystem" placeholder="For example Windows 11 Pro 24H2" /></label>
            @* DfE records where kit is as building and room. The room is the same Locations list tickets and people use. *@
            <label>Building<select name="building"><option value="">Not recorded</option>@foreach (var item in buildingOptions) { <option value="@item" selected="@(string.Equals(item, asset.Building, StringComparison.OrdinalIgnoreCase))">@item</option> }</select></label>
            <label>Room<select name="location"><option value="">Unassigned</option>@foreach (var location in Model.Locations) { <option value="@location" selected="@(string.Equals(location, asset.Location, StringComparison.OrdinalIgnoreCase))">@location</option> }</select></label>
            <label>Condition<select name="condition"><option value="">Not recorded</option>@foreach (var item in conditionOptions) { <option value="@item" selected="@(string.Equals(item, asset.Condition, StringComparison.OrdinalIgnoreCase))">@item</option> }</select></label>
            <label>Ownership<select name="ownership">@foreach (var item in AssetOwnership.All) { <option value="@item" selected="@(item == asset.Ownership)">@AssetOwnership.Label(item)</option> }</select></label>
            <label>Assigned user<select name="assignedUserId" data-picker><option value="">Unassigned</option>@foreach (var user in Model.Users) { <option value="@user.Id" data-search="@user.Email @user.Department" selected="@(user.Id == asset.AssignedUserId)">@user.Name</option> }</select></label>
            @if (asset.LoanDueDate is { } onLoanUntil)
            {
                <label>Loan due back<input type="date" value="@onLoanUntil.ToString("yyyy-MM-dd")" disabled /><small class="muted">Set when the device was loaned out. Book it back in under Ownership &amp; loans to clear it.</small></label>
            }
            @foreach (var customAttribute in Model.CustomAttributes)
            {
                var customValue = Model.CustomAttributeValues.TryGetValue(customAttribute.Id, out var value) ? value : string.Empty;
                if (customAttribute.FieldType == "dropdown")
                {
                    <label>@customAttribute.Name<select name="customAttributes[@customAttribute.Id]"><option value="">Select an option</option>@foreach (var choice in AssetModel.Choices(customAttribute)) { <option value="@choice" selected="@(string.Equals(choice, customValue, StringComparison.Ordinal))">@choice</option> }</select></label>
                }
                else if (customAttribute.FieldType == "checkbox")
                {
                    <label class="toggle-label">@customAttribute.Name<input type="checkbox" name="customAttributes[@customAttribute.Id]" value="true" checked="@(string.Equals(customValue, "true", StringComparison.OrdinalIgnoreCase))" /></label>
                }
                else if (customAttribute.FieldType == "multi-line")
                {
                    <label>@customAttribute.Name<textarea name="customAttributes[@customAttribute.Id]" rows="3">@customValue</textarea></label>
                }
                else
                {
                    <label>@customAttribute.Name<input name="customAttributes[@customAttribute.Id]" value="@customValue" /></label>
                }
            }
        </div>
        <div class="asset-form-actions"><button class="button button-primary" type="submit">Save asset</button></div>
    </form>
</section>

@* ---- Purchase & warranty: part of the Details form (form="asset-form"), so saving either tab saves both. ---- *@
<section id="asset-purchase" class="ticket-tab-panel panel" role="tabpanel" hidden>
    <div class="form-grid asset-form-grid">
        <label>Supplier<select name="supplierId" form="asset-form"><option value="">No supplier</option>@foreach (var supplier in Model.Suppliers) { <option value="@supplier.Id" selected="@(supplier.Id == asset.SupplierId)">@supplier.Name</option> }</select></label>
        <label>Purchase date<input name="purchaseDate" type="date" form="asset-form" value="@asset.PurchaseDate?.ToString("yyyy-MM-dd")" /></label>
        <label>Purchase price<input name="purchasePrice" type="number" min="0" step="0.01" form="asset-form" value="@asset.PurchasePrice?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" placeholder="0.00" /></label>
        <label>Purchase order<input name="purchaseOrder" form="asset-form" value="@asset.PurchaseOrder" /><small class="muted">The Trust's PO, if you were given one.</small></label>
        <label>Quote reference<input name="quoteReference" form="asset-form" value="@asset.QuoteReference" /><small class="muted">The supplier's quote number — often the only reference for an order placed via the Trust.</small></label>
        <label>Warranty end<input name="warrantyEnd" type="date" form="asset-form" value="@asset.WarrantyEnd?.ToString("yyyy-MM-dd")" />@if (warrantyExpired) { <small class="muted">Expired.</small> }</label>
        <label>Replacement date<input name="replacementDate" type="date" form="asset-form" value="@asset.ReplacementDate?.ToString("yyyy-MM-dd")" /><small class="muted">@replacementHint</small></label>
        @* DfE: a leased asset's details belong on the contracts register too. *@
        <label>Lease or loan contract<select name="contractId" form="asset-form" data-picker><option value="">None</option>@foreach (var contract in Model.Contracts) { <option value="@contract.Id" selected="@(contract.Id == asset.ContractId)">@contract.Name</option> }</select>
            <small class="muted">@if (asset.ContractId is { } linkedId && Model.CanOpenContracts) { <a asp-page="/Contract" asp-route-id="@linkedId">Open the contract</a> } else { <text>For leased or loaned kit: its contract on the contracts register.</text> }</small></label>
    </div>
    <div class="asset-form-actions"><button class="button button-primary" type="submit" form="asset-form" formaction="@(Url.Page("/Asset", "Save") + "#asset-purchase")">Save asset</button></div>
</section>

@* ---- Checks & support: the DfE register's check dates and end of support. Also part of the Details form. ---- *@
<section id="asset-checks" class="ticket-tab-panel panel" role="tabpanel" hidden>
    @if (!Model.IsDisposed)
    {
        <div class="panel-heading">
            <div>
                <h2>@AssetChecks.CheckLabel(checkState)</h2>
                <p class="muted">@(asset.LastCheckDate is { } lastChecked ? $"Last checked {AssetInsights.Format(lastChecked)}{(string.IsNullOrWhiteSpace(asset.LastCheckBy) ? "" : $" by {asset.LastCheckBy}")}." : "No check recorded yet.")
                    @(asset.NextCheckDate is { } nextDue ? $"Next check {AssetInsights.Format(nextDue)}." : "")</p>
            </div>
            <span class="badge @AssetChecks.Tone(supportState)">@AssetChecks.SupportLabel(asset, supportState)</span>
        </div>
        <form method="post" asp-page-handler="Check" asp-fragment="asset-checks" class="import-row">
            <input type="hidden" name="id" value="@asset.Id" />
            <label>Checked on<input name="checkDate" type="date" value="@Model.Today.ToString("yyyy-MM-dd")" max="@Model.Today.ToString("yyyy-MM-dd")" required /></label>
            <label>By<input name="checkBy" value="@Model.CurrentUserName" required /></label>
            <button class="button button-primary" type="submit">Record a check</button>
            <small class="muted">Sets the next check @Model.Checks.IntervalMonths month@(Model.Checks.IntervalMonths == 1 ? "" : "s") later (Settings › Inventory rules).</small>
        </form>
    }
    <h3 class="asset-subheading">On the register</h3>
    <div class="form-grid asset-form-grid">
        <label>Last check<input name="lastCheckDate" type="date" form="asset-form" value="@asset.LastCheckDate?.ToString("yyyy-MM-dd")" max="@Model.Today.ToString("yyyy-MM-dd")" /></label>
        <label>Checked by<input name="lastCheckBy" form="asset-form" value="@asset.LastCheckBy" /></label>
        <label>Next check<input name="nextCheckDate" type="date" form="asset-form" value="@asset.NextCheckDate?.ToString("yyyy-MM-dd")" /></label>
        <label>@(string.IsNullOrEmpty(asset.Ownership) ? "End of support" : "Lease or loan ends")<input name="endOfSupport" type="date" form="asset-form" value="@asset.EndOfSupport?.ToString("yyyy-MM-dd")" /><small class="muted">When it stops getting security updates (or goes back to its owner). Separate from the replacement date, which is for budgeting.</small></label>
    </div>
    <div class="asset-form-actions"><button class="button button-primary" type="submit" form="asset-form" formaction="@(Url.Page("/Asset", "Save") + "#asset-checks")">Save asset</button></div>
</section>

@* ---- Ownership & loans: who has it, lending it out and booking it back, disposal, and the record of holders. ---- *@
<section id="asset-loans" class="ticket-tab-panel panel" role="tabpanel" hidden>
    <div class="panel-heading">
        @* A kit issued to someone outside the directory leaves no holder on the asset, so "Not assigned" would be wrong. *@
        <div><h2>@holderText</h2></div>
        @if (asset.AssignedUserId is not null && asset.LoanDueDate is { } loanDue) { <span class="badge @(Model.LoanOverdue ? "badge-warning" : "")">On loan, due back @AssetInsights.Format(loanDue)@(Model.LoanOverdue ? " (overdue)" : "")</span> }
    </div>
    @if (Model.HeldByKit is { } held)
    {
        <div class="notice notice-warning">
            <strong>On loan with @held.Kit.Name.</strong>
            Out with @held.Loan.BorrowerName since @AssetInsights.Format(DateOnly.FromDateTime(held.Loan.IssuedAt.ToLocalTime())), due back @AssetInsights.Format(held.Loan.DueBack)@(held.Loan.IsOverdue(AssetInsights.Today) ? " (overdue)" : "").
            It went out as part of a kit, so it has to be booked back in as one - returning it here would leave the kit still showing the equipment.
            <a asp-page="/Loans">Book the kit back in on the Loans page</a>.
        </div>
    }
    else
    {
    <div class="ownership-actions">
        @if (Model.PartOfKit is { } owningKit)
        {
            @* Kit equipment is only lent as a kit, so there is no per-asset loan form at all - not just while it is out. *@
            <div class="notice">
                <strong>Part of @owningKit.Name.</strong>
                This device is loaned out by issuing that kit, so it has no loan of its own.
                <a asp-page="/Loans">Issue the kit from the Loans page</a>, or take it out of the kit first if it needs to be lent on its own.
            </div>
        }
        else if (asset.AssignedUserId is not null)
        {
            @* Someone already holds it, so it can be neither lent nor put in a kit until it comes back (HelpdeskStore.HeldBlock). *@
            @if (asset.LoanDueDate is null)
            {
                <p class="muted">Assigned to @(Model.HolderName ?? "someone"), so it can't be loaned out or put in a kit. Return it first if it needs to be lent.</p>
            }
        }
        else
        {
            <form method="post" asp-page-handler="Loan" asp-fragment="asset-loans" class="import-row">
                <input type="hidden" name="id" value="@asset.Id" />
                <label>Loan to<select name="userId" required data-picker><option value="">Select a user…</option>@foreach (var user in Model.Users) { <option value="@user.Id" data-search="@user.Email @user.Department">@user.Name</option> }</select></label>
                @* Required, from the same list kit loans use, so this loan can be told apart in the repeat-borrower report. *@
                <label>Reason<select name="reason" required><option value="">Choose a reason…</option>@foreach (var reason in Model.LoanReasons) { <option value="@reason">@reason</option> }</select></label>
                <label>Due back<input name="dueBack" type="date" required /></label>
                <button class="button button-primary" type="submit">Loan out</button>
            </form>
        }
        @* Still offered for a kit member that is not out: it can carry a holder from before it joined the kit, and this is the only way to clear that. *@
        @if (asset.AssignedUserId is not null)
        {
            <form method="post" asp-page-handler="Return" asp-fragment="asset-loans" class="import-row">
                <input type="hidden" name="id" value="@asset.Id" />
                <label>Return with status<select name="status">@foreach (var item in Model.Statuses) { <option value="@item" selected="@(string.Equals(item, "In stock or spare", StringComparison.OrdinalIgnoreCase) || (!Model.Statuses.Contains("In stock or spare", StringComparer.OrdinalIgnoreCase) && string.Equals(item, asset.Status, StringComparison.OrdinalIgnoreCase)))">@item</option> }</select></label>
                <button class="button button-secondary" type="submit">Return device</button>
            </form>
        }
    </div>

    @* Disposal is recorded rather than deleted: the asset leaves the working estate but stays in the register, which is
       what finance and auditors need. Deleting is still there for something entered by mistake. *@
    @if (Model.IsDisposed)
    {
        <div class="notice">
            <strong>Disposed@(asset.DisposalDate is { } disposedOn ? " on " + AssetInsights.Format(disposedOn) : "").</strong>
            @(string.IsNullOrWhiteSpace(asset.DisposalMethod) ? "" : asset.DisposalMethod + ".")
            @(asset.DisposalProceeds is { } got ? $"Proceeds {got.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}." : "")
            @(string.IsNullOrWhiteSpace(asset.DisposedBy) ? "" : $"Disposed of by {asset.DisposedBy}.")
            @(string.IsNullOrWhiteSpace(asset.DisposalCertificate) ? "" : $"Certificate {asset.DisposalCertificate}.")
            It stays in the register for audit, and appears in the finance report.
        </div>
    }
    else
    {
        <details class="dispose-block">
            <summary>Record a disposal</summary>
            <p class="muted">Use this when the asset leaves the school — sold, recycled, donated or written off. It keeps the record for finance and auditors instead of deleting it. Book it back in, or take it out of its kit, first.</p>
            <form method="post" asp-page-handler="Dispose" asp-fragment="asset-loans" class="import-row" data-confirm="Record this asset as disposed?">
                <input type="hidden" name="id" value="@asset.Id" />
                <label>Date<input name="disposalDate" type="date" max="@Model.Today.ToString("yyyy-MM-dd")" required /></label>
                <label>How<select name="disposalMethod" required><option value="">Choose…</option>@foreach (var method in Model.DisposalMethods) { <option value="@method">@method</option> }</select></label>
                <label>Proceeds (optional)<input name="disposalProceeds" type="number" min="0" step="0.01" placeholder="0.00" /></label>
                <label>Disposed of by (optional)<input name="disposedBy" placeholder="Person or recycling company" /></label>
                <label>Certificate (optional)<input name="disposalCertificate" placeholder="WEEE or data destruction certificate number" /></label>
                <button class="button button-danger" type="submit">Record disposal</button>
            </form>
        </details>
    }
    }
    <h3 class="asset-subheading">Who has held it</h3>
    <div class="table-wrap"><table class="ticket-table stack-table"><thead><tr><th data-stack="head">Held by</th><th>From</th><th>Until</th><th>Due back</th></tr></thead><tbody>
    @foreach (var period in Model.Ownership)
    {
        <tr>
            <td>@period.UserName @if (period.EndedAt is null) { <span class="badge">Current</span> }</td>
            <td>@(period.StartedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Before records began")</td>
            <td>@(period.EndedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "-")</td>
            <td>@(period.DueBack.HasValue ? AssetInsights.Format(period.DueBack.Value) : "-")</td>
        </tr>
    }
    @if (Model.Ownership.Count == 0) { <tr><td colspan="4" class="empty">This asset has not been assigned to anyone.</td></tr> }
    </tbody></table></div>
</section>

@* ---- Tickets ---- *@
<section id="asset-tickets" class="ticket-tab-panel panel" role="tabpanel" hidden>
    <div class="panel-heading"><div><h2>Linked tickets</h2></div>@if (linkedTicketRecords.Count > 0) { <a class="button button-secondary" asp-page="/Jobs" asp-route-asset="@asset.Id" asp-route-view="all">Open in ticket list</a> }</div>
    <div class="asset-job-list">
        @foreach (var ticket in linkedTicketRecords)
        {
            <div class="asset-job-option">
                <a href="/Job?number=@ticket.Number"><span><strong>#@ticket.Number - @ticket.Title</strong><small>@ticket.Status - @ticket.Priority - @ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></span></a>
                <form method="post" asp-page-handler="UnlinkTicket" asp-fragment="asset-tickets" class="inline-unlink-form">
                    <input type="hidden" name="id" value="@asset.Id" />
                    <input type="hidden" name="ticketNumber" value="@ticket.Number" />
                    <button class="icon-button delete-icon" type="submit" title="Unlink ticket" aria-label="Unlink ticket #@ticket.Number">@Icons.Close</button>
                </form>
            </div>
        }
        @if (linkedTicketRecords.Count == 0) { <p class="empty">No tickets are linked to this asset yet.</p> }
    </div>
    <form method="post" asp-page-handler="LinkTicket" asp-fragment="asset-tickets" class="asset-link-ticket-form">
        <input type="hidden" name="id" value="@asset.Id" />
        <label>Link a ticket<select name="ticketNumber" data-picker><option value="">Select a ticket…</option>@foreach (var ticket in unlinkedTickets) { <option value="@ticket.Number">#@ticket.Number - @ticket.Title</option> }</select></label>
        <button class="button button-secondary" type="submit">Link ticket</button>
        @if (unlinkedTickets.Count == 0) { <p class="empty">Every ticket is already linked to this asset.</p> }
    </form>
</section>

@* ---- Comments ---- *@
<section id="asset-comments" class="ticket-tab-panel panel" role="tabpanel" hidden>
    <form method="post" asp-page-handler="AddComment" asp-fragment="asset-comments" class="comment-form asset-comment-form">
        <input type="hidden" name="id" value="@asset.Id" />
        <label for="asset-comment">Add a comment</label>
        <textarea id="asset-comment" name="comment" rows="3" placeholder="Add a note about this asset…"></textarea>
        <button class="button button-primary" type="submit">Add comment</button>
    </form>
    @if (asset.Comments.Count > 0)
    {
        <div class="comment-list">
            @foreach (var comment in asset.Comments.OrderByDescending(x => x.CreatedAt))
            {
                <article class="comment"><p>@comment.Text</p><small><strong>@Actor.Label(comment.By)</strong> · @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>@if (Model.CanRemoveComment(comment))
                {
                    <form method="post" asp-page-handler="RemoveComment" asp-fragment="asset-comments" class="comment-remove" data-confirm="Remove this comment? It can't be put back - the history will only record that it was removed.">
                        <input type="hidden" name="id" value="@asset.Id" /><input type="hidden" name="comment" value="@HelpdeskStore.CommentKey(comment.CreatedAt)" />
                        <button class="link-button" type="submit">Remove</button>
                    </form>
                }</article>
            }
        </div>
    }
    else
    {
        <p class="muted">No comments have been added.</p>
    }
</section>

@* ---- History ---- *@
<section id="asset-history" class="ticket-tab-panel panel" role="tabpanel" hidden>
    @if (asset.History.Count > 0)
    {
        <div class="history-list">
            @foreach (var activity in asset.History.OrderByDescending(x => x.CreatedAt))
            {
                <article class="history-entry"><strong>@activity.Action</strong><p>@activity.Details</p><small>@Actor.Label(activity.By) · @activity.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small></article>
            }
        </div>
    }
    else
    {
        <p class="muted">No asset changes have been recorded.</p>
    }
</section>
@section Scripts {
<script src="~/js/model-filter.js" asp-append-version="true"></script>
}
