@page
@model LoginModel
@{ ViewData["Title"] = "Sign in"; }
<div class="signin-shell">
    <div class="page-heading"><div><h1>Technician sign-in</h1><p class="hero-copy">For the people who run the helpdesk.</p></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }
    <section class="panel">
        <form method="post" class="settings-form">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
            <label>Email<input name="Email" type="email" value="@Model.Email" maxlength="254" autocomplete="username" required autofocus /></label>
            <label>Password<input name="Password" type="password" maxlength="256" autocomplete="current-password" required /></label>
            <button class="button button-primary portal-button">Sign in</button>
            @if (Model.RecoveryKeysAllowed) { <p class="muted"><a asp-page="/ForgotPassword">Forgotten your password?</a> Use your recovery key, or ask an administrator to set you a new one.</p> }
            else { <p class="muted">Forgotten your password? Ask an administrator to set you a new one.</p> }
        </form>
    </section>
    <p class="muted portal-tech-link">Reporting a problem? <a asp-page="/Portal/Index">Go to the staff portal →</a></p>
</div>
