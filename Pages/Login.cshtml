@page
@model LoginModel
@{ ViewData["Title"] = "Sign in"; }
<div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>Sign in</h1></div></div>
<section class="panel" style="max-width:420px;">
    <form method="post" class="settings-form">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <label>Email<input name="Email" type="email" value="@Model.Email" required autofocus /></label>
        <label>Password<input name="Password" type="password" required /></label>
        <button class="button button-primary">Sign in</button>
    </form>
</section>
