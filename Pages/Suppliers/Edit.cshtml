@model EduHelpdesk.Pages.Suppliers.EditModel
@{ViewData["Title"]=Model.Supplier?.Id==Guid.Empty?"Add supplier":"Edit supplier";}<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/Suppliers">← Back</a></div><section class="panel"><form method="post" class="settings-form"><input type="hidden" asp-for="Supplier.Id"/><input type="hidden" asp-for="Supplier.CreatedAt"/><div asp-validation-summary="All" class="validation-summary-errors"></div><label>Name<input asp-for="Supplier.Name" required /></label><label>Contact name<input asp-for="Supplier.ContactName"/></label><label>Email<input asp-for="Supplier.Email" type="email"/></label><label>Phone<input asp-for="Supplier.Phone"/></label><label>Address<input asp-for="Supplier.AddressLine1"/></label><label>Address line 2<input asp-for="Supplier.AddressLine2"/></label><label>City<input asp-for="Supplier.City"/></label><label>State / region<input asp-for="Supplier.StateRegion"/></label><label>Postal code<input asp-for="Supplier.PostalCode"/></label><label>Country<input asp-for="Supplier.Country"/></label><label>Website<input asp-for="Supplier.Website"/></label><label>Notes<textarea asp-for="Supplier.Notes"></textarea></label><button class="button button-primary">Save supplier</button></form></section>
