@page
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Kits.EditModel
@{
    var editing = Model.Kit is not null;
    var locked = Model.OpenLoan is not null;
    ViewData["Title"] = !editing ? "Add loan kit" : locked ? Model.Kit!.Name : $"Edit {Model.Kit!.Name}";
}
<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / LOAN KITS</p><h1>@ViewData["Title"]</h1></div>
    <a class="button button-secondary" asp-page="/Kits">← Back</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

@if (Model.OpenLoan is { } openLoan)
{
    @* Read-only for every role, Administrator included. The kit record has to match what the borrower actually has,
       so it cannot change until it comes back (HelpdeskStore.OutOnLoanBlock refuses a save either way). *@
    <div class="notice notice-warning kit-locked">
        <div>
            <strong>Out on loan with @openLoan.BorrowerName</strong> since @AssetInsights.Format(DateOnly.FromDateTime(openLoan.IssuedAt.ToLocalTime())), due back @AssetInsights.Format(openLoan.DueBack)@(openLoan.IsOverdue(AssetInsights.Today) ? " (overdue)" : "").
            The kit can't be changed until it's booked back in.
        </div>
        @if (Model.CanBookIn)
        {
            <form method="post" asp-page="/Kits" asp-page-handler="Return" class="loan-return-form">
                <input type="hidden" name="kitId" value="@Model.Kit!.Id" />
                <input name="notes" placeholder="Anything missing? (optional)" aria-label="Return notes for @Model.Kit!.Name" />
                <button class="button button-secondary">Book back in</button>
            </form>
        }
    </div>
}

<section class="panel">
    <form method="post" class="settings-form">
        @if (editing) { <input type="hidden" name="id" value="@Model.Kit!.Id" /> }
        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        @* A disabled fieldset greys out and stops every control inside it in one go. *@
        <fieldset class="kit-fields" disabled="@locked">
        <label>Kit name <span class="required-marker">*</span>
            <input name="name" value="@Model.Kit?.Name" placeholder="e.g. Loan Kit 3" required autofocus="@(!locked)" />
        </label>
        <label>Notes<input name="notes" value="@Model.Kit?.Notes" placeholder="e.g. Dell laptop, charger and mouse in a grey case" /></label>

        <div class="kit-picker" id="kit-picker" data-search-url="@Url.Page("/Kits/Edit", "Search", new { id = Model.Kit?.Id })">
            <p class="eyebrow">What's in it <span class="badge" id="kit-count">@Model.SelectedAssets.Count</span></p>
            @if (!locked)
            {
                <small class="muted">Search for the assets in this kit and add them. You can swap them later without losing the kit's loan history. Leave it empty if you don't track the contents.</small>
            }
            <ul class="kit-contents" id="kit-contents">
                @foreach (var asset in Model.SelectedAssets)
                {
                    <li>
                        <input type="hidden" name="assetIds" value="@asset.Id" />
                        <span><a asp-page="/Asset" asp-route-id="@asset.Id"><strong>@asset.AssetTag</strong></a> <span class="muted">@EduHelpdesk.Pages.Kits.EditModel.Detail(asset)</span></span>
                        @if (!locked) { <button type="button" class="button button-secondary kit-remove" aria-label="Remove @asset.AssetTag">Remove</button> }
                    </li>
                }
            </ul>
            <p class="muted kit-empty" id="kit-empty" hidden="@(Model.SelectedAssets.Count > 0)">Nothing in this kit yet.</p>

            @if (!locked)
            {
                <label class="kit-search-label">Add an asset
                    <input type="search" id="kit-search" autocomplete="off" placeholder="Search by tag, serial number, make, model, type or location"
                           role="combobox" aria-expanded="false" aria-controls="kit-results" aria-autocomplete="list" />
                </label>
                <ul class="kit-results" id="kit-results" role="listbox" hidden></ul>
                <small class="muted" id="kit-search-hint">Assets that are assigned to someone, on loan, disposed of or already in another kit aren't offered.</small>
            }
        </div>

        @if (editing)
        {
            <label class="toggle-label">
                <input type="checkbox" name="retired" value="true" checked="@Model.Kit!.IsRetired" />
                Retired — keep its history, but stop offering it for new loans
            </label>
        }

        @if (!locked) { <button class="button button-primary">@(editing ? "Save kit" : "Add kit")</button> }
        </fieldset>
    </form>
</section>

@if (editing)
{
    <section class="panel directory-panel">
        <div class="panel-heading"><div><p class="eyebrow">HISTORY</p><h2>Loans of this kit</h2></div><span class="badge">@Model.History.Count</span></div>
        <div class="table-wrap"><table><thead><tr>
            <th>Borrower</th><th>Reason</th><th>Issued</th><th>Due back</th><th>Returned</th><th>Kept</th>
        </tr></thead><tbody>
        @foreach (var loan in Model.History)
        {
            <tr>
                <td><strong>@loan.BorrowerName</strong>@if (!string.IsNullOrWhiteSpace(loan.IssuedBy)) { <br /><span class="muted">issued by @loan.IssuedBy</span> }</td>
                <td>@loan.Reason</td>
                <td>@loan.IssuedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                <td>@AssetInsights.Format(loan.DueBack)</td>
                <td>@(loan.ReturnedAt is null ? "—" : loan.ReturnedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm"))</td>
                <td>@Model.Duration(loan)@if (loan.ReturnedAt is null) { <text> </text><span class="badge badge-warning">still out</span> }</td>
            </tr>
        }
        @if (Model.History.Count == 0) { <tr><td colspan="6" class="empty">This kit hasn't been issued yet.</td></tr> }
        </tbody></table></div>

        @if (Model.History.Count == 0)
        {
            <form method="post" asp-page-handler="Delete" class="import-row" data-confirm="Delete this kit?">
                <input type="hidden" name="id" value="@Model.Kit!.Id" />
                <button class="button button-danger">Delete kit</button>
            </form>
        }
        else
        {
            <p class="muted">Kits with loan history can't be deleted, so the report keeps the full picture. Tick <strong>Retired</strong> above to take it out of use.</p>
        }
    </section>
}

@section Scripts {
<script src="~/js/kit-picker.js" asp-append-version="true"></script>

}
