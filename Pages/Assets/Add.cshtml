@page
@model EduHelpdesk.Pages.Assets.AddModel
@{ ViewData["Title"] = "Add asset"; }
<div class="page-heading"><div><p class="eyebrow">ASSET REGISTER</p><h1>Add asset</h1></div><a class="button button-secondary" asp-page="/Assets">← Back to assets</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }
<section class="panel"><form method="post" class="settings-form">
<label>Asset tag<input name="assetTag" value="@Model.Posted("assetTag")" required /></label>
<label>Make<select name="make" id="asset-make-select">@foreach (var item in Model.AssetMakes) { <option value="@item" selected="@(item == Model.Posted("make"))">@item</option> }</select></label>
<label>Model<select name="model" id="asset-model-select" required>@foreach (var item in Model.AssetModels) { <option value="@item" data-make="@Model.AssetModelMakes.GetValueOrDefault(item)" selected="@(item == Model.Posted("model"))">@item</option> }</select></label>
<label>Type<select name="type" required>@foreach (var item in Model.AssetTypes) { <option value="@item" selected="@(item == Model.Posted("type"))">@item</option> }</select></label>
<label>Serial number<input name="serialNumber" value="@Model.Posted("serialNumber")" /></label>
<label>Status<select name="status">@foreach (var item in Model.Statuses) { <option value="@item" selected="@(item == Model.Posted("status"))">@item</option> }</select></label>
<label>Location<select name="location"><option value="">Unassigned</option>@foreach (var item in Model.Locations) { <option value="@item" selected="@(item == Model.Posted("location"))">@item</option> }</select></label>
<label>Assigned user<select name="assignedUserId" data-picker><option value="">Unassigned</option>@foreach (var item in Model.Users) { <option value="@item.Id" selected="@(item.Id.ToString() == Model.Posted("assignedUserId"))">@item.Name</option> }</select></label>
<label>Supplier<select name="supplierId"><option value="">No supplier</option>@foreach (var item in Model.Suppliers) { <option value="@item.Id" selected="@(item.Id.ToString() == Model.Posted("supplierId"))">@item.Name</option> }</select></label>
<label>Purchase date<input name="purchaseDate" type="date" value="@Model.Posted("purchaseDate")" /></label>
<label>Purchase price<input name="purchasePrice" type="number" min="0" step="0.01" value="@Model.Posted("purchasePrice")" placeholder="0.00" /></label>
<label>Purchase order<input name="purchaseOrder" value="@Model.Posted("purchaseOrder")" /></label>
                <label>Quote reference<input name="quoteReference" value="@Model.Posted("quoteReference")" /></label>
<label>Warranty end<input name="warrantyEnd" type="date" value="@Model.Posted("warrantyEnd")" /></label>
<label>Replacement date<input name="replacementDate" type="date" value="@Model.Posted("replacementDate")" /><small class="muted">Optional. Leave blank to use the lifespan set for this asset type.</small></label>
<button class="button button-primary" type="submit">Add asset</button>
</form></section>
@section Scripts {
<script src="~/js/model-filter.js" asp-append-version="true"></script>
<script>initModelFilter(document.getElementById("asset-make-select"), document.getElementById("asset-model-select"));</script>
}
