@page
@using EduHelpdesk.Services
@model ChangePasswordModel
@{ ViewData["Title"] = "Change password"; }
@if (Model.NewRecoveryKey is { } recoveryKey)
{
    <div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>Password changed</h1><p class="hero-copy">One more thing before you start: save your recovery key.</p></div></div>
    <partial name="_RecoveryKeyPanel" model="recoveryKey" />
    return;
}
<div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>Change password</h1></div>
@if (!Model.Forced) { <a class="button button-secondary" asp-page="/Index">← Back</a> }</div>
@if (Model.Forced) { <div class="notice">Your password was set by someone else, so choose a new one that only you know before carrying on.@(Model.OffersRecoveryKey ? " You'll then be given a recovery key to save, for if you ever forget it." : "")</div> }
<section class="panel" style="max-width:420px;">
    <form method="post" class="settings-form">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <label>Current password<input name="CurrentPassword" type="password" maxlength="256" autocomplete="current-password" required autofocus /></label>
        <label>New password<input name="NewPassword" type="password" required minlength="@PasswordRules.MinimumLength" maxlength="@PasswordRules.MaximumLength" autocomplete="new-password" /><small class="muted">@PasswordRules.Hint</small></label>
        <label>Confirm new password<input name="ConfirmPassword" type="password" required minlength="@PasswordRules.MinimumLength" maxlength="@PasswordRules.MaximumLength" autocomplete="new-password" /></label>
        <button class="button button-primary">Change password</button>
    </form>
    @if (Model.Forced)
    {
        <form method="post" asp-page="/Logout"><button type="submit" class="link-button">Sign out instead</button></form>
    }
</section>
