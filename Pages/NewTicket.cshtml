@page
@model NewTicketModel
@{
    ViewData["Title"] = "New ticket";
}

<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / NEW TICKET</p><h1>Log a technician ticket</h1><p class="hero-copy">Capture the request, assign ownership, and link the affected asset.</p></div>
    <a class="button button-secondary" asp-page="/Index">← Back to overview</a>
</div>

<form method="post" asp-page-handler="CreateTicket" class="panel new-ticket-form">
    <div asp-validation-summary="ModelOnly" class="field-error"></div>
    <div class="form-grid">
        <label>Requester<select asp-for="Ticket.RequesterId" required><option value="">Select a user…</option>@foreach (var user in Model.Users) { <option value="@user.Id">@user.Name · @user.Department</option> }</select></label>
        <label>Assigned technician<select asp-for="Ticket.TechnicianId"><option value="">Unassigned</option>@foreach (var tech in Model.Technicians) { <option value="@tech.Id">@tech.Name · @tech.Team</option> }</select></label>
        <label>Ticket title<input asp-for="Ticket.Title" placeholder="e.g. Projector has no signal" required /></label>
        <label>Asset<select asp-for="Ticket.AssetId"><option value="">No asset / general request</option>@foreach (var asset in Model.Assets) { <option value="@asset.Id">@asset.AssetTag · @asset.Type @asset.Model</option> }</select></label>
        <label>Priority<select asp-for="Ticket.Priority">@foreach (var priority in Model.Priorities) { <option value="@priority">@priority</option> }</select></label>
        <label>Category<select asp-for="Ticket.Category">@foreach (var category in Model.Categories) { <option value="@category">@category</option> }</select></label>
        <label class="full">Description<textarea asp-for="Ticket.Description" rows="7" placeholder="Symptoms, checks already completed, and next action…"></textarea></label>
    </div>
    <div class="heading-actions"><button class="button button-primary" type="submit">Create ticket</button><a class="button button-secondary" asp-page="/Index">Cancel</a></div>
</form>
