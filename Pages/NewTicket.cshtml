@page
@using EduHelpdesk.Services
@using EduHelpdesk.Models
@model NewTicketModel
@{
    ViewData["Title"] = "New ticket";
}

<div class="page-heading">
    <div><h1>Log a ticket</h1><p class="hero-copy">For a job that still needs doing.</p></div>
</div>

@* A template is a shortcut, not a step: a small link that opens the picker, open already once one is in use. *@
@if (Model.Templates.Count > 0)
{
    <details class="template-picker" open="@(Model.AppliedTemplate is not null)">
        <summary>@(Model.AppliedTemplate is { } applied ? $"Started from the template \"{applied.Name}\"" : "Start from a template")</summary>
        <form method="get">
            <label>Template<select name="template" data-autosubmit><option value="">No template</option>@foreach (var item in Model.Templates) { <option value="@item.Id" selected="@(item.Id == Model.AppliedTemplate?.Id)">@item.Name (@item.Type)</option> }</select></label>
        </form>
        @if (Model.AppliedTemplate is not null) { <p class="muted">Everything below can still be changed. Choose "No template" to start again.</p> }
    </details>
}
<form method="post" asp-page-handler="CreateTicket" class="panel new-ticket-form">
    <div asp-validation-summary="ModelOnly" class="field-error"></div>
    <div class="form-section">
        <h2>The issue</h2>
        <div class="form-grid compact">
            <label>Ticket title<input asp-for="Ticket.Title" placeholder="e.g. Projector has no signal" required /></label>
            <label>Requester<select asp-for="Ticket.RequesterId" required data-picker data-picker-placeholder="Type a name, email or department…"><option value="">Select a requester…</option>@foreach (var user in Model.Users) { <option value="@user.Id" data-search="@user.Email @user.Location">@user.Name · @user.Department</option> }</select></label>
            <label class="full">Description<textarea asp-for="Ticket.Description" rows="7" placeholder="Symptoms, checks already completed, and next action…"></textarea></label>
        </div>
    </div>
    <div class="form-section">
        <h2>Classification</h2>
        <div class="form-grid compact">
            <label>Type<select asp-for="Ticket.Type">@foreach (var type in TicketTypes.All) { <option value="@type">@type</option> }</select><small>An incident is something broken; a request is something being asked for.</small></label>
            <label>Priority<select asp-for="Ticket.Priority">@foreach (var priority in Model.Priorities) { <option value="@priority">@priority</option> }</select></label>
            @if (Model.HasSeveralDesks)
            {
                <label>Desk<select id="ticket-desk-select">@foreach (var desk in Model.Desks) { <option value="@desk.Id" selected="@(desk.Id == Model.StartingDesk)">@desk.Name</option> }</select><small>Narrows the categories, teams and technicians to that desk's.</small></label>
            }
            <label><span>Category <help-tip key="ticket.category" /></span><select asp-for="Ticket.Category" id="ticket-category-select">@foreach (var category in Model.Categories) { <option value="@category" data-desk="@Model.DeskOfCategory(category)">@category</option> }</select></label>
            <label>Location<select asp-for="Ticket.Location"><option value="">Not specified</option>@foreach (var location in Model.Locations) { <option value="@location">@location</option> }</select></label>
@if (Model.ShowAssets) {             <label>Assets<select asp-for="Ticket.AssetIds" multiple size="5" data-picker data-picker-placeholder="Type an asset tag, model or serial…">@foreach (var asset in Model.Assets) { <option value="@asset.Id" data-search="@asset.Make @asset.SerialNumber">@asset.AssetTag · @asset.Type @asset.Model</option> }</select><small>Link as many as the job involves, or none for a general request.</small></label> }
        </div>
    </div>
    <div class="form-section">
        <h2>Assignment</h2>
        <div class="form-grid compact">
            <label>Assigned technician<select asp-for="Ticket.TechnicianId" id="ticket-technician-select"><option value="">Unassigned</option>@foreach (var tech in Model.Technicians) { <option value="@tech.Id" data-team="@tech.Team" data-desks="@string.Join(" ", tech.DeskIds)">@tech.Name · @tech.Team</option> }</select><span asp-validation-for="Ticket.TechnicianId" class="field-error"></span></label>
        </div>
        @* Most tickets take the defaults: no team, the SLA worked out from the priority and category, its due date. *@
        <details class="more-options" open="@(Model.AppliedTemplate?.SlaId is not null || !ViewData.ModelState.IsValid)">
            <summary>More options: team, SLA and due date</summary>
            <div class="form-grid compact">
                <label><span>Assigned team <help-tip key="ticket.team" /></span><select asp-for="Ticket.TeamName" id="ticket-team-select"><option value="">No team</option>@foreach (var team in Model.TechnicianTeams) { <option value="@team" data-desk="@Model.DeskOfTeam(team)">@team</option> }</select></label>
                <label><span>SLA <help-tip key="ticket.sla" /></span><select asp-for="Ticket.SlaId"><option value="">Automatic (from priority and category)</option>@foreach (var sla in Model.Slas) { <option value="@sla.Id">@sla.Name (@EduHelpdesk.Services.SlaUnits.Describe(sla))</option> }</select></label>
                <label><span>Due date override <help-tip key="ticket.due-override" /></span><input asp-for="Ticket.DueDate" type="datetime-local" /><small>Leave blank to calculate from the selected SLA.</small></label>
            </div>
        </details>
    </div>
    @if (Model.TicketAttributes.Count > 0)
    {
        @* Hidden while none of the fields applies to the chosen category (wwwroot/js/pages/new-ticket.js). *@
        <div class="form-section" id="ticket-attributes" hidden="@Model.TicketAttributes.All(x => !x.AppliesTo(Model.Ticket.Category))">
            <h2>Additional details</h2>
            <div class="form-grid compact">
                @foreach (var field in Model.TicketAttributes)
                {
                    var hideField = !field.AppliesTo(Model.Ticket.Category);
                    var defaultValue = Model.TemplateAttributeValues.GetValueOrDefault(field.Id, "");
                    <div class="ticket-attribute-field" data-categories="@System.Text.Json.JsonSerializer.Serialize(field.Categories)" hidden="@hideField">
                        @if (field.FieldType == "dropdown")
                        {
                            <label>@field.Name<select name="Ticket.CustomAttributes[@field.Id]"><option value="">Select an option</option>@foreach (var choice in HelpdeskStore.GetChoices(field)) { <option value="@choice" selected="@(choice == defaultValue)">@choice</option> }</select></label>
                        }
                        else if (field.FieldType == "checkbox")
                        {
                            <label class="toggle-label">@field.Name<input type="checkbox" name="Ticket.CustomAttributes[@field.Id]" value="true" checked="@defaultValue.Equals("true", StringComparison.OrdinalIgnoreCase)" /></label>
                        }
                        else if (field.FieldType == "multi-line")
                        {
                            <label>@field.Name<textarea name="Ticket.CustomAttributes[@field.Id]" rows="3">@defaultValue</textarea></label>
                        }
                        else
                        {
                            <label>@field.Name<input name="Ticket.CustomAttributes[@field.Id]" value="@defaultValue" /></label>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <div class="heading-actions"><button class="button button-primary" type="submit">Create ticket</button><a class="button button-secondary" asp-page="/Index">Cancel</a></div>
</form>
@section Scripts {
<script src="~/js/pages/new-ticket.js" asp-append-version="true"></script>
}
