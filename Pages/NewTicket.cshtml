@page
@using EduHelpdesk.Services
@using EduHelpdesk.Models
@model NewTicketModel
@{
    ViewData["Title"] = "New ticket";
}

<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / NEW TICKET</p><h1>Log a technician ticket</h1><p class="hero-copy">Capture the request, assign ownership, and link the affected asset.</p></div>
    <a class="button button-secondary" asp-page="/Index">← Back to overview</a>
</div>

@if (Model.Templates.Count > 0)
{
    <section class="panel template-picker">
        <form method="get">
            <label>Start from a template<select name="template" data-autosubmit><option value="">No template</option>@foreach (var item in Model.Templates) { <option value="@item.Id" selected="@(item.Id == Model.AppliedTemplate?.Id)">@item.Name (@item.Type)</option> }</select></label>
        </form>
        @if (Model.AppliedTemplate is not null) { <p class="muted">Started from <strong>@Model.AppliedTemplate.Name</strong>. Everything below can still be changed. Choose "No template" to start again.</p> }
    </section>
}
<form method="post" asp-page-handler="CreateTicket" class="panel new-ticket-form">
    <div asp-validation-summary="ModelOnly" class="field-error"></div>
    <div class="form-section">
        <h2>The issue</h2>
        <div class="form-grid compact">
            <label>Requester<select asp-for="Ticket.RequesterId" required data-picker data-picker-placeholder="Type a name, email or department…"><option value="">Select a user…</option>@foreach (var user in Model.Users) { <option value="@user.Id" data-search="@user.Email @user.Location">@user.Name · @user.Department</option> }</select></label>
            <label>Ticket title<input asp-for="Ticket.Title" placeholder="e.g. Projector has no signal" required /></label>
            <label class="full">Description<textarea asp-for="Ticket.Description" rows="7" placeholder="Symptoms, checks already completed, and next action…"></textarea></label>
        </div>
    </div>
    <div class="form-section">
        <h2>Classification</h2>
        <div class="form-grid compact">
            <label>Type<select asp-for="Ticket.Type">@foreach (var type in TicketTypes.All) { <option value="@type">@type</option> }</select><small>An incident is something broken; a request is something being asked for.</small></label>
            <label>Priority<select asp-for="Ticket.Priority">@foreach (var priority in Model.Priorities) { <option value="@priority">@priority</option> }</select></label>
            <label>Category<select asp-for="Ticket.Category" id="ticket-category-select">@foreach (var category in Model.Categories) { <option value="@category">@category</option> }</select></label>
            <label>Location<select asp-for="Ticket.Location"><option value="">Not specified</option>@foreach (var location in Model.Locations) { <option value="@location">@location</option> }</select></label>
            <label>Assets<select asp-for="Ticket.AssetIds" multiple size="5" data-picker data-picker-placeholder="Type an asset tag, model or serial…">@foreach (var asset in Model.Assets) { <option value="@asset.Id" data-search="@asset.Make @asset.SerialNumber">@asset.AssetTag · @asset.Type @asset.Model</option> }</select><small>Link as many as the job involves, or none for a general request.</small></label>
        </div>
    </div>
    <div class="form-section">
        <h2>Assignment &amp; scheduling</h2>
        <div class="form-grid compact">
            <label>Assigned technician<select asp-for="Ticket.TechnicianId" id="ticket-technician-select"><option value="">Unassigned</option>@foreach (var tech in Model.Technicians) { <option value="@tech.Id" data-team="@tech.Team">@tech.Name · @tech.Team</option> }</select><span asp-validation-for="Ticket.TechnicianId" class="field-error"></span></label>
            <label>Assigned team<select asp-for="Ticket.TeamName" id="ticket-team-select"><option value="">No team</option>@foreach (var team in Model.TechnicianTeams) { <option value="@team">@team</option> }</select></label>
            <label>SLA<select asp-for="Ticket.SlaId"><option value="">No SLA</option>@foreach (var sla in Model.Slas) { <option value="@sla.Id">@sla.Name (@EduHelpdesk.Services.SlaUnits.Describe(sla))</option> }</select></label>
            <label>Due date override <input asp-for="Ticket.DueDate" type="datetime-local" /><small>Leave blank to calculate from the selected SLA.</small></label>
        </div>
    </div>
    @if (Model.TicketAttributes.Count > 0)
    {
        <div class="form-section">
            <h2>Additional details</h2>
            <div class="form-grid compact">
                @foreach (var field in Model.TicketAttributes)
                {
                    var hideField = !field.AppliesTo(Model.Ticket.Category);
                    var defaultValue = Model.TemplateAttributeValues.GetValueOrDefault(field.Id, "");
                    <div class="ticket-attribute-field" data-categories="@System.Text.Json.JsonSerializer.Serialize(field.Categories)" hidden="@hideField">
                        @if (field.FieldType == "dropdown")
                        {
                            <label>@field.Name<select name="Ticket.CustomAttributes[@field.Id]"><option value="">Select an option</option>@foreach (var choice in HelpdeskStore.GetChoices(field)) { <option value="@choice" selected="@(choice == defaultValue)">@choice</option> }</select></label>
                        }
                        else if (field.FieldType == "checkbox")
                        {
                            <label class="toggle-label">@field.Name<input type="checkbox" name="Ticket.CustomAttributes[@field.Id]" value="true" checked="@defaultValue.Equals("true", StringComparison.OrdinalIgnoreCase)" /></label>
                        }
                        else if (field.FieldType == "multi-line")
                        {
                            <label>@field.Name<textarea name="Ticket.CustomAttributes[@field.Id]" rows="3">@defaultValue</textarea></label>
                        }
                        else
                        {
                            <label>@field.Name<input name="Ticket.CustomAttributes[@field.Id]" value="@defaultValue" /></label>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <div class="heading-actions"><button class="button button-primary" type="submit">Create ticket</button><a class="button button-secondary" asp-page="/Index">Cancel</a></div>
</form>
@section Scripts {
<script src="~/js/pages/new-ticket.js" asp-append-version="true"></script>
}
