@page
@using EduHelpdesk.Services
@using EduHelpdesk.Models
@model JobModel
@inject HelpdeskStore Helpdesk
@{
    ViewData["Title"] = $"Job {Model.Reference}";
}

@* The header keeps only the everyday actions as buttons. The three print options share one menu, and merge and delete
   sit under "More" - they are rare, need Tickets: Delete, and a destructive button one slip away from "Mark as closed"
   was never a good neighbour. Back is navigation rather than an action, so it is a plain link above the title. *@
<a class="back-link no-print" href="@Model.BackUrl">← Back to tickets</a>
@* The ticket's bar stays at the top of the screen while the page scrolls (wwwroot/js/pages/job.js marks it stuck),
   so the everyday actions are always to hand however far down the comments go. *@
<div class="page-heading ticket-bar" id="ticket-bar">
    <div class="ticket-bar-title">
        <h1><span class="ticket-bar-number">@Model.Reference</span> @Model.Ticket.Title</h1>
        <p class="ticket-bar-meta">
            <span class="status status-@Helpdesk.StatusTone(Model.Ticket.Status)">@Model.Ticket.Status</span>
            <span class="priority @Model.Ticket.Priority.ToLowerInvariant()">@Model.Ticket.Priority</span>
            @if (Model.DueState != DueState.None) { <span class="badge @(Model.DueState == DueState.Overdue ? "badge-warning" : "")">@Model.DueText</span> }
            <span class="muted">@(Model.Requester?.Name ?? "Unknown requester")@(string.IsNullOrWhiteSpace(Model.Ticket.Location) ? "" : " · " + Model.Ticket.Location)</span>
        </p>
    </div>
    <div class="heading-actions no-print">
        @if (Model.CanAssignToMe)
        {
            <form method="post" asp-page-handler="AssignToMe"><input type="hidden" name="number" value="@Model.Ticket.Number" /><button class="button button-secondary" type="submit">Assign to me</button></form>
        }
        @if (Model.CanSayOnMyWay)
        {
            <form method="post" asp-page-handler="OnMyWay"><input type="hidden" name="number" value="@Model.Ticket.Number" /><button class="button button-secondary" type="submit" title="Assigns the ticket to you and tells the requester you're on your way">On my way</button></form>
        }
        @if (Model.CanEdit && Model.Ticket.Status != "Closed")
        {
            if (Model.RequiresCloseMessage) { <button class="button button-primary" type="button" data-open-blade="close-dialog-backdrop">Mark as closed</button> }
            else { <form method="post" asp-page-handler="Close"><input type="hidden" name="number" value="@Model.Ticket.Number" /><button class="button button-primary" type="submit">Mark as closed</button></form> }
        }
        <partial name="_RawDataLink" model='("ticket", Model.Ticket.Number.ToString())' />
        <details class="nav-menu action-menu">
            <summary class="button button-secondary">🖨 Print<span class="chev" aria-hidden="true">▾</span></summary>
            <div class="nav-panel nav-panel-right">
                <button type="button" data-action="print">Ticket</button>
                <button type="button" data-open-window="@Url.Page("/PrintLabel", new { number = Model.Ticket.Number })">Label</button>
                <button type="button" data-open-window="@Url.Page("/PrintJobSheet", new { number = Model.Ticket.Number })">Job sheet</button>
                <a href="@Url.Page("/Job", "Report", new { number = Model.Ticket.Number })" target="_blank" rel="noopener" title="Everything on the ticket as a PDF: details, conversation with internal notes, history and the attachments">Full report (PDF)</a>
                <a href="@Url.Page("/Job", "Report", new { number = Model.Ticket.Number, internalNotes = false })" target="_blank" rel="noopener" title="The same report without internal notes, the change history or files kept for the IT team, to give to the requester or anyone outside the IT team">Requester copy (PDF)</a>
            </div>
        </details>
        @if (Model.CanDelete)
        {
            <details class="nav-menu action-menu">
                <summary class="button button-secondary" aria-label="More actions">More<span class="chev" aria-hidden="true">▾</span></summary>
                <div class="nav-panel nav-panel-right">
                    <button type="button" data-open-blade="merge-dialog-backdrop">Merge into another ticket…</button>
                    <button type="button" class="menu-danger" data-open-blade="delete-dialog-backdrop">Delete ticket…</button>
                </div>
            </details>
        }
    </div>
</div>
@if (Model.Ticket.Status != "Closed" && Model.RequiresCloseMessage)
{
    <div id="close-dialog-backdrop" class="blade-backdrop no-print">
        <div class="blade" role="dialog" aria-modal="true" aria-labelledby="close-dialog-title">
            <div class="blade-head"><h2 id="close-dialog-title">Close ticket @Model.Reference</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
            <p class="muted">This ticket is <strong>@Model.Ticket.Priority</strong> priority in the <strong>@Model.Ticket.Category</strong> category, so a closing message is required before it can be closed.</p>
            <form method="post" asp-page-handler="Close" class="blade-form">
                <input type="hidden" name="number" value="@Model.Ticket.Number" />
                <label><span>Closing message <help-tip key="ticket.closing-message" /></span><textarea name="closingMessage" rows="5" required placeholder="Explain how this was resolved…"></textarea></label>
                <div class="blade-actions"><button class="button button-primary" type="submit">Close ticket</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
            </form>
        </div>
    </div>
}
<div id="merge-dialog-backdrop" class="blade-backdrop no-print">
    <div class="blade" role="dialog" aria-modal="true" aria-labelledby="merge-dialog-title">
        <div class="blade-head"><h2 id="merge-dialog-title">Merge ticket @Model.Reference</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
        <p class="muted">Choose the ticket to merge this one into. Comments, linked assets, and assigned parts will be copied across, and this ticket will be closed.</p>
        <form method="post" asp-page-handler="Merge" class="blade-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <label>Merge into<select name="targetNumber" required><option value="">Select a ticket…</option>@foreach (var candidate in Model.MergeCandidates) { <option value="@candidate.Number">@Helpdesk.Ref(candidate) - @candidate.Title</option> }</select></label>
            <div class="blade-actions"><button class="button button-primary" type="submit">Merge ticket</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
        </form>
    </div>
</div>
<div id="delete-dialog-backdrop" class="blade-backdrop no-print">
    <div class="blade" role="dialog" aria-modal="true" aria-labelledby="delete-dialog-title">
        <div class="blade-head"><h2 id="delete-dialog-title">Delete ticket @Model.Reference</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
        <p class="muted">This permanently removes the ticket, its comments, and history. Any parts assigned to it will be returned to stock. This can't be undone.</p>
        <form method="post" asp-page-handler="Delete" class="blade-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <div class="blade-actions"><button class="button button-danger" type="submit">Delete permanently</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
        </form>
    </div>
</div>
<div class="print-brand">@if (Helpdesk.LogoVersion is { } logoVersion) { <img class="print-logo" src="@Url.Content("~/branding/logo")?v=@logoVersion" alt="" /> } else { <span class="brand-mark">EH</span> }<strong>@Helpdesk.Branding.BrandName</strong><span>Job sheet</span></div>
@if (!string.IsNullOrWhiteSpace(Model.TemplateHtml))
{
    <div class="uploaded-print-template">@Html.Raw(Model.TemplateHtml)</div>
}
else
{
    <div class="print-only print-worksheet">
        <div class="print-header"><span class="print-job-number">@Model.Reference</span><span class="status">@Model.Ticket.Status</span></div>
        <h1 class="print-title">@Model.Ticket.Title</h1>
        <table class="print-facts">
            <tr><th>Priority</th><td>@Model.Ticket.Priority</td><th>Type</th><td>@Model.Ticket.Type</td></tr>
            <tr><th>Category</th><td>@Model.Ticket.Category@(string.IsNullOrWhiteSpace(Model.Ticket.SubCategory) ? "" : " › " + Model.Ticket.SubCategory)</td><th>Team</th><td>@(Model.Ticket.TeamName ?? "No team")</td></tr>
            <tr><th>Location</th><td>@(Model.Ticket.Location ?? "Not specified")</td><th>SLA</th><td>@(Model.Slas.FirstOrDefault(x => x.Id == Model.Ticket.SlaId)?.Name ?? "No SLA")</td></tr>
            <tr><th>Technician</th><td colspan="3">@(Model.Technician?.Name ?? "Unassigned")</td></tr>
            <tr><th>Created</th><td>@Model.Ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><th>Due</th><td>@(Model.Ticket.DueDate?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "No due date")</td></tr>
        </table>
        <div class="print-section"><h2>Description</h2><p>@Model.Ticket.Description</p></div>
        <div class="print-section"><h2>Requester</h2><p>@(Model.Requester?.Name ?? "Unknown")<br />@Model.Requester?.Email<br />@Model.Requester?.Department · @Model.Requester?.Location</p></div>
        @if (Model.LinkedAssets.Count > 0)
        {
            <div class="print-section">
                <h2>Assets</h2>
                <table class="print-assets">
                    <tr><th>Tag</th><th>Type</th><th>Model</th><th>Serial</th></tr>
                    @foreach (var asset in Model.LinkedAssets) { <tr><td>@asset.AssetTag</td><td>@asset.Type</td><td>@asset.Model</td><td>@asset.SerialNumber</td></tr> }
                </table>
            </div>
        }
        @if (Model.Relations.Count > 0)
        {
            <div class="print-section">
                <h2>Related tickets</h2>
                @foreach (var relation in Model.Relations) { <p>@relation.Label: @relation.Reference @relation.Title (@relation.Status)</p> }
            </div>
        }
        @{ var printedAttributes = Model.TicketAttributes.Where(x => !string.IsNullOrWhiteSpace(Model.TicketAttributeValues.GetValueOrDefault(x.Id, ""))).ToList(); }
        @if (printedAttributes.Count > 0)
        {
            <div class="print-section">
                <h2>Additional details</h2>
                @foreach (var field in printedAttributes) { <p><strong>@field.Name:</strong> @Model.TicketAttributeValues[field.Id]</p> }
            </div>
        }
        <div class="print-section">
            <h2>Comments</h2>
            @{ var printedComments = Model.Ticket.Comments.Where(x => !x.IsInternal).OrderBy(x => x.CreatedAt).ToList(); }
            @if (printedComments.Count == 0) { <p class="muted">No comments.</p> }
            @foreach (var comment in printedComments) { <p><strong>@comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong> — @comment.Text</p> }
        </div>
        <div class="print-signoff">
            <div class="signature-block"><span class="signature-line"></span><small>Technician signature &amp; date</small></div>
            <div class="signature-block"><span class="signature-line"></span><small>Requester signature &amp; date</small></div>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<div class="job-detail-grid">
    <section class="panel job-main printable-job">
        <div class="panel-heading"><div><h2>@Model.Ticket.Title</h2></div><button class="button button-secondary no-print" type="button" id="ticket-content-edit" data-edit-content>Edit details</button></div>
        <div id="ticket-content-display">
            <p class="job-description">@Model.Ticket.Description</p>
        </div>
        <form method="post" asp-page-handler="UpdateContent" class="ticket-content-form no-print" id="ticket-content-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <label>Title<input name="title" value="@Model.Ticket.Title" required /></label>
            <label>Description<textarea name="description" rows="7">@Model.Ticket.Description</textarea></label>
            <div class="heading-actions"><button class="button button-primary" type="submit">Save details</button><button class="button button-secondary" type="button" data-cancel-content>Cancel</button></div>
        </form>
        <div class="job-meta"><div><span>Created</span><strong>@Model.Ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div><div><span>Last modified</span><strong>@Model.Ticket.LastModifiedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div><div><span>Closed</span><strong>@(Model.Ticket.ClosedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Not closed")</strong></div></div>
        @if (Model.Checklist.Count > 0)
        {
            var closed = Model.Ticket.Status == "Closed";
            var left = Model.Checklist.Count(x => !x.Answered);
            var fails = Model.Checklist.Count(x => x.Failed);
            @* The premises check this ticket was logged for (HelpdeskStore.Checks): filled in here, and closing waits for it. *@
            <section class="checklist" id="checklist">
                <p class="section-heading">Checklist - @Model.Checklist[0].ScheduleName <span class="badge @(fails > 0 ? "badge-warning" : "")">@(left > 0 ? $"{left} to do" : fails > 0 ? $"{fails} failed" : "All passed")</span></p>
                <form method="post" asp-page-handler="SaveChecklist">
                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                    <div class="table-wrap"><table class="checklist-table">
                        <thead><tr><th>Check</th><th>Result <help-tip key="check.result" /></th><th>Note</th></tr></thead>
                        <tbody>
                            @foreach (var line in Model.Checklist)
                            {
                                <tr class="@(line.Failed ? "checklist-failed" : "")">
                                    <td>@line.Label@if (line.Kind == CheckKinds.Reading) { <br /><small class="muted">Should be @HelpdeskStore.DescribeLimits(line.Min, line.Max, line.Unit)</small> }@if (line.By is { } by && line.AnsweredAt is { } answered) { <br /><small class="muted">@by.Name, @answered.ToLocalTime().ToString("d MMM HH:mm")</small> }</td>
                                    <td>
                                        @if (line.Kind == CheckKinds.Reading)
                                        {
                                            <label class="visually-hidden" for="reading-@line.Id">Reading for @line.Label</label>
                                            <input id="reading-@line.Id" name="reading-@line.Id" inputmode="decimal" value="@line.Reading?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" disabled="@closed" class="checklist-reading" />@line.Unit
                                            @if (line.Result.Length > 0) { <span class="badge @(line.Failed ? "badge-warning" : "")">@(line.Failed ? "Fail" : "Pass")</span> }
                                        }
                                        else if (line.Kind != CheckKinds.Note)
                                        {
                                            <label class="toggle-label"><input type="radio" name="result-@line.Id" value="pass" checked="@(line.Result == "pass")" disabled="@closed" /> Pass</label>
                                            <label class="toggle-label"><input type="radio" name="result-@line.Id" value="fail" checked="@(line.Result == "fail")" disabled="@closed" /> Fail</label>
                                        }
                                    </td>
                                    <td><label class="visually-hidden" for="note-@line.Id">Note for @line.Label</label><input id="note-@line.Id" name="note-@line.Id" value="@line.Note" maxlength="@HelpdeskStore.MaxCheckNoteLength" disabled="@closed" placeholder="@(line.Kind == CheckKinds.Note ? "What was done" : "Optional")" /></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    @if (!closed && Model.CanEdit) { <button class="button button-primary" type="submit">Save checklist</button> }
                </form>
            </section>
        }
        <p class="section-heading">Assignment &amp; scheduling</p>
        <div class="job-detail-fields">
            <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow field-name">Assigned technician</p><button id="technician-edit" class="icon-button edit-icon" type="button" title="Edit technician" data-edit-field="technician">@Icons.Edit</button></div><strong class="field-value" id="technician-value">@(Model.Technician?.Name ?? Model.Ticket.TeamName ?? "Unassigned")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="technician-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="technician" /><select name="value"><option value="">Unassigned</option>@foreach (var tech in Model.TeamTechnicians) { <option value="@tech.Id" selected="@(tech.Id == Model.Ticket.TechnicianId)">@tech.Name · @tech.Team</option> }</select><button class="icon-button save-icon" type="submit" title="Save technician" aria-label="Save technician">@Icons.Check</button></form></div>
            <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow field-name">Assigned team</p><button id="team-edit" class="icon-button edit-icon" type="button" title="Edit team" data-edit-field="team">@Icons.Edit</button></div><strong class="field-value" id="team-value">@(Model.Ticket.TeamName ?? "No team")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="team-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="team" /><select name="value"><option value="">No team</option>@foreach (var team in Model.TechnicianTeams) { <option value="@team" selected="@(team == Model.Ticket.TeamName)">@team</option> }</select><button class="icon-button save-icon" type="submit" title="Save team" aria-label="Save team">@Icons.Check</button></form></div>
            <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">SLA <help-tip key="ticket.sla" /></p><button id="sla-edit" class="icon-button edit-icon" type="button" title="Edit SLA" data-edit-field="sla">@Icons.Edit</button></div><strong class="field-value" id="sla-value">@(Model.Slas.FirstOrDefault(x => x.Id == Model.Ticket.SlaId)?.Name ?? "No SLA")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="sla-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="sla" /><select name="value"><option value="">No SLA</option>@foreach (var sla in Model.Slas) { <option value="@sla.Id" selected="@(sla.Id == Model.Ticket.SlaId)">@sla.Name (@sla.Duration @sla.DurationUnit)</option> }</select><button class="icon-button save-icon" type="submit" title="Save SLA" aria-label="Save SLA">@Icons.Check</button></form></div>
            <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">DUE DATE <help-tip key="ticket.due-date" /></p><button id="dueDate-edit" class="icon-button edit-icon" type="button" title="Edit due date" data-edit-field="dueDate">@Icons.Edit</button></div><strong class="field-value" id="dueDate-value">@(Model.Ticket.DueDate?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "No due date")@(Model.Ticket.DueDateOverridden ? " · Override" : "")</strong>@if (Model.DueState != DueState.None) { <span class="badge due-flag @(Model.DueState == DueState.Overdue ? "badge-warning" : "")" title="@(Model.DueState == DueState.Paused ? $"{Model.Ticket.Status} stops the SLA clock. It starts again when the status changes, and an SLA due date moves on by the time paused." : "")">@Model.DueText</span> }<form method="post" asp-page-handler="Update" class="inline-control" id="dueDate-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="dueDate" /><input name="value" type="datetime-local" value="@(Model.Ticket.DueDate?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" /><button class="icon-button save-icon" type="submit" title="Save due date" aria-label="Save due date">@Icons.Check</button></form></div>
        </div>
        <div class="ticket-tabs no-print">
            <div class="ticket-tab-buttons" role="tablist">
                <button class="ticket-tab-button active" type="button" role="tab" aria-selected="true" aria-controls="comments-tab">Comments <span class="badge">@Model.Ticket.Comments.Count</span></button>
                <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="history-tab">History <span class="badge">@Model.Ticket.History.Count</span></button>
                <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="assets-tab">Assets <span class="badge">@Model.LinkedAssets.Count</span></button>
                <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="parts-tab">Parts <span class="badge">@Model.TicketParts.Count</span></button>
                @if (Model.CanSeeCosts) { <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="costs-tab">Costs <span class="badge">@Model.Costs.Count</span></button> }
                <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="attachments-tab">Attachments <span class="badge">@Model.Attachments.Count</span></button>
            </div>
            <div id="comments-tab" class="ticket-tab-panel active" role="tabpanel">
                @* The reply box sits above the conversation. Reply or Internal note is chosen first, and the rest - notify,
                   status, the button - opens out once there is something to send (wwwroot/js/pages/job.js); without
                   script everything simply shows. *@
                <form method="post" asp-page-handler="AddComment" class="composer" id="composer">
                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                    <fieldset class="composer-kind">
                        <legend class="visually-hidden">Comment type</legend>
                        <label><input type="radio" name="internalNote" value="false" checked /><span>Reply</span></label>
                        <label><input type="radio" name="internalNote" value="true" /><span>Internal note</span></label>
                        <help-tip key="ticket.reply-kind" />
                    </fieldset>
                    <label for="ticket-comment" class="visually-hidden">Comment</label>
                    <textarea id="ticket-comment" name="comment" rows="3" placeholder="Reply to @(Model.Requester?.Name ?? "the requester"), or record an update or next action…" data-note-placeholder="A note for the IT team only. It isn't shown to the requester or printed on the ticket."></textarea>
                    <div class="composer-options">
                        <label class="toggle-label" id="notify-requester-label"><input type="checkbox" name="notifyRequester" value="true" /> Notify the requester <help-tip key="ticket.notify" /></label>
                        <span class="composer-send">
                            <label for="comment-status">Status</label> <help-tip key="ticket.status" />
                            <select id="comment-status" name="status" data-current="@Model.Ticket.Status">
                                @if (!Model.Statuses.Contains(Model.Ticket.Status, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="" selected>@Model.Ticket.Status</option>
                                }
                                @foreach (var status in Model.Statuses)
                                {
                                    <option value="@status" selected="@string.Equals(status, Model.Ticket.Status, StringComparison.OrdinalIgnoreCase)">@status</option>
                                }
                            </select>
                            <button class="button button-primary" type="submit" id="comment-submit">Add reply</button>
                        </span>
                    </div>
                </form>
                @if (Model.Ticket.Comments.Count > 0)
                {
                    <div class="comment-list">
                        @foreach (var comment in Model.Ticket.Comments.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="comment @(comment.IsInternal ? "comment-internal" : "")"><p>@comment.Text</p><small>@if (comment.IsInternal) { <span class="badge">Internal note</span> } @if (comment.FromRequester) { <span class="badge badge-reply">From the portal</span> } <strong>@Actor.Label(comment.By)</strong> · @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>@if (Model.CanRemoveComment(comment))
                            {
                                <form method="post" asp-page-handler="RemoveComment" class="comment-remove" data-confirm="Remove this @(comment.IsInternal ? "internal note" : "comment")? It can't be put back - the history will only record that it was removed.">
                                    <input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="comment" value="@HelpdeskStore.CommentKey(comment.CreatedAt)" />
                                    <button class="link-button" type="submit">Remove</button>
                                </form>
                            }</article>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No comments have been added.</p>
                }
            </div>
            <div id="history-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                @if (Model.Ticket.History.Count > 0)
                {
                    <div class="history-list">
                        @foreach (var activity in Model.Ticket.History.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="history-entry"><strong>@activity.Action</strong><p>@activity.Details</p><small>@Actor.Label(activity.By) · @activity.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small></article>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No ticket changes have been recorded.</p>
                }
            </div>
            <div id="assets-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                @if (Model.LinkedAssets.Count > 0)
                {
                    <div class="linked-asset-list">
                        @foreach (var asset in Model.LinkedAssets)
                        {
                            <div class="linked-asset-row">
                                <a class="linked-asset-item" href="/Asset?id=@asset.Id"><strong>@asset.AssetTag</strong><span>@asset.Type · @asset.Model</span></a>
                                @* Unlinking one sends every other link, as the picker does - the handler sets the whole list. *@
                                <form method="post" asp-page-handler="UpdateAssets">
                                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                                    @foreach (var other in Model.Ticket.AssetIds.Where(x => x != asset.Id)) { <input type="hidden" name="assetIds" value="@other" /> }
                                    <button class="icon-button delete-icon" type="submit" title="Unlink @asset.AssetTag" aria-label="Unlink @asset.AssetTag">@Icons.Close</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No assets are linked to this ticket.</p>
                }
                <button class="button button-secondary" type="button" data-open-blade="asset-blade">@Icons.Plus Link assets</button>
            </div>
            <div id="parts-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                @if (Model.TicketParts.Count > 0)
                {
                    <div class="part-list">
                        @foreach (var (part, quantity) in Model.TicketParts)
                        {
                            <div class="part-row">
                                <div><strong>@part.Name</strong><span>@(string.IsNullOrWhiteSpace(part.Sku) ? "" : part.Sku + " · ")@quantity assigned · @part.QuantityOnHand left in stock</span></div>
                                <form method="post" asp-page-handler="UpdatePartQuantity" class="part-row-form">
                                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                                    <input type="hidden" name="partId" value="@part.Id" />
                                    <input name="quantity" type="number" min="0" step="1" value="@quantity" title="Set to 0 to remove this part" />
                                    <button class="button button-secondary" type="submit">Update</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No parts have been assigned to this ticket.</p>
                }
                <button class="button button-secondary" type="button" data-open-blade="part-blade">@Icons.Plus Use a part</button>
            </div>
            @if (Model.CanSeeCosts)
            {
                @* What the job cost, line by line. Only for roles with "See and add job costs" (HelpdeskStore.Costs). *@
                <div id="costs-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                    @if (Model.Costs.Count > 0)
                    {
                        <div class="table-wrap"><table>
                            <thead><tr><th>Date</th><th>What</th><th>Supplier</th><th>Budget code</th><th class="num">Net</th><th class="num">VAT</th><th class="num">Gross</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var cost in Model.Costs)
                                {
                                    <tr>
                                        <td>@cost.Date.ToString("d MMM yyyy")</td>
                                        <td>@cost.Description</td>
                                        <td>@(cost.SupplierId is { } supplierId ? Model.Suppliers.FirstOrDefault(x => x.Id == supplierId)?.Name ?? "" : "")</td>
                                        <td>@cost.BudgetCode</td>
                                        <td class="num">@HelpdeskStore.FormatMoney(cost.Net)</td>
                                        <td class="num">@HelpdeskStore.FormatMoney(cost.Vat)</td>
                                        <td class="num">@HelpdeskStore.FormatMoney(cost.Gross)</td>
                                        <td>@if (Model.CanEdit) { <form method="post" asp-page-handler="RemoveCost" data-confirm="Remove this cost line?"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="id" value="@cost.Id" /><button class="icon-button delete-icon" type="submit" title="Remove" aria-label="Remove @cost.Description">@Icons.Bin</button></form> }</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot><tr><th colspan="4">Total</th><th class="num">@HelpdeskStore.FormatMoney(Model.Costs.Sum(x => x.Net))</th><th class="num">@HelpdeskStore.FormatMoney(Model.Costs.Sum(x => x.Vat))</th><th class="num">@HelpdeskStore.FormatMoney(Model.Costs.Sum(x => x.Gross))</th><th></th></tr></tfoot>
                        </table></div>
                    }
                    else
                    {
                        <p class="muted">No costs recorded for this job.</p>
                    }
                    @if (Model.CanEdit)
                    {
                        <form method="post" asp-page-handler="AddCost" class="settings-form">
                            <input type="hidden" name="number" value="@Model.Ticket.Number" />
                            <div class="form-grid compact">
                                <label>What it was for<input name="description" maxlength="@HelpdeskStore.MaxCostDescriptionLength" required placeholder="e.g. Plumber call-out" /></label>
                                <label>Date<input name="date" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></label>
                                <label><span>Net (before VAT), £ <help-tip key="cost.net" /></span><input name="net" inputmode="decimal" required placeholder="120.00" /></label>
                                <label>VAT, £<input name="vat" inputmode="decimal" placeholder="24.00 - blank for none" /></label>
                                <label>Supplier<select name="supplierId"><option value="">None</option>@foreach (var supplier in Model.Suppliers) { <option value="@supplier.Id">@supplier.Name</option> }</select></label>
                                <label><span>Budget code <help-tip key="cost.budget-code" /></span><select name="budgetCode"><option value="">None</option>@foreach (var code in Model.BudgetCodes) { <option value="@code">@code</option> }</select></label>
                            </div>
                            <div><button class="button button-primary" type="submit">Add cost</button></div>
                        </form>
                    }
                </div>
            }
            <div id="attachments-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                @if (Model.Attachments.Count > 0)
                {
                    <div class="attachment-list">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <div class="attachment-row">
                                @if (HelpdeskStore.IsInlineImage(attachment)) { <a class="attachment-thumb" href="@Url.Page("/Job", "Attachment", new { number = Model.Ticket.Number, id = attachment.Id, inline = true })" target="_blank" rel="noopener"><img loading="lazy" alt="@attachment.FileName" src="@Url.Page("/Job", "Attachment", new { number = Model.Ticket.Number, id = attachment.Id, inline = true })" /></a> }
                                <div class="attachment-info"><a href="@Url.Page("/Job", "Attachment", new { number = Model.Ticket.Number, id = attachment.Id })"><strong>@attachment.FileName</strong></a><span class="muted">@HelpdeskStore.FormatSize(attachment.Size) · @attachment.UploadedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                    @if (attachment.FromRequester) { <span class="badge badge-reply">From the requester</span> }
                                    else
                                    {
                                        <form method="post" asp-page-handler="ShareAttachment" class="attachment-share">
                                            <input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="id" value="@attachment.Id" /><input type="hidden" name="visible" value="@(attachment.VisibleToRequester ? "false" : "true")" />
                                            @if (attachment.VisibleToRequester) { <span class="badge">Shown in the portal</span> }
                                            <button class="link-button" type="submit">@(attachment.VisibleToRequester ? "Stop sharing" : "Share with requester")</button>
                                        </form>
                                    }
                                </div>
                                <form method="post" asp-page-handler="RemoveAttachment" data-confirm="Remove this attachment from the ticket?">
                                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                                    <input type="hidden" name="id" value="@attachment.Id" />
                                    <button class="icon-button delete-icon" type="submit" title="Remove attachment" aria-label="Remove @attachment.FileName">@Icons.Bin</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No files are attached to this ticket.</p>
                }
                <button class="button button-secondary" type="button" data-open-blade="upload-blade">@Icons.Upload Attach files</button>
                <p class="muted attach-hint">Or drop files anywhere on this page to attach them.</p>
            </div>
        </div>
    </section>
    <aside class="panel detail-sidebar printable-job">
        <div class="detail-block"><p class="eyebrow field-name">Requester</p><h3>@if (Model.Requester is { } requester && Model.CanOpenRequester) { <a asp-page="/User" asp-route-id="@requester.Id">@requester.Name</a> } else { @(Model.Requester?.Name ?? "Unknown") }</h3><p>@Model.Requester?.Email</p>@if (Model.Requester is { } who && string.Join(" · ", new[] { who.Department, who.Location }.Where(x => !string.IsNullOrWhiteSpace(x))) is { Length: > 0 } where) { <p>@where</p> }</div>
        <p class="section-heading">Classification</p>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow field-name">Status</p><button id="status-edit" class="icon-button edit-icon" type="button" title="Edit status" data-edit-field="status">@Icons.Edit</button></div><strong class="field-value" id="status-value"><span class="status status-@Helpdesk.StatusTone(Model.Ticket.Status)">@Model.Ticket.Status</span></strong><form method="post" asp-page-handler="Update" class="inline-control" id="status-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="status" /><select name="value" data-describe="status-description">@foreach (var status in Model.Statuses) { <option value="@status" data-description="@Model.StatusDescriptions.GetValueOrDefault(status)" selected="@(status == Model.Ticket.Status)">@status</option> }</select><button class="icon-button save-icon" type="submit" title="Save status" aria-label="Save status">@Icons.Check</button><small id="status-description" class="status-description-hint">@(Model.StatusDescriptions.TryGetValue(Model.Ticket.Status, out var currentStatusDescription) ? currentStatusDescription : "")</small></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow field-name">Priority</p><button id="priority-edit" class="icon-button edit-icon" type="button" title="Edit priority" data-edit-field="priority">@Icons.Edit</button></div><strong class="field-value priority @Model.Ticket.Priority.ToLowerInvariant()" id="priority-value">@Model.Ticket.Priority</strong><form method="post" asp-page-handler="Update" class="inline-control" id="priority-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="priority" /><select name="value">@foreach (var priority in Model.Priorities) { <option value="@priority" selected="@(priority == Model.Ticket.Priority)">@priority</option> }</select><button class="icon-button save-icon" type="submit" title="Save priority" aria-label="Save priority">@Icons.Check</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow field-name">Type</p><button id="type-edit" class="icon-button edit-icon" type="button" title="Edit type" data-edit-field="type">@Icons.Edit</button></div><strong class="field-value" id="type-value">@Model.Ticket.Type</strong><form method="post" asp-page-handler="Update" class="inline-control" id="type-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="type" /><select name="value">@foreach (var type in TicketTypes.All) { <option value="@type" selected="@(type == Model.Ticket.Type)">@type</option> }</select><button class="icon-button save-icon" type="submit" title="Save type" aria-label="Save type">@Icons.Check</button></form></div>
        @if (Model.HasSeveralDesks && Model.Desk is { } ticketDesk) { <div class="detail-block"><p class="eyebrow field-name">Desk</p><strong>@ticketDesk.Name</strong><small class="muted field-note">To move it to another desk, give it one of that desk's categories.</small></div> }
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow field-name">Category</p><button id="category-edit" class="icon-button edit-icon" type="button" title="Edit category" data-edit-field="category">@Icons.Edit</button></div><strong class="field-value" id="category-value">@Model.Ticket.Category</strong><form method="post" asp-page-handler="Update" class="inline-control" id="category-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="category" /><select name="value">@if (Model.OtherDesks.Count > 0) { <optgroup label="@Model.Desk!.Name desk">@foreach (var category in Model.Categories) { <option value="@category" selected="@(category == Model.Ticket.Category)">@category</option> }</optgroup> foreach (var (otherDesk, otherCategories) in Model.OtherDesks) { <optgroup label="Move to the @otherDesk.Name desk">@foreach (var category in otherCategories) { <option value="@category">@category</option> }</optgroup> } } else { foreach (var category in Model.Categories) { <option value="@category" selected="@(category == Model.Ticket.Category)">@category</option> } }</select><button class="icon-button save-icon" type="submit" title="Save category" aria-label="Save category">@Icons.Check</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow field-name">Location</p><button id="location-edit" class="icon-button edit-icon" type="button" title="Edit location" data-edit-field="location">@Icons.Edit</button></div><strong class="field-value" id="location-value">@(Model.Ticket.Location ?? "Not specified")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="location-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="location" /><select name="value"><option value="">Not specified</option>@foreach (var location in Model.Locations) { <option value="@location" selected="@(location == Model.Ticket.Location)">@location</option> }</select><button class="icon-button save-icon" type="submit" title="Save location" aria-label="Save location">@Icons.Check</button></form></div>
        <div class="detail-block related-block">
            <p class="eyebrow field-name">Related tickets</p>
            @if (Model.Relations.Count == 0) { <p class="muted">No related tickets.</p> }
            @foreach (var relation in Model.Relations)
            {
                <div class="related-row">
                    <div><span class="muted">@relation.Label</span><br /><a asp-page="/Job" asp-route-number="@relation.Number"><strong>@relation.Reference</strong> @relation.Title</a> <span class="status status-@Helpdesk.StatusTone(relation.Status)">@relation.Status</span></div>
                    <form method="post" asp-page-handler="UnlinkTicket" class="no-print"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="other" value="@relation.Number" /><button class="icon-button delete-icon" type="submit" title="Remove link to @relation.Reference" aria-label="Remove link to @relation.Reference">@Icons.Bin</button></form>
                </div>
            }
            <div class="sidebar-actions no-print">
                <button class="button button-secondary" type="button" data-open-blade="related-blade">@Icons.Plus Link or follow up</button>
            </div>
        </div>
        @if (Model.CanSeeProjects)
        {
            <div class="detail-block related-block no-print" id="projects">
                <p class="eyebrow field-name">Purchasing projects</p>
                @if (Model.LinkedProjects.Count == 0) { <p class="muted">Not linked to a project.</p> }
                @foreach (var linked in Model.LinkedProjects)
                {
                    <div class="related-row">
                        <div>
                            @if (Model.CanOpenProjects) { <a asp-page="/Project" asp-route-number="@linked.Number"><strong>@linked.Reference</strong> @linked.Title</a> } else { <span><strong>@linked.Reference</strong> @linked.Title</span> }
                            <span class="status">@linked.Status@(linked.Outcome is { } outcome ? $" · {outcome}" : "")</span>
                        </div>
                        @if (Model.CanLinkProjects)
                        {
                            <form method="post" asp-page-handler="UnlinkProject"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="project" value="@linked.Number" /><button class="icon-button delete-icon" type="submit" title="Remove link to @linked.Reference" aria-label="Remove link to @linked.Reference">@Icons.Bin</button></form>
                        }
                    </div>
                }
                @if ((Model.CanLinkProjects && Model.LinkableProjects.Count > 0) || Model.CanStartProject)
                {
                    <div class="sidebar-actions">
                        @if (Model.CanLinkProjects && Model.LinkableProjects.Count > 0) { <button class="button button-secondary" type="button" data-open-blade="project-link-blade">@Icons.Plus Link a project</button> }
                        @if (Model.CanStartProject) { <button class="button button-secondary" type="button" data-open-blade="project-start-blade">Start a project</button> }
                    </div>
                }
            </div>
        }
        @if ((Model.CanTellStaff && Model.Ticket.Status != "Closed") || Model.StaffNotice is not null)
        {
            @* An outage notice on staff PCs through EduNotify (Settings → EduNotify). It comes down when the ticket closes. *@
            <div class="detail-block related-block no-print" id="staff-notice">
                <p class="eyebrow field-name">Staff notice</p>
                @if (Model.StaffNotice is { } notice)
                {
                    <p><span class="badge">Showing</span> <strong>@notice.Title</strong></p>
                    <p class="muted">To @notice.Recipients since @notice.SentAt.ToLocalTime().ToString("ddd d MMM, HH:mm"), by @notice.SentBy. Shown on @notice.Online of @notice.Targeted PCs at first. It is recalled when this ticket is closed.</p>
                }
                else
                {
                    <p class="muted">Tell staff about this problem with a notice on their PCs through EduNotify.</p>
                }
                @if (Model.CanTellStaff)
                {
                    <div class="sidebar-actions">
                        <button class="button button-secondary" type="button" data-open-blade="staff-notice-blade" disabled="@(Model.Ticket.Status == "Closed")">@(Model.StaffNotice is null ? "Tell staff" : "Update notice")</button>
                        @if (Model.StaffNotice is not null)
                        {
                            <form method="post" asp-page-handler="RecallStaffNotice" data-confirm="Take this notice off staff PCs now?"><input type="hidden" name="number" value="@Model.Ticket.Number" /><button class="button button-secondary" type="submit">Recall</button></form>
                        }
                    </div>
                }
            </div>
        }
        @if (Model.TicketAttributes.Count > 0)
        {
            @* The values, read like the fields above them; changing them opens a panel rather than sitting as a form. *@
            <div class="detail-block">
                <div class="field-label"><p class="eyebrow field-name">Additional details</p><button class="icon-button edit-icon no-print" type="button" title="Edit additional details" aria-label="Edit additional details" data-open-blade="attributes-blade">@Icons.Edit</button></div>
                <dl class="attribute-values">
                    @foreach (var field in Model.TicketAttributes)
                    {
                        var shown = Model.TicketAttributeValues.GetValueOrDefault(field.Id, "");
                        if (field.FieldType == "checkbox") { shown = shown.Equals("true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No"; }
                        <div><dt>@field.Name</dt><dd>@(string.IsNullOrWhiteSpace(shown) ? "—" : shown)</dd></div>
                    }
                </dl>
            </div>
        }
    </aside>
</div>

@* Slide-in panels for the Assets, Parts and Attachments tabs (actions.js). *@
<div id="asset-blade" class="blade-backdrop no-print">
    <div class="blade blade-wide" role="dialog" aria-modal="true" aria-labelledby="asset-blade-title">
        <div class="blade-head"><h2 id="asset-blade-title">Linked assets</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
        <form method="post" asp-page-handler="UpdateAssets" class="blade-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <label for="ticket-assets">Type an asset tag, model or serial to add it. Everything listed here is linked when you save.</label>
            <select id="ticket-assets" name="assetIds" multiple size="6" data-picker data-picker-placeholder="Type an asset tag, model or serial to add…">@foreach (var asset in Model.Assets) { <option value="@asset.Id" data-search="@asset.Make @asset.SerialNumber" selected="@(Model.Ticket.AssetIds.Contains(asset.Id))">@asset.AssetTag · @asset.Type @asset.Model</option> }</select>
            <div class="blade-actions"><button class="button button-primary" type="submit">Save linked assets</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
        </form>
    </div>
</div>
<div id="part-blade" class="blade-backdrop no-print">
    <div class="blade" role="dialog" aria-modal="true" aria-labelledby="part-blade-title">
        <div class="blade-head"><h2 id="part-blade-title">Use a part</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
        <form method="post" asp-page-handler="AssignPart" class="blade-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <p class="muted">The quantity comes out of stock straight away.</p>
            <label>Part<select name="partId" required><option value="">Select a part…</option>@foreach (var part in Model.Parts) { <option value="@part.Id">@part.Name (@part.QuantityOnHand in stock)</option> }</select></label>
            <label>Quantity<input name="quantity" type="number" min="1" step="1" value="1" required /></label>
            <div class="blade-actions"><button class="button button-primary" type="submit">Use part</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
        </form>
    </div>
</div>
<div id="upload-blade" class="blade-backdrop no-print">
    <div class="blade" role="dialog" aria-modal="true" aria-labelledby="upload-blade-title">
        <div class="blade-head"><h2 id="upload-blade-title">Attach files</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
        <form method="post" enctype="multipart/form-data" asp-page-handler="UploadAttachments" class="blade-form" id="attachment-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <label class="file-drop">@Icons.Upload <span><strong>Choose files</strong> or drop them here</span><input id="ticket-files" type="file" name="files" multiple required accept="@HelpdeskStore.AttachmentAcceptAttribute" /></label>
            <p class="muted">Up to @HelpdeskStore.MaxAttachmentsPerUpload files at a time, each up to @(HelpdeskStore.MaxAttachmentBytes / (1024 * 1024)) MB. Pictures, PDFs, Office documents, text and email files.</p>
            <label class="toggle-label"><input type="checkbox" name="shareWithRequester" value="true" /> Share with the requester (they'll see it in the staff portal) <help-tip key="ticket.share-file" /></label>
            <div class="blade-actions"><button class="button button-primary" type="submit">@Icons.Upload Upload</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
        </form>
    </div>
</div>
@* Slide-in panels for the sidebar: related tickets, purchasing projects and the additional details. *@
<div id="related-blade" class="blade-backdrop no-print">
    <div class="blade" role="dialog" aria-modal="true" aria-labelledby="related-blade-title">
        <div class="blade-head"><h2 id="related-blade-title">Related tickets</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
        <form method="post" asp-page-handler="LinkRelated" class="blade-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <label>Link an existing ticket<input name="other" placeholder="Ticket number, e.g. @Model.Reference" required autocomplete="off" /></label>
            <div><button class="button button-primary" type="submit">Link ticket</button></div>
        </form>
        <form method="post" asp-page-handler="CreateFollowUp" class="blade-form related-follow-up" data-confirm="Create a follow-up ticket for @Model.Reference?">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <p class="muted">Or start a follow-up: a new ticket with the same requester, assets, category and priority, linked to this one.</p>
            <div><button class="button button-secondary" type="submit">Create follow-up ticket</button></div>
        </form>
    </div>
</div>
@if (Model.CanSeeProjects && Model.CanLinkProjects && Model.LinkableProjects.Count > 0)
{
    <div id="project-link-blade" class="blade-backdrop no-print">
        <div class="blade" role="dialog" aria-modal="true" aria-labelledby="project-link-blade-title">
            <div class="blade-head"><h2 id="project-link-blade-title">Link to a project</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
            <form method="post" asp-page-handler="LinkProject" class="blade-form">
                <input type="hidden" name="number" value="@Model.Ticket.Number" />
                <label>Open project<select name="project" required><option value="">Choose a project</option>@foreach (var open in Model.LinkableProjects) { <option value="@open.Number">@open.Reference · @open.Title</option> }</select></label>
                <div class="blade-actions"><button class="button button-primary" type="submit">Link</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
            </form>
        </div>
    </div>
}
@if (Model.CanSeeProjects && Model.CanStartProject)
{
    @* Raised for this ticket's requester and left for the project lead to assign, like one raised from the portal. *@
    <div id="project-start-blade" class="blade-backdrop no-print">
        <div class="blade blade-wide" role="dialog" aria-modal="true" aria-labelledby="project-start-blade-title">
            <div class="blade-head"><h2 id="project-start-blade-title">Start a purchasing project</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
            <form method="post" asp-page-handler="StartProject" class="blade-form">
                <input type="hidden" name="number" value="@Model.Ticket.Number" />
                <p class="muted">Raised for @(Model.Requester?.Name ?? "the requester"), who will see it in the staff portal. It waits for the project lead to confirm the priority and assign it.</p>
                <label>Title<input name="title" value="@Model.Ticket.Title" maxlength="@HelpdeskStore.MaxProjectTitleLength" required /></label>
                <label>Proposal needed by<input name="dueDate" type="date" value="@Model.DefaultProjectDueDate.ToString("yyyy-MM-dd")" min="@DateTime.Now.ToString("yyyy-MM-dd")" required /></label>
                <label>Suggested priority<select name="priority">@foreach (var level in ProjectPriorities.All) { <option value="@level" selected="@(level == ProjectPriorities.Default)">@ProjectPriorities.Label(level) — @ProjectPriorities.Describe(level)</option> }</select></label>
                <label>Items wanted<textarea name="itemsWanted" rows="5" maxlength="@HelpdeskStore.MaxProjectTextLength" required>@Model.Ticket.Description</textarea></label>
                <div class="blade-actions"><button class="button button-primary" type="submit">Start project</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
            </form>
        </div>
    </div>
}
@if (Model.CanTellStaff && Model.Ticket.Status != "Closed")
{
    var current = Model.StaffNotice;
    var sendable = Model.NoticeCatalogue?.Sendable ?? [];
    // An update starts from what is showing; a first notice from an outage template if the key has one.
    var chosenTemplate = sendable.FirstOrDefault(x => x.Id == current?.TemplateId)
        ?? sendable.FirstOrDefault(x => x.Name.Contains("outage", StringComparison.OrdinalIgnoreCase)) ?? sendable.FirstOrDefault();
    @* Telling staff through EduNotify. Which fields show follows the template chosen (job.js): a static template goes out
       as saved, a quick message takes a message, an editable one a title and a message. *@
    <div id="staff-notice-blade" class="blade-backdrop no-print">
        <div class="blade blade-wide" role="dialog" aria-modal="true" aria-labelledby="staff-notice-blade-title">
            <div class="blade-head"><h2 id="staff-notice-blade-title">@(current is null ? "Tell staff" : "Update the notice")</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
            @if (Model.NoticeCatalogue is null)
            {
                <p class="muted">EduNotify hasn't said yet which templates the helpdesk may send. Try again in a moment, or use <strong>Test the connection</strong> in Settings → EduNotify.</p>
            }
            else if (sendable.Count == 0)
            {
                <p class="muted">EduNotify's key isn't allowed any templates the helpdesk can send. In EduNotify, give the key an outage template under Settings → Integrations.</p>
            }
            else
            {
                <form method="post" asp-page-handler="TellStaff" class="blade-form" id="staff-notice-form">
                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                    <p class="muted">@(current is null ? "A notice pops up on the PCs you choose. It is taken down when this ticket is closed, or when you recall it." : "Sending replaces the notice showing now.") Don't put pupils' or staff names in it: everyone at those PCs can read it.</p>
                    <label>Template<select name="templateId" id="notice-template" required>@foreach (var template in sendable) { <option value="@template.Id" selected="@(template == chosenTemplate)" data-can-title="@(template.CanChangeTitle ? "true" : "false")" data-can-body="@(template.CanChangeBody ? "true" : "false")" data-title="@template.Title" data-body="@template.Body">@template.Name</option> }</select></label>
                    <p class="muted" id="notice-static-hint" hidden>This template goes out exactly as it is saved in EduNotify.</p>
                    <label id="notice-title-label">Title<input name="title" id="notice-title" maxlength="@EduNotify.MaxTitle" value="@(current?.Title)" placeholder="@(chosenTemplate?.Title)" /></label>
                    <label id="notice-body-label">Message<textarea name="body" id="notice-body" rows="5" maxlength="@EduNotify.MaxBody" placeholder="@(chosenTemplate?.Body)">@(current?.Body)</textarea><small class="muted">Left blank, the template's own is used. **bold**, *italic* and - lists work.</small></label>
                    <fieldset class="notice-recipients">
                        <legend>Who to tell</legend>
                        <label class="toggle-label"><input type="checkbox" name="everyone" value="true" id="notice-everyone" checked="@(current?.Everyone ?? false)" /> Everyone (every PC running EduNotify)</label>
                        <div class="checkbox-grid" id="notice-groups">
                            @foreach (var group in Model.NoticeCatalogue.Groups)
                            {
                                <label class="toggle-label"><input type="checkbox" name="groups" value="@group.Name" checked="@(current?.Groups.Contains(group.Name, StringComparer.OrdinalIgnoreCase) ?? false)" /> @group.Name</label>
                            }
                            @if (Model.NoticeCatalogue.Groups.Count == 0) { <p class="muted">EduNotify has no groups of PCs yet, so a notice can only go to everyone.</p> }
                        </div>
                    </fieldset>
                    <div class="blade-actions"><button class="button button-primary" type="submit">@(current is null ? "Tell staff" : "Update notice")</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
                </form>
            }
        </div>
    </div>
}
@if (Model.TicketAttributes.Count > 0)
{
    <div id="attributes-blade" class="blade-backdrop no-print">
        <div class="blade" role="dialog" aria-modal="true" aria-labelledby="attributes-blade-title">
            <div class="blade-head"><h2 id="attributes-blade-title">Additional details</h2><button class="blade-close" type="button" data-close-blade aria-label="Close">@Icons.Close</button></div>
            <form method="post" asp-page-handler="UpdateAttributes" class="blade-form">
                <input type="hidden" name="number" value="@Model.Ticket.Number" />
                @foreach (var field in Model.TicketAttributes)
                {
                    var customValue = Model.TicketAttributeValues.GetValueOrDefault(field.Id, "");
                    if (field.FieldType == "dropdown") { <label>@field.Name<select name="customAttributes[@field.Id]"><option value="">Select an option</option>@foreach (var choice in HelpdeskStore.GetChoices(field)) { <option value="@choice" selected="@(choice == customValue)">@choice</option> }</select></label> }
                    else if (field.FieldType == "checkbox") { <label class="toggle-label"><input type="checkbox" name="customAttributes[@field.Id]" value="true" checked="@(customValue.Equals("true", StringComparison.OrdinalIgnoreCase))" /> @field.Name</label> }
                    else if (field.FieldType == "multi-line") { <label>@field.Name<textarea name="customAttributes[@field.Id]" rows="3">@customValue</textarea></label> }
                    else { <label>@field.Name<input name="customAttributes[@field.Id]" value="@customValue" /></label> }
                }
                <div class="blade-actions"><button class="button button-primary" type="submit">Save</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
            </form>
        </div>
    </div>
}

@* Shown while files are dragged over the page; dropping them uploads them to this ticket, not shared (job.js). *@
<div class="drop-overlay no-print" id="drop-overlay" hidden><div>@Icons.Upload Drop to attach to @Model.Reference</div></div>

@section Scripts {
<script src="~/js/pages/job.js" asp-append-version="true"></script>
}
