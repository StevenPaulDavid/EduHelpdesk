@page
@using EduHelpdesk.Services
@using EduHelpdesk.Models
@model JobModel
@inject HelpdeskStore Helpdesk
@{
    ViewData["Title"] = $"Job #{Model.Ticket!.Number}";
}

@* The header keeps only the everyday actions as buttons. The three print options share one menu, and merge and delete
   sit under "More" - they are rare, need Tickets: Delete, and a destructive button one slip away from "Mark as closed"
   was never a good neighbour. Back is navigation rather than an action, so it is a plain link above the title. *@
<a class="back-link no-print" href="@Model.BackUrl">← Back to tickets</a>
<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / TICKET DETAIL</p><h1>#@Model.Ticket.Number</h1><p class="hero-copy">@Model.Ticket.Title</p></div>
    <div class="heading-actions no-print">
        @if (Model.CanAssignToMe)
        {
            <form method="post" asp-page-handler="AssignToMe"><input type="hidden" name="number" value="@Model.Ticket.Number" /><button class="button button-secondary" type="submit">Assign to me</button></form>
        }
        @if (Model.CanEdit && Model.Ticket.Status != "Closed")
        {
            if (Model.RequiresCloseMessage) { <button class="button button-primary" type="button" data-open-blade="close-dialog-backdrop">Mark as closed</button> }
            else { <form method="post" asp-page-handler="Close"><input type="hidden" name="number" value="@Model.Ticket.Number" /><button class="button button-primary" type="submit">Mark as closed</button></form> }
        }
        <details class="nav-menu action-menu">
            <summary class="button button-secondary">🖨 Print<span class="chev" aria-hidden="true">▾</span></summary>
            <div class="nav-panel nav-panel-right">
                <button type="button" data-action="print">Ticket</button>
                <button type="button" data-open-window="@Url.Page("/PrintLabel", new { number = Model.Ticket.Number })">Label</button>
                <button type="button" data-open-window="@Url.Page("/PrintJobSheet", new { number = Model.Ticket.Number })">Job sheet</button>
            </div>
        </details>
        @if (Model.CanDelete)
        {
            <details class="nav-menu action-menu">
                <summary class="button button-secondary" aria-label="More actions">More<span class="chev" aria-hidden="true">▾</span></summary>
                <div class="nav-panel nav-panel-right">
                    <button type="button" data-open-blade="merge-dialog-backdrop">Merge into another ticket…</button>
                    <button type="button" class="menu-danger" data-open-blade="delete-dialog-backdrop">Delete ticket…</button>
                </div>
            </details>
        }
    </div>
</div>
@if (Model.Ticket.Status != "Closed" && Model.RequiresCloseMessage)
{
    <div id="close-dialog-backdrop" class="blade-backdrop no-print">
        <div class="blade">
            <button class="blade-close" type="button" data-close-blade>×</button>
            <h2>Close ticket #@Model.Ticket.Number</h2>
            <p class="muted">This ticket is <strong>@Model.Ticket.Priority</strong> priority in the <strong>@Model.Ticket.Category</strong> category, so a closing message is required before it can be closed.</p>
            <form method="post" asp-page-handler="Close" class="blade-form">
                <input type="hidden" name="number" value="@Model.Ticket.Number" />
                <label>Closing message<textarea name="closingMessage" rows="5" required placeholder="Explain how this was resolved…"></textarea></label>
                <div class="blade-actions"><button class="button button-primary" type="submit">Close ticket</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
            </form>
        </div>
    </div>
}
<div id="merge-dialog-backdrop" class="blade-backdrop no-print">
    <div class="blade">
        <button class="blade-close" type="button" data-close-blade>×</button>
        <h2>Merge ticket #@Model.Ticket.Number</h2>
        <p class="muted">Choose the ticket to merge this one into. Comments, linked assets, and assigned parts will be copied across, and this ticket will be closed.</p>
        <form method="post" asp-page-handler="Merge" class="blade-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <label>Merge into<select name="targetNumber" required><option value="">Select a ticket…</option>@foreach (var candidate in Model.MergeCandidates) { <option value="@candidate.Number">#@candidate.Number - @candidate.Title</option> }</select></label>
            <div class="blade-actions"><button class="button button-primary" type="submit">Merge ticket</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
        </form>
    </div>
</div>
<div id="delete-dialog-backdrop" class="blade-backdrop no-print">
    <div class="blade">
        <button class="blade-close" type="button" data-close-blade>×</button>
        <h2>Delete ticket #@Model.Ticket.Number</h2>
        <p class="muted">This permanently removes the ticket, its comments, and history. Any parts assigned to it will be returned to stock. This can't be undone.</p>
        <form method="post" asp-page-handler="Delete" class="blade-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <div class="blade-actions"><button class="button button-danger" type="submit">Delete permanently</button><button class="button button-secondary" type="button" data-close-blade>Cancel</button></div>
        </form>
    </div>
</div>
<div class="print-brand">@if (Helpdesk.LogoVersion is { } logoVersion) { <img class="print-logo" src="@Url.Content("~/branding/logo")?v=@logoVersion" alt="" /> } else { <span class="brand-mark">EH</span> }<strong>@Helpdesk.Branding.BrandName</strong><span>Job sheet</span></div>
@if (!string.IsNullOrWhiteSpace(Model.TemplateHtml))
{
    <div class="uploaded-print-template">@Html.Raw(Model.TemplateHtml)</div>
}
else
{
    <div class="print-only print-worksheet">
        <div class="print-header"><span class="print-job-number">#@Model.Ticket.Number</span><span class="status">@Model.Ticket.Status</span></div>
        <h1 class="print-title">@Model.Ticket.Title</h1>
        <table class="print-facts">
            <tr><th>Priority</th><td>@Model.Ticket.Priority</td><th>Type</th><td>@Model.Ticket.Type</td></tr>
            <tr><th>Category</th><td>@Model.Ticket.Category</td><th>Team</th><td>@(Model.Ticket.TeamName ?? "No team")</td></tr>
            <tr><th>Location</th><td>@(Model.Ticket.Location ?? "Not specified")</td><th>SLA</th><td>@(Model.Slas.FirstOrDefault(x => x.Id == Model.Ticket.SlaId)?.Name ?? "No SLA")</td></tr>
            <tr><th>Technician</th><td colspan="3">@(Model.Technician?.Name ?? "Unassigned")</td></tr>
            <tr><th>Created</th><td>@Model.Ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><th>Due</th><td>@(Model.Ticket.DueDate?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "No due date")</td></tr>
        </table>
        <div class="print-section"><h2>Description</h2><p>@Model.Ticket.Description</p></div>
        <div class="print-section"><h2>Requester</h2><p>@(Model.Requester?.Name ?? "Unknown")<br />@Model.Requester?.Email<br />@Model.Requester?.Department · @Model.Requester?.Location</p></div>
        @if (Model.LinkedAssets.Count > 0)
        {
            <div class="print-section">
                <h2>Assets</h2>
                <table class="print-assets">
                    <tr><th>Tag</th><th>Type</th><th>Model</th><th>Serial</th></tr>
                    @foreach (var asset in Model.LinkedAssets) { <tr><td>@asset.AssetTag</td><td>@asset.Type</td><td>@asset.Model</td><td>@asset.SerialNumber</td></tr> }
                </table>
            </div>
        }
        @if (Model.Relations.Count > 0)
        {
            <div class="print-section">
                <h2>Related tickets</h2>
                @foreach (var relation in Model.Relations) { <p>@relation.Label: #@relation.Number @relation.Title (@relation.Status)</p> }
            </div>
        }
        @{ var printedAttributes = Model.TicketAttributes.Where(x => !string.IsNullOrWhiteSpace(Model.TicketAttributeValues.GetValueOrDefault(x.Id, ""))).ToList(); }
        @if (printedAttributes.Count > 0)
        {
            <div class="print-section">
                <h2>Additional details</h2>
                @foreach (var field in printedAttributes) { <p><strong>@field.Name:</strong> @Model.TicketAttributeValues[field.Id]</p> }
            </div>
        }
        <div class="print-section">
            <h2>Comments</h2>
            @{ var printedComments = Model.Ticket.Comments.Where(x => !x.IsInternal).OrderBy(x => x.CreatedAt).ToList(); }
            @if (printedComments.Count == 0) { <p class="muted">No comments.</p> }
            @foreach (var comment in printedComments) { <p><strong>@comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong> — @comment.Text</p> }
        </div>
        <div class="print-signoff">
            <div class="signature-block"><span class="signature-line"></span><small>Technician signature &amp; date</small></div>
            <div class="signature-block"><span class="signature-line"></span><small>Requester signature &amp; date</small></div>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<div class="job-detail-grid">
    <section class="panel job-main printable-job">
        <div class="panel-heading"><div><p class="eyebrow">DESCRIPTION</p><h2>@Model.Ticket.Title</h2></div><button class="button button-secondary no-print" type="button" id="ticket-content-edit" data-edit-content>Edit details</button></div>
        <div id="ticket-content-display">
            <p class="job-description">@Model.Ticket.Description</p>
        </div>
        <form method="post" asp-page-handler="UpdateContent" class="ticket-content-form no-print" id="ticket-content-form">
            <input type="hidden" name="number" value="@Model.Ticket.Number" />
            <label>Title<input name="title" value="@Model.Ticket.Title" required /></label>
            <label>Description<textarea name="description" rows="7">@Model.Ticket.Description</textarea></label>
            <div class="heading-actions"><button class="button button-primary" type="submit">Save details</button><button class="button button-secondary" type="button" data-cancel-content>Cancel</button></div>
        </form>
        <div class="job-meta"><div><span>Created</span><strong>@Model.Ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div><div><span>Last modified</span><strong>@Model.Ticket.LastModifiedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div><div><span>Closed</span><strong>@(Model.Ticket.ClosedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Not closed")</strong></div></div>
        <p class="section-heading">Assignment &amp; scheduling</p>
        <div class="job-detail-fields">
            <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">ASSIGNED TECHNICIAN</p><button id="technician-edit" class="icon-button edit-icon" type="button" title="Edit technician" data-edit-field="technician">✎</button></div><strong class="field-value" id="technician-value">@(Model.Technician?.Name ?? Model.Ticket.TeamName ?? "Unassigned")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="technician-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="technician" /><select name="value"><option value="">Unassigned</option>@foreach (var tech in Model.TeamTechnicians) { <option value="@tech.Id" selected="@(tech.Id == Model.Ticket.TechnicianId)">@tech.Name · @tech.Team</option> }</select><button class="icon-button save-icon" type="submit" title="Save technician" aria-label="Save technician">✓</button></form></div>
            <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">ASSIGNED TEAM</p><button id="team-edit" class="icon-button edit-icon" type="button" title="Edit team" data-edit-field="team">✎</button></div><strong class="field-value" id="team-value">@(Model.Ticket.TeamName ?? "No team")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="team-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="team" /><select name="value"><option value="">No team</option>@foreach (var team in Model.TechnicianTeams) { <option value="@team" selected="@(team == Model.Ticket.TeamName)">@team</option> }</select><button class="icon-button save-icon" type="submit" title="Save team" aria-label="Save team">✓</button></form></div>
            <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">SLA</p><button id="sla-edit" class="icon-button edit-icon" type="button" title="Edit SLA" data-edit-field="sla">✎</button></div><strong class="field-value" id="sla-value">@(Model.Slas.FirstOrDefault(x => x.Id == Model.Ticket.SlaId)?.Name ?? "No SLA")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="sla-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="sla" /><select name="value"><option value="">No SLA</option>@foreach (var sla in Model.Slas) { <option value="@sla.Id" selected="@(sla.Id == Model.Ticket.SlaId)">@sla.Name (@sla.Duration @sla.DurationUnit)</option> }</select><button class="icon-button save-icon" type="submit" title="Save SLA" aria-label="Save SLA">✓</button></form></div>
            <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">DUE DATE</p><button id="dueDate-edit" class="icon-button edit-icon" type="button" title="Edit due date" data-edit-field="dueDate">✎</button></div><strong class="field-value" id="dueDate-value">@(Model.Ticket.DueDate?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "No due date")@(Model.Ticket.DueDateOverridden ? " · Override" : "")</strong>@if (Model.DueState != DueState.None) { <span class="badge due-flag @(Model.DueState == DueState.Overdue ? "badge-warning" : "")" title="@(Model.DueState == DueState.Paused ? $"{Model.Ticket.Status} stops the SLA clock. It starts again when the status changes, and an SLA due date moves on by the time paused." : "")">@Model.DueText</span> }<form method="post" asp-page-handler="Update" class="inline-control" id="dueDate-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="dueDate" /><input name="value" type="datetime-local" value="@(Model.Ticket.DueDate?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" /><button class="icon-button save-icon" type="submit" title="Save due date" aria-label="Save due date">✓</button></form></div>
        </div>
        <div class="ticket-tabs no-print">
            <div class="ticket-tab-buttons" role="tablist">
                <button class="ticket-tab-button active" type="button" role="tab" aria-selected="true" aria-controls="comments-tab">Comments <span class="badge">@Model.Ticket.Comments.Count</span></button>
                <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="history-tab">History <span class="badge">@Model.Ticket.History.Count</span></button>
                <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="assets-tab">Assets <span class="badge">@Model.LinkedAssets.Count</span></button>
                <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="parts-tab">Parts <span class="badge">@Model.TicketParts.Count</span></button>
                <button class="ticket-tab-button" type="button" role="tab" aria-selected="false" aria-controls="attachments-tab">Attachments <span class="badge">@Model.Attachments.Count</span></button>
            </div>
            <div id="comments-tab" class="ticket-tab-panel active" role="tabpanel">
                @if (Model.Ticket.Comments.Count > 0)
                {
                    <div class="comment-list">
                        @foreach (var comment in Model.Ticket.Comments.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="comment @(comment.IsInternal ? "comment-internal" : "")"><p>@comment.Text</p><small>@if (comment.IsInternal) { <span class="badge">Internal note</span> } @if (comment.FromRequester) { <span class="badge badge-reply">From the portal</span> } <strong>@Actor.Label(comment.By)</strong> · @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small></article>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No comments have been added.</p>
                }
                <form method="post" asp-page-handler="AddComment" class="comment-form">
                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                    <label for="ticket-comment">Add a comment</label>
                    <textarea id="ticket-comment" name="comment" rows="3" placeholder="Add an update, finding, or next action…"></textarea>
                    <label class="toggle-label"><input type="checkbox" name="internalNote" value="true" /> Internal note (technicians only, left off the printed ticket)</label>
                    <label for="comment-status">Status</label>
                    <select id="comment-status" name="status" data-current="@Model.Ticket.Status">
                        @if (!Model.Statuses.Contains(Model.Ticket.Status, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="" selected>@Model.Ticket.Status</option>
                        }
                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status" selected="@string.Equals(status, Model.Ticket.Status, StringComparison.OrdinalIgnoreCase)">@status</option>
                        }
                    </select>
                    <button class="button button-primary" type="submit" id="comment-submit">Add comment</button>
                </form>
            </div>
            <div id="history-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                @if (Model.Ticket.History.Count > 0)
                {
                    <div class="history-list">
                        @foreach (var activity in Model.Ticket.History.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="history-entry"><strong>@activity.Action</strong><p>@activity.Details</p><small>@Actor.Label(activity.By) · @activity.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small></article>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No ticket changes have been recorded.</p>
                }
            </div>
            <div id="assets-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                @if (Model.LinkedAssets.Count > 0)
                {
                    <div class="linked-asset-list">
                        @foreach (var asset in Model.LinkedAssets)
                        {
                            <a class="linked-asset-item" href="/Asset?id=@asset.Id"><strong>@asset.AssetTag</strong><span>@asset.Type · @asset.Model</span></a>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No assets are linked to this ticket.</p>
                }
                <form method="post" asp-page-handler="UpdateAssets" class="asset-edit-form">
                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                    <label for="ticket-assets">Linked assets</label>
                    <select id="ticket-assets" name="assetIds" multiple size="6" data-picker data-picker-placeholder="Type an asset tag, model or serial to add…">@foreach (var asset in Model.Assets) { <option value="@asset.Id" data-search="@asset.Make @asset.SerialNumber" selected="@(Model.Ticket.AssetIds.Contains(asset.Id))">@asset.AssetTag · @asset.Type @asset.Model</option> }</select>
                    <button class="button button-primary" type="submit">Save linked assets</button>
                </form>
            </div>
            <div id="parts-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                @if (Model.TicketParts.Count > 0)
                {
                    <div class="part-list">
                        @foreach (var (part, quantity) in Model.TicketParts)
                        {
                            <div class="part-row">
                                <div><strong>@part.Name</strong><span>@(string.IsNullOrWhiteSpace(part.Sku) ? "" : part.Sku + " · ")@quantity assigned · @part.QuantityOnHand left in stock</span></div>
                                <form method="post" asp-page-handler="UpdatePartQuantity" class="part-row-form">
                                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                                    <input type="hidden" name="partId" value="@part.Id" />
                                    <input name="quantity" type="number" min="0" step="1" value="@quantity" title="Set to 0 to remove this part" />
                                    <button class="button button-secondary" type="submit">Update</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No parts have been assigned to this ticket.</p>
                }
                <form method="post" asp-page-handler="AssignPart" class="asset-edit-form">
                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                    <label for="ticket-part-select">Assign a part</label>
                    <select id="ticket-part-select" name="partId"><option value="">Select a part…</option>@foreach (var part in Model.Parts) { <option value="@part.Id">@part.Name (@part.QuantityOnHand in stock)</option> }</select>
                    <label for="ticket-part-quantity">Quantity</label>
                    <input id="ticket-part-quantity" name="quantity" type="number" min="1" step="1" value="1" />
                    <button class="button button-primary" type="submit">Assign part</button>
                </form>
            </div>
            <div id="attachments-tab" class="ticket-tab-panel" role="tabpanel" hidden>
                @if (Model.Attachments.Count > 0)
                {
                    <div class="attachment-list">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <div class="attachment-row">
                                @if (HelpdeskStore.IsInlineImage(attachment)) { <a class="attachment-thumb" href="@Url.Page("/Job", "Attachment", new { number = Model.Ticket.Number, id = attachment.Id, inline = true })" target="_blank" rel="noopener"><img loading="lazy" alt="@attachment.FileName" src="@Url.Page("/Job", "Attachment", new { number = Model.Ticket.Number, id = attachment.Id, inline = true })" /></a> }
                                <div class="attachment-info"><a href="@Url.Page("/Job", "Attachment", new { number = Model.Ticket.Number, id = attachment.Id })"><strong>@attachment.FileName</strong></a><span class="muted">@HelpdeskStore.FormatSize(attachment.Size) · @attachment.UploadedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                    @if (attachment.FromRequester) { <span class="badge badge-reply">From the requester</span> }
                                    else
                                    {
                                        <form method="post" asp-page-handler="ShareAttachment" class="attachment-share">
                                            <input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="id" value="@attachment.Id" /><input type="hidden" name="visible" value="@(attachment.VisibleToRequester ? "false" : "true")" />
                                            @if (attachment.VisibleToRequester) { <span class="badge">Shown in the portal</span> }
                                            <button class="link-button" type="submit">@(attachment.VisibleToRequester ? "Stop sharing" : "Share with requester")</button>
                                        </form>
                                    }
                                </div>
                                <form method="post" asp-page-handler="RemoveAttachment" data-confirm="Remove this attachment from the ticket?">
                                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                                    <input type="hidden" name="id" value="@attachment.Id" />
                                    <button class="icon-button delete-icon" type="submit" title="Remove attachment" aria-label="Remove @attachment.FileName">♜</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">No files are attached to this ticket.</p>
                }
                <form method="post" enctype="multipart/form-data" asp-page-handler="UploadAttachments" class="asset-edit-form" id="attachment-form">
                    <input type="hidden" name="number" value="@Model.Ticket.Number" />
                    <label for="ticket-files">Attach files</label>
                    <input id="ticket-files" type="file" name="files" multiple accept="@HelpdeskStore.AttachmentAcceptAttribute" />
                    <small class="muted">Up to @HelpdeskStore.MaxAttachmentsPerUpload files at a time, each up to @(HelpdeskStore.MaxAttachmentBytes / (1024 * 1024)) MB. Pictures, PDFs, Office documents, text and email files.</small>
                    <label class="toggle-label"><input type="checkbox" name="shareWithRequester" value="true" /> Share with the requester (they'll see it in the staff portal)</label>
                    <button class="button button-primary" type="submit">Upload</button>
                </form>
            </div>
        </div>
    </section>
    <aside class="panel detail-sidebar printable-job">
        <div class="detail-block"><p class="eyebrow">REQUESTER</p><h3>@(Model.Requester?.Name ?? "Unknown")</h3><p>@Model.Requester?.Email</p><p>@Model.Requester?.Department · @Model.Requester?.Location</p></div>
        <p class="section-heading">Classification</p>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">STATUS</p><button id="status-edit" class="icon-button edit-icon" type="button" title="Edit status" data-edit-field="status">✎</button></div><strong class="field-value" id="status-value"><span class="status status-@Helpdesk.StatusTone(Model.Ticket.Status)">@Model.Ticket.Status</span></strong><form method="post" asp-page-handler="Update" class="inline-control" id="status-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="status" /><select name="value" data-describe="status-description">@foreach (var status in Model.Statuses) { <option value="@status" data-description="@Model.StatusDescriptions.GetValueOrDefault(status)" selected="@(status == Model.Ticket.Status)">@status</option> }</select><button class="icon-button save-icon" type="submit" title="Save status" aria-label="Save status">✓</button><small id="status-description" class="status-description-hint">@(Model.StatusDescriptions.TryGetValue(Model.Ticket.Status, out var currentStatusDescription) ? currentStatusDescription : "")</small></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">PRIORITY</p><button id="priority-edit" class="icon-button edit-icon" type="button" title="Edit priority" data-edit-field="priority">✎</button></div><strong class="field-value priority @Model.Ticket.Priority.ToLowerInvariant()" id="priority-value">@Model.Ticket.Priority</strong><form method="post" asp-page-handler="Update" class="inline-control" id="priority-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="priority" /><select name="value">@foreach (var priority in Model.Priorities) { <option value="@priority" selected="@(priority == Model.Ticket.Priority)">@priority</option> }</select><button class="icon-button save-icon" type="submit" title="Save priority" aria-label="Save priority">✓</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">TYPE</p><button id="type-edit" class="icon-button edit-icon" type="button" title="Edit type" data-edit-field="type">✎</button></div><strong class="field-value" id="type-value">@Model.Ticket.Type</strong><form method="post" asp-page-handler="Update" class="inline-control" id="type-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="type" /><select name="value">@foreach (var type in TicketTypes.All) { <option value="@type" selected="@(type == Model.Ticket.Type)">@type</option> }</select><button class="icon-button save-icon" type="submit" title="Save type" aria-label="Save type">✓</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">CATEGORY</p><button id="category-edit" class="icon-button edit-icon" type="button" title="Edit category" data-edit-field="category">✎</button></div><strong class="field-value" id="category-value">@Model.Ticket.Category</strong><form method="post" asp-page-handler="Update" class="inline-control" id="category-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="category" /><select name="value">@foreach (var category in Model.Categories) { <option value="@category" selected="@(category == Model.Ticket.Category)">@category</option> }</select><button class="icon-button save-icon" type="submit" title="Save category" aria-label="Save category">✓</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">LOCATION</p><button id="location-edit" class="icon-button edit-icon" type="button" title="Edit location" data-edit-field="location">✎</button></div><strong class="field-value" id="location-value">@(Model.Ticket.Location ?? "Not specified")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="location-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="location" /><select name="value"><option value="">Not specified</option>@foreach (var location in Model.Locations) { <option value="@location" selected="@(location == Model.Ticket.Location)">@location</option> }</select><button class="icon-button save-icon" type="submit" title="Save location" aria-label="Save location">✓</button></form></div>
        <div class="detail-block related-block">
            <p class="eyebrow">RELATED TICKETS</p>
            @if (Model.Relations.Count == 0) { <p class="muted">No related tickets.</p> }
            @foreach (var relation in Model.Relations)
            {
                <div class="related-row">
                    <div><span class="muted">@relation.Label</span><br /><a asp-page="/Job" asp-route-number="@relation.Number"><strong>#@relation.Number</strong> @relation.Title</a> <span class="status status-@Helpdesk.StatusTone(relation.Status)">@relation.Status</span></div>
                    <form method="post" asp-page-handler="UnlinkTicket" class="no-print"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="other" value="@relation.Number" /><button class="icon-button delete-icon" type="submit" title="Remove link to #@relation.Number" aria-label="Remove link to #@relation.Number">♜</button></form>
                </div>
            }
            <form method="post" asp-page-handler="LinkRelated" class="related-form no-print">
                <input type="hidden" name="number" value="@Model.Ticket.Number" />
                <label>Link a related ticket<input name="other" type="number" min="1" step="1" placeholder="Ticket number" required /></label>
                <button class="button button-secondary" type="submit">Link</button>
            </form>
            <form method="post" asp-page-handler="CreateFollowUp" class="no-print" data-confirm="Create a follow-up ticket for #@Model.Ticket.Number?">
                <input type="hidden" name="number" value="@Model.Ticket.Number" />
                <button class="button button-secondary" type="submit">Create follow-up ticket</button>
                <small class="muted">A new ticket with the same requester, assets, category and priority.</small>
            </form>
        </div>
        @if (Model.CanSeeProjects)
        {
            <div class="detail-block related-block no-print" id="projects">
                <p class="eyebrow">PURCHASING PROJECTS</p>
                @if (Model.LinkedProjects.Count == 0) { <p class="muted">Not linked to a project.</p> }
                @foreach (var linked in Model.LinkedProjects)
                {
                    <div class="related-row">
                        <div>
                            @if (Model.CanOpenProjects) { <a asp-page="/Project" asp-route-number="@linked.Number"><strong>@linked.Reference</strong> @linked.Title</a> } else { <span><strong>@linked.Reference</strong> @linked.Title</span> }
                            <span class="status">@linked.Status@(linked.Outcome is { } outcome ? $" · {outcome}" : "")</span>
                        </div>
                        @if (Model.CanLinkProjects)
                        {
                            <form method="post" asp-page-handler="UnlinkProject"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="project" value="@linked.Number" /><button class="icon-button delete-icon" type="submit" title="Remove link to @linked.Reference" aria-label="Remove link to @linked.Reference">♜</button></form>
                        }
                    </div>
                }
                @if (Model.CanLinkProjects && Model.LinkableProjects.Count > 0)
                {
                    <form method="post" asp-page-handler="LinkProject" class="related-form">
                        <input type="hidden" name="number" value="@Model.Ticket.Number" />
                        <label>Link to an open project<select name="project" required><option value="">Choose a project</option>@foreach (var open in Model.LinkableProjects) { <option value="@open.Number">@open.Reference · @open.Title</option> }</select></label>
                        <button class="button button-secondary" type="submit">Link</button>
                    </form>
                }
                @if (Model.CanStartProject)
                {
                    @* Raised for this ticket's requester and left for the project lead to assign, like one raised from the portal. *@
                    <details class="start-project">
                        <summary class="button button-secondary">Start a purchasing project…</summary>
                        <form method="post" asp-page-handler="StartProject" class="settings-form start-project-form">
                            <input type="hidden" name="number" value="@Model.Ticket.Number" />
                            <p class="muted">Raised for @(Model.Requester?.Name ?? "the requester"), who will see it in the staff portal. It waits for the project lead to confirm the priority and assign it.</p>
                            <label>Title<input name="title" value="@Model.Ticket.Title" maxlength="@HelpdeskStore.MaxProjectTitleLength" required /></label>
                            <label>Proposal needed by<input name="dueDate" type="date" value="@Model.DefaultProjectDueDate.ToString("yyyy-MM-dd")" min="@DateTime.Now.ToString("yyyy-MM-dd")" required /></label>
                            <label>Suggested priority<select name="priority">@foreach (var level in ProjectPriorities.All) { <option value="@level" selected="@(level == ProjectPriorities.Default)">@ProjectPriorities.Label(level) — @ProjectPriorities.Describe(level)</option> }</select></label>
                            <label>Items wanted<textarea name="itemsWanted" rows="5" maxlength="@HelpdeskStore.MaxProjectTextLength" required>@Model.Ticket.Description</textarea></label>
                            <button class="button button-primary" type="submit">Start project</button>
                        </form>
                    </details>
                }
            </div>
        }
        @if (Model.TicketAttributes.Count > 0) { <div class="detail-block"><p class="eyebrow">CUSTOM ATTRIBUTES</p><form method="post" asp-page-handler="UpdateAttributes"><input type="hidden" name="number" value="@Model.Ticket.Number" />@foreach (var field in Model.TicketAttributes) { var customValue = Model.TicketAttributeValues.GetValueOrDefault(field.Id, ""); if (field.FieldType == "dropdown") { <label>@field.Name<select name="customAttributes[@field.Id]"><option value="">Select an option</option>@foreach (var choice in HelpdeskStore.GetChoices(field)) { <option value="@choice" selected="@(choice == customValue)">@choice</option> }</select></label> } else if (field.FieldType == "checkbox") { <label class="toggle-label">@field.Name<input type="checkbox" name="customAttributes[@field.Id]" value="true" checked="@(customValue.Equals("true", StringComparison.OrdinalIgnoreCase))" /></label> } else if (field.FieldType == "multi-line") { <label>@field.Name<textarea name="customAttributes[@field.Id]" rows="3">@customValue</textarea></label> } else { <label>@field.Name<input name="customAttributes[@field.Id]" value="@customValue" /></label> } }<button class="button button-primary" type="submit">Save attributes</button></form></div> }
    </aside>
</div>
@section Scripts {
<script src="~/js/pages/job.js" asp-append-version="true"></script>
}
