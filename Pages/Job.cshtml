@page
@model JobModel
@{
    ViewData["Title"] = $"Job #{Model.Ticket!.Number}";
}

<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / JOB DETAIL</p><h1>#@Model.Ticket.Number</h1><p class="hero-copy">@Model.Ticket.Title</p></div>
    <a class="button button-secondary" asp-page="/Index">← Back to jobs</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<div class="job-detail-grid">
    <section class="panel job-main">
        <div class="panel-heading"><div><p class="eyebrow">DESCRIPTION</p><h2>@Model.Ticket.Title</h2></div></div>
        <p class="job-description">@Model.Ticket.Description</p>
        <div class="job-meta"><div><span>Created</span><strong>@Model.Ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div><div><span>Closed</span><strong>@(Model.Ticket.ClosedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Not closed")</strong></div></div>
    </section>
    <aside class="panel detail-sidebar">
        <div class="detail-block"><p class="eyebrow">REQUESTER</p><h3>@(Model.Requester?.Name ?? "Unknown")</h3><p>@Model.Requester?.Email</p><p>@Model.Requester?.Department · @Model.Requester?.Location</p></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">STATUS</p><button id="status-edit" class="icon-button edit-icon" type="button" title="Edit status" onclick="editField('status')">✎</button></div><strong class="field-value" id="status-value">@Model.Ticket.Status</strong><form method="post" asp-page-handler="Update" class="inline-control" id="status-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="status" /><select name="value"><option selected="@(Model.Ticket.Status == "Open")">Open</option><option selected="@(Model.Ticket.Status == "In Progress")">In Progress</option><option selected="@(Model.Ticket.Status == "On Hold")">On Hold</option><option selected="@(Model.Ticket.Status == "Closed")">Closed</option></select><button class="icon-button save-icon" type="submit" title="Save status" aria-label="Save status">✓</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">PRIORITY</p><button id="priority-edit" class="icon-button edit-icon" type="button" title="Edit priority" onclick="editField('priority')">✎</button></div><strong class="field-value priority @Model.Ticket.Priority.ToLowerInvariant()" id="priority-value">@Model.Ticket.Priority</strong><form method="post" asp-page-handler="Update" class="inline-control" id="priority-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="priority" /><select name="value"><option selected="@(Model.Ticket.Priority == "Low")">Low</option><option selected="@(Model.Ticket.Priority == "Normal")">Normal</option><option selected="@(Model.Ticket.Priority == "High")">High</option><option selected="@(Model.Ticket.Priority == "Urgent")">Urgent</option></select><button class="icon-button save-icon" type="submit" title="Save priority" aria-label="Save priority">✓</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">CATEGORY</p><button id="category-edit" class="icon-button edit-icon" type="button" title="Edit category" onclick="editField('category')">✎</button></div><strong class="field-value" id="category-value">@Model.Ticket.Category</strong><form method="post" asp-page-handler="Update" class="inline-control" id="category-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="category" /><select name="value"><option selected="@(Model.Ticket.Category == "Hardware")">Hardware</option><option selected="@(Model.Ticket.Category == "Software")">Software</option><option selected="@(Model.Ticket.Category == "Account")">Account</option><option selected="@(Model.Ticket.Category == "Network")">Network</option><option selected="@(Model.Ticket.Category == "Classroom AV")">Classroom AV</option><option selected="@(Model.Ticket.Category == "Other")">Other</option></select><button class="icon-button save-icon" type="submit" title="Save category" aria-label="Save category">✓</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">ASSIGNED TECHNICIAN</p><button id="technician-edit" class="icon-button edit-icon" type="button" title="Edit technician" onclick="editField('technician')">✎</button></div><strong class="field-value" id="technician-value">@(Model.Technician?.Name ?? "Unassigned")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="technician-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="technician" /><select name="value"><option value="">Unassigned</option>@foreach (var tech in Model.Technicians) { <option value="@tech.Id" selected="@(tech.Id == Model.Ticket.TechnicianId)">@tech.Name · @tech.Team</option> }</select><button class="icon-button save-icon" type="submit" title="Save technician" aria-label="Save technician">✓</button></form></div>
        <div class="detail-block editable-field"><div class="field-label"><p class="eyebrow">LINKED ASSET</p><button id="asset-edit" class="icon-button edit-icon" type="button" title="Edit linked asset" onclick="editField('asset')">✎</button></div><strong class="field-value" id="asset-value">@(Model.Asset?.AssetTag ?? "No asset linked")</strong><form method="post" asp-page-handler="Update" class="inline-control" id="asset-control"><input type="hidden" name="number" value="@Model.Ticket.Number" /><input type="hidden" name="field" value="asset" /><select name="value"><option value="">No asset / general request</option>@foreach (var asset in Model.Assets) { <option value="@asset.Id" selected="@(asset.Id == Model.Ticket.AssetId)">@asset.AssetTag · @asset.Type @asset.Model</option> }</select><button class="icon-button save-icon" type="submit" title="Save asset" aria-label="Save asset">✓</button></form></div>
    </aside>
</div>
@section Scripts {
<script>
function editField(name) {
    document.getElementById(name + "-value").style.display = "none";
    document.getElementById(name + "-edit").style.display = "none";
    document.getElementById(name + "-control").classList.add("visible");
}
</script>
}
