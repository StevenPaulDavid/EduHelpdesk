@page
@model LoginCodeModel
@{ ViewData["Title"] = "Sign in"; }
<div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>Sign in</h1><p class="hero-copy">@Model.Name, open your authenticator app and type the code it shows for the helpdesk.</p></div></div>
<section class="panel" style="max-width:420px;">
    <form method="post" class="settings-form">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <label>Code<input name="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="12" required autofocus /></label>
        <button class="button button-primary">Sign in</button>
        <p class="muted">No phone to hand? Type one of your recovery codes instead. Lost both? Ask an administrator to reset your two-step sign-in.</p>
        <p><a asp-page="/Login" asp-route-returnUrl="@Model.ReturnUrl">Start again</a></p>
    </form>
</section>
