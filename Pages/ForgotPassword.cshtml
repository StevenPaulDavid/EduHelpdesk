@page
@model ForgotPasswordModel
@using EduHelpdesk.Services
@{ ViewData["Title"] = "Forgotten your password?"; }
<div class="page-heading"><div><p class="eyebrow">EDUHELPDESK</p><h1>Forgotten your password?</h1></div></div>
<section class="panel" style="max-width:480px;">
    @if (!Model.Allowed)
    {
        <p>Ask an administrator to set you a new password. Your school has turned off resetting it yourself.</p>
        <p><a asp-page="/Login">← Back to sign in</a></p>
    }
    else
    {
        <p class="muted">Use the recovery key you made from your account menu: type it, or choose the recovery file you downloaded. No key? Ask an administrator to set you a new password.</p>
        <form method="post" enctype="multipart/form-data" class="settings-form">
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
            <label>Email<input name="Email" type="email" value="@Model.Email" maxlength="254" autocomplete="username" required autofocus /></label>
            <label>Recovery key<input name="Key" autocomplete="off" spellcheck="false" maxlength="40" placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" /></label>
            <label>Or your recovery file<input name="KeyFile" type="file" accept=".txt,text/plain" /></label>
            <label>New password<input name="NewPassword" type="password" autocomplete="new-password" maxlength="@PasswordRules.MaximumLength" required /><small class="muted">@PasswordRules.Hint</small></label>
            <label>New password again<input name="ConfirmPassword" type="password" autocomplete="new-password" maxlength="@PasswordRules.MaximumLength" required /></label>
            <button class="button button-primary">Set my new password</button>
            <p class="muted">Your recovery key works once. If you use two-step sign-in, you'll still be asked for a code when you sign in.</p>
            <p><a asp-page="/Login">← Back to sign in</a></p>
        </form>
    }
</section>
