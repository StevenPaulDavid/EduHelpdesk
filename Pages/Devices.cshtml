@page
@model DevicesModel
@using EduHelpdesk.Services
@{ ViewData["Title"] = "Device agent"; }
<div class="page-heading"><div><h1>Device agent</h1><p class="hero-copy">School PCs with the EduHelpdesk Agent installed add themselves to the asset register and keep their specs up to date. Each reports when it starts and once a day.</p></div></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }
@if (!Model.IsHttps)
{
    <div class="notice notice-warning">This page came over plain HTTP. The agent only connects over HTTPS, so PCs can't report in until HTTPS is on: run Enable-Https.cmd from the folder EduHelpdesk was installed from. See the Install Guide.</div>
}

@if (Model.CanSetUp)
{
    <section class="panel" id="setup">
        <h2>Set-up</h2>
        @if (!Model.Enabled)
        {
            <p>The device agent is off. Turning it on makes an enrolment key for the install command; PCs can then enrol and report in.</p>
            <form method="post" asp-page-handler="TurnOn"><button class="button button-primary">Turn on the device agent</button></form>
        }
        else
        {
            <p>The device agent is on. Download the agent, then run the install command in its folder on a PC as an administrator, or add it to Intune as a Win32 app (see Help).</p>
            @if (Model.Package is { } package)
            {
                <p><a class="button button-secondary" asp-page-handler="Download">Download the agent (version @package.VersionText, @((package.Length / 1048576d).ToString("0")) MB)</a></p>
                <p class="muted">PCs already running an older version update themselves to this one within a couple of hours of their next report.</p>
            }
            else
            {
                <div class="notice notice-warning">This helpdesk has no agent to hand out: it comes with each release, in the <code>agent-app</code> folder beside the program. PCs can still report in with an agent from elsewhere, but won't update themselves.</div>
            }
            <details>
                <summary>Show the install command</summary>
                <pre class="code-block"><code>@Model.InstallCommand</code></pre>
                <p class="muted">The key in it enrols any PC, so treat it like a password. A new key stops new enrolments with the old one; PCs already enrolled carry on.@if (Model.Fingerprint is null) { <text> No certificate fingerprint is included, so PCs check the helpdesk's certificate the normal Windows way: it has to be trusted on them.</text> }</p>
            </details>
            <details>
                <summary>Warnings: not seen for @(Model.WarningSettings.StaleDays > 0 ? $"{Model.WarningSettings.StaleDays} days" : "(off)"), low disk below @(Model.WarningSettings.LowDiskPercent > 0 ? $"{Model.WarningSettings.LowDiskPercent}%" : "(off)")</summary>
                <form method="post" asp-page-handler="Warnings" class="settings-form field-narrow">
                    <label>A PC needs attention when it hasn't reported for this many days<input asp-for="StaleDays" type="number" min="0" max="@HelpdeskStore.MaxAgentStaleDays" required /></label>
                    <label>Or when its C: drive has less than this percent free<input asp-for="LowDiskPercent" type="number" min="0" max="@HelpdeskStore.MaxAgentLowDiskPercent" required /></label>
                    <p class="muted">0 switches that warning off. The bell rings once a day, from 7am, for PCs newly on the list, for everyone with Device agent access.</p>
                    <button class="button button-secondary">Save warnings</button>
                </form>
            </details>
            <div class="button-row">
                <form method="post" asp-page-handler="NewKey" data-confirm="Make a new enrolment key? The old install command stops enrolling PCs; PCs already enrolled carry on."><button class="button button-secondary">New enrolment key</button></form>
                <form method="post" asp-page-handler="TurnOff" data-confirm="Turn the device agent off? PCs stop reporting in until it is turned back on; they stay enrolled."><button class="button button-danger">Turn off</button></form>
            </div>
        }
    </section>
}
else if (!Model.Enabled)
{
    <div class="notice notice-warning">The device agent is off. Someone with Device agent: Edit can turn it on here.</div>
}

@if (Model.Warnings.Count > 0)
{
    <section class="panel" id="attention">
        <div class="panel-heading">
            <div><h2>Needs attention <span class="badge badge-warning">@Model.Warnings.Count</span></h2><p class="muted">PCs that have stopped reporting (lost, broken, put away, or the agent removed) or are running low on disk space.</p></div>
            @if (Model.CanView) { <a class="button button-secondary" asp-page-handler="Export">Download CSV</a> }
        </div>
        <div class="table-wrap"><table class="stack-table"><thead><tr><th data-stack="head">PC</th><th>Asset</th><th>Problem</th><th>Last signed in</th></tr></thead><tbody>
        @foreach (var warning in Model.Warnings)
        {
            <tr>
                <td><strong>@warning.Device.ComputerName</strong><br /><span class="muted">@AgentFacts.Make(warning.Device.Report) @AgentFacts.Model(warning.Device.Report)</span></td>
                <td>@if (warning.Asset is { } asset) { <a asp-page="/Asset" asp-route-id="@asset.Id">@asset.AssetTag</a>@if (!string.IsNullOrWhiteSpace(asset.Location)) { <br /><span class="muted">@asset.Location</span> } } else { <span class="muted">Waiting to be linked</span> }</td>
                <td>@warning.Detail@if (warning.Kind == HelpdeskStore.AgentWarningKinds.NotSeen) { <br /><span class="muted">last seen @warning.Device.LastSeenAt.ToLocalTime().ToString("d MMM yyyy")@(warning.Device.LastAddress is { } from ? $" from {from}" : "")</span> }</td>
                <td>@AgentFacts.LastUser(warning.Device.Report)</td>
            </tr>
        }
        </tbody></table></div>
    </section>
}

@if (Model.Waiting.Count > 0)
{
    <section class="panel" id="waiting">
        <h2>Waiting to be linked <span class="badge">@Model.Waiting.Count</span></h2>
        <p class="muted">These PCs share a serial number with an asset already on the register. Review one to compare them side by side and link it if it's that asset, choosing which value to keep for each field. If it isn't (a mistyped serial, say), add it as a new asset. Until then its reports are kept here and nothing on the asset changes.</p>
        <div class="table-wrap"><table class="stack-table"><thead><tr><th data-stack="head">PC</th><th>Matches</th><th>Enrolled</th><th></th></tr></thead><tbody>
        @foreach (var device in Model.Waiting)
        {
            var match = Model.AssetFor(device.MatchAssetId);
            <tr>
                <td><strong>@device.ComputerName</strong><br /><span class="muted">@AgentFacts.Make(device.Report) @AgentFacts.Model(device.Report), serial @device.SerialNumber</span></td>
                <td>@if (match is not null) { <a asp-page="/Asset" asp-route-id="@match.Id">@match.AssetTag</a><br /><span class="muted">@match.Make @match.Model@(string.IsNullOrWhiteSpace(match.Location) ? "" : $", {match.Location}")</span> }</td>
                <td>@device.EnrolledAt.ToLocalTime().ToString("d MMM yyyy")<br /><span class="muted">last seen @DevicesModel.Ago(device.LastSeenAt)</span></td>
                <td>
                    <div class="button-row">
                        @if (Model.CanSetUp && match is not null) { <a class="button button-primary" asp-page="/Devices/Review" asp-route-id="@device.Id">Review and link</a> }
                        @if (Model.CanAddNew) { <form method="post" asp-page-handler="AddNew" asp-route-id="@device.Id"><button class="button button-secondary">Add as a new asset</button></form> }
                        @if (Model.CanRemove) { <form method="post" asp-page-handler="Remove" asp-route-id="@device.Id" data-confirm="Remove @device.ComputerName? If the agent is still on it, it enrols again at its next report."><button class="button button-danger">Remove</button></form> }
                    </div>
                </td>
            </tr>
        }
        </tbody></table></div>
    </section>
}

<section class="panel" id="pcs">
    <div class="panel-heading">
        <div><h2>PCs reporting in <span class="badge">@Model.LinkedTotal</span></h2></div>
        @if (Model.LinkedTotal > 0)
        {
            <form method="get" class="inline-search"><input name="q" type="search" value="@Model.Q" placeholder="Search name, tag, serial, user" aria-label="Search PCs" maxlength="100" /><button class="button button-secondary">Search</button></form>
        }
    </div>
    @if (Model.LinkedTotal == 0)
    {
        <p class="muted">No PCs have reported in yet.</p>
    }
    else if (Model.Linked.Count == 0)
    {
        <p class="muted">No PCs match "@Model.Q". <a asp-page="/Devices">Show all</a></p>
    }
    else
    {
        <div class="table-wrap"><table class="stack-table"><thead><tr><th data-stack="head">PC</th><th>Asset</th><th>Windows</th><th>Last signed in</th><th>Last seen</th>@if (Model.CanRemove) { <th></th> }</tr></thead><tbody>
        @foreach (var device in Model.Linked)
        {
            var asset = Model.AssetFor(device.AssetId);
            <tr>
                <td><strong>@device.ComputerName</strong><br /><span class="muted">@AgentFacts.Make(device.Report) @AgentFacts.Model(device.Report)</span></td>
                <td>@if (asset is not null) { <a asp-page="/Asset" asp-route-id="@asset.Id" asp-fragment="@(Model.CanView ? "asset-device" : null)">@asset.AssetTag</a> } else { <span class="muted">Asset deleted: added again at its next report</span> }</td>
                <td>@AgentFacts.OperatingSystem(device.Report)<br /><span class="muted">build @AgentFacts.Build(device.Report)</span></td>
                <td>@AgentFacts.LastUser(device.Report)</td>
                <td>@DevicesModel.Ago(device.LastSeenAt)@if (Model.Stale(device)) { <text> </text><span class="badge badge-warning">Not reporting</span> }@if (device.LastAddress is { } where) { <br /><span class="muted">from @where</span> }<br /><span class="muted">agent @device.AgentVersion@(Model.Behind(device) ? ", updating" : "")</span></td>
                @if (Model.CanRemove) { <td><form method="post" asp-page-handler="Remove" asp-route-id="@device.Id" asp-route-q="@Model.Q" data-confirm="Remove @device.ComputerName from the device agent? Its asset stays. If the agent is still on it, it enrols again at its next report."><button class="button button-danger">Remove</button></form></td> }
            </tr>
        }
        </tbody></table></div>
    }
</section>
