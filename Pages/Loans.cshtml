@page
@using EduHelpdesk.Services
@model LoansModel
@{ ViewData["Title"] = "Loans"; ViewData["Wide"] = true; }
<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / LOANS</p><h1>Loans</h1><p class="hero-copy">Everything out with staff right now — loan kits and individual devices — and what has come back lately.</p></div>
    <div class="heading-actions">
        <a class="button button-secondary" asp-page="/Reports/Loans">Loan report</a>
        <a class="button button-secondary" asp-page="/Kits">Kits</a>
        <a class="button button-primary" asp-page="/Loans/Issue">@Icons.Plus Issue a loan</a>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<div class="metrics">
    <div class="metric"><span>Out now</span><strong>@Model.Out.Count</strong><small>With staff</small></div>
    <div class="metric"><span>Overdue</span><strong>@Model.OverdueCount</strong><small>Past their due-back date</small></div>
    <div class="metric"><span>Kits</span><strong>@Model.KitCount</strong><small>Of those out</small></div>
    <div class="metric"><span>Individual devices</span><strong>@Model.AssetCount</strong><small>Of those out</small></div>
</div>

<section class="panel directory-panel">
    <div class="panel-heading"><div><p class="eyebrow">OUT NOW</p><h2>On loan</h2></div><span class="badge @(Model.OverdueCount > 0 ? "badge-warning" : "")">@Model.Out.Count</span></div>
    <div class="table-wrap"><table><thead><tr>
        <th>Type</th><th data-stack="head">What</th><th>Borrower</th><th>Reason</th><th>Out for</th><th>Due back</th><th></th>
    </tr></thead><tbody>
    @foreach (var loan in Model.Out)
    {
        var overdue = loan.IsOverdue(Model.Today);
        <tr>
            <td><span class="badge">@loan.Kind</span></td>
            <td><strong>@loan.What</strong></td>
            <td>@loan.BorrowerName</td>
            <td>@loan.ReasonLabel</td>
            <td>@Model.Duration(loan)</td>
            <td>@(loan.DueBack is { } due ? Html.Raw($"<span class=\"badge {(overdue ? "badge-warning" : "")}\">{AssetInsights.Format(due)}</span>") : Html.Raw("—"))</td>
            <td class="asset-row-actions">
                @if (Model.KitIdFor(loan) is { } kitId)
                {
                    <form method="post" asp-page-handler="Return" class="loan-return-form">
                        <input type="hidden" name="kitId" value="@kitId" />
                        <input name="notes" placeholder="Anything missing? (optional)" aria-label="Return notes for @loan.What" />
                        <button class="button button-secondary">Book back in</button>
                    </form>
                }
                else if (Model.AssetIdFor(loan) is { } assetId)
                {
                    <a class="button button-secondary" asp-page="/Asset" asp-route-id="@assetId">Open to return</a>
                }
                else { <span class="muted">—</span> }
            </td>
        </tr>
    }
    @if (Model.Out.Count == 0) { <tr><td colspan="7" class="empty">Nothing is out on loan.</td></tr> }
    </tbody></table></div>
</section>

<section class="panel directory-panel">
    <div class="panel-heading"><div><p class="eyebrow">RECENTLY BACK</p><h2>Returned</h2></div><span class="badge">Last @LoansModel.RecentLimit</span></div>
    <div class="table-wrap"><table><thead><tr>
        <th>Type</th><th data-stack="head">What</th><th>Borrower</th><th>Reason</th><th>Issued</th><th>Returned</th><th>Kept</th>
    </tr></thead><tbody>
    @foreach (var loan in Model.Recent)
    {
        <tr>
            <td><span class="badge">@loan.Kind</span></td>
            <td>@loan.What</td>
            <td>@loan.BorrowerName</td>
            <td>@loan.ReasonLabel</td>
            <td>@(loan.IssuedAt is { } issued ? issued.ToLocalTime().ToString("dd MMM yyyy") : "—")</td>
            <td>@(loan.ReturnedAt is { } returned ? returned.ToLocalTime().ToString("dd MMM yyyy") : "—")</td>
            <td>@Model.Duration(loan)</td>
        </tr>
    }
    @if (Model.Recent.Count == 0) { <tr><td colspan="7" class="empty">Nothing has been returned yet.</td></tr> }
    </tbody></table></div>
</section>
