@using EduHelpdesk.Services
@inject HelpdeskStore Helpdesk
@* The tab strip for the reports area, built from the report flags (ReportMenu): what is drawn is what this role can
   open, for the parts of the top bar the desks being worked on use. The model is the active page's route -
   "/Reports", "/Reports/Loans" and so on. *@
@model string
@{
    var visible = ReportMenu.For(Helpdesk, User, Model);
}
@* One tab on its own is a label, not a choice, so the strip is dropped entirely. *@
@if (visible.Count > 1)
{
    <nav class="queue-tabs report-tabs" aria-label="Report type">
        @foreach (var tab in visible)
        {
            <a class="queue-tab @(tab.Page == Model ? "active" : null)" asp-page="@tab.Page">@tab.Tab</a>
        }
    </nav>
}
