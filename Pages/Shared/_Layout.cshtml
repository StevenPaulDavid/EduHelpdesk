@using EduHelpdesk.Services
@inject HelpdeskStore Helpdesk
@{
    // Which top-level nav item is current, so the Inventory menu still shows where you are.
    var navPath = Context.Request.Path.Value ?? string.Empty;
    bool NavOn(params string[] prefixes) => prefixes.Any(p =>
        navPath.Equals(p, StringComparison.OrdinalIgnoreCase) || navPath.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
    var onInventory = NavOn("/Assets", "/Asset", "/Kits", "/Loans", "/Parts", "/Suppliers", "/Supplier");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @Helpdesk.Branding.BrandName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --teal: @Helpdesk.Branding.PrimaryColor;
            --teal-dark: @Helpdesk.Branding.PrimaryColor;
            --paper: @Helpdesk.Branding.BackgroundColor;
            --accent: @Helpdesk.Branding.AccentColor;
        }
        .button-secondary { background: var(--accent); }
        @if (Helpdesk.Branding.DarkMode)
        {
            <text>
            :root { --ink: #e7eeee; --muted: #aabcbc; --line: #304247; --paper: #152326; --accent: #29474b; }
            body { background: var(--paper); color: var(--ink); }
            .topbar, .panel, .metric, .nav-panel { background: #1d3034; color: var(--ink); border-color: var(--line); }
            .nav-panel a, .nav-panel button { color: var(--ink); }
            .nav-panel a:hover, .nav-panel button:hover { background: #29474b; }
            .topbar nav summary { color: var(--muted); }
            .topbar nav a, .workspace-label, .muted { color: var(--muted); }
            .directory-row, td, th { border-color: var(--line); }
            .directory-row:hover, .clickable-row:hover, .asset-job-option:hover { background: #29474b; }
            .comment, .history-entry { background: #263b3f; }
            input, select, textarea { background: #263b3f; color: var(--ink); border-color: #496064; }
            .brand > span:last-child span, .topbar nav a:hover { color: var(--teal); }
            .form-grid label, .import-row label { color: var(--muted); }            </text>
        }
    </style>
</head>
<body>
    <header class="topbar"><div class="brand"><span class="brand-mark">EH</span><span>@Helpdesk.Branding.BrandName</span></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav>
            <a asp-page="/Index" class="@(navPath == "/" ? "active" : null)">Overview</a>
            <a asp-page="/Jobs" class="@(NavOn("/Jobs", "/Job", "/NewTicket") ? "active" : null)">Tickets</a>
            <a asp-page="/People" class="@(NavOn("/People") ? "active" : null)">People</a>
            <details class="nav-menu">
                <summary class="@(onInventory ? "active" : null)">Inventory<span class="chev" aria-hidden="true">▾</span></summary>
                <div class="nav-panel">
                    <a asp-page="/Assets">Assets</a>
                    <a asp-page="/Kits">Kits</a>
                    <a asp-page="/Loans">Loans</a>
                    <a asp-page="/Parts">Parts</a>
                    <a asp-page="/Suppliers">Suppliers</a>
                </div>
            </details>
            <a asp-page="/Reports" class="@(NavOn("/Reports") ? "active" : null)">Reports</a>
            @if (Helpdesk.UserHasPermission(User, Permissions.Settings)) { <a asp-page="/Settings" class="@(NavOn("/Settings") ? "active" : null)">Settings</a> }
        </nav>
        <a class="button button-primary header-job-button" asp-page="/NewTicket">＋ Log a ticket</a>
        <details class="nav-menu user-menu">
            <summary><span class="user-name">@User.Identity!.Name</span><span class="chev" aria-hidden="true">▾</span></summary>
            <div class="nav-panel nav-panel-right">
                <a asp-page="/ChangePassword">Change password</a>
                <a asp-page="/Portal/Index" target="_blank" rel="noopener">Open staff portal ↗</a>
                <form method="post" asp-page="/Logout"><button type="submit">Sign out</button></form>
            </div>
        </details>
    }
    </header>
    <main class="shell">@RenderBody()</main>
    <footer class="footer">EduHelpdesk · Local technician operations</footer>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Only one header menu open at a time, and clicking away or pressing Escape closes them.
        (function () {
            const menus = [...document.querySelectorAll(".topbar .nav-menu")];
            menus.forEach(m => m.addEventListener("toggle", () => {
                if (m.open) menus.filter(o => o !== m).forEach(o => o.open = false);
            }));
            document.addEventListener("click", e => {
                menus.forEach(m => { if (!m.contains(e.target)) m.open = false; });
            });
            document.addEventListener("keydown", e => {
                if (e.key === "Escape") menus.forEach(m => m.open = false);
            });
        })();
    </script>
</body>
</html>
