@using EduHelpdesk.Services
@inject HelpdeskStore Helpdesk
@{
    // Which top-level nav item is current, so the Inventory menu still shows where you are.
    var navPath = Context.Request.Path.Value ?? string.Empty;
    bool NavOn(params string[] prefixes) => prefixes.Any(p =>
        navPath.Equals(p, StringComparison.OrdinalIgnoreCase) || navPath.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
    var onInventory = NavOn("/Assets", "/Asset", "/Kits", "/Loans", "/Parts", "/Suppliers", "/Supplier");

    // A link nobody can follow is worse than no link: people click it, get refused, and raise a ticket about it. So the
    // menu is built from what this role can actually reach. The pages enforce the same permissions themselves - this
    // only decides what is worth showing.
    bool Can(string module, ModulePermission action = ModulePermission.Access) => Helpdesk.UserCan(User, module, action);
    var canInventory = Can(Modules.Assets) || Can(Modules.Kits) || Can(Modules.Loans) || Can(Modules.Parts) || Can(Modules.Suppliers);
    // /Reports is the asset report, not an index, so pointing the menu at it would refuse anyone given only one of the
    // other reports. The link goes to the first report this role can actually open.
    var reportPages = new (string Page, string Flag)[]
    {
        ("/Reports", Modules.Flags.ReportAssets), ("/Reports/Tickets", Modules.Flags.ReportTickets),
        ("/Reports/Parts", Modules.Flags.ReportParts), ("/Reports/Loans", Modules.Flags.ReportLoans),
        ("/Reports/Finance", Modules.Flags.ReportFinance),
    };
    var firstReport = Can(Modules.Reports) ? reportPages.FirstOrDefault(x => Helpdesk.UserHasFlag(User, x.Flag)).Page : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @Helpdesk.Branding.BrandName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --teal: @Helpdesk.Branding.PrimaryColor;
            --teal-dark: @Helpdesk.Branding.PrimaryColor;
            --paper: @Helpdesk.Branding.BackgroundColor;
            --accent: @Helpdesk.Branding.AccentColor;
        }
        .button-secondary { background: var(--accent); }
        @if (Helpdesk.Branding.DarkMode)
        {
            <text>
            :root { --ink: #e7eeee; --muted: #aabcbc; --line: #304247; --paper: #152326; --accent: #29474b; }
            body { background: var(--paper); color: var(--ink); }
            .topbar, .panel, .metric, .nav-panel { background: #1d3034; color: var(--ink); border-color: var(--line); }
            .nav-panel a, .nav-panel button { color: var(--ink); }
            .nav-panel a:hover, .nav-panel button:hover { background: #29474b; }
            .nav-panel .menu-danger, .nav-panel .menu-danger:hover { color: #f08a80; }
            .topbar nav summary { color: var(--muted); }
            .topbar nav a, .workspace-label, .muted { color: var(--muted); }
            .directory-row, td, th { border-color: var(--line); }
            .directory-row:hover, .clickable-row:hover, .asset-job-option:hover { background: #29474b; }
            .comment, .history-entry { background: #263b3f; }
            input, select, textarea { background: #263b3f; color: var(--ink); border-color: #496064; }
            .brand > span:last-child span, .topbar nav a:hover { color: var(--teal); }
            .form-grid label, .import-row label { color: var(--muted); }            </text>
        }
    </style>
</head>
<body>
    @* The school's logo when one has been uploaded (Settings → Branding), otherwise the initials badge. The brand name
       stays beside it as text, so the logo's alt text is empty rather than repeating it. *@
    <header class="topbar"><div class="brand">@if (Helpdesk.LogoVersion is { } logoVersion) { <img class="brand-logo" src="@Url.Content("~/branding/logo")?v=@logoVersion" alt="" /> } else { <span class="brand-mark">EH</span> }<span>@Helpdesk.Branding.BrandName</span></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav>
            <a asp-page="/Index" class="@(navPath == "/" ? "active" : null)">Overview</a>
            @if (Can(Modules.Tickets)) { <a asp-page="/Jobs" class="@(NavOn("/Jobs", "/Job", "/NewTicket") ? "active" : null)">Tickets</a> }
            @* People is one page holding requesters, staff accounts and roles, so reaching any one of them is enough. *@
            @if (Can(Modules.Requesters) || Can(Modules.StaffAccounts) || Can(Modules.Roles)) { <a asp-page="/People" class="@(NavOn("/People") ? "active" : null)">People</a> }
            @if (canInventory)
            {
                <details class="nav-menu">
                    <summary class="@(onInventory ? "active" : null)">Inventory<span class="chev" aria-hidden="true">▾</span></summary>
                    <div class="nav-panel">
                        @if (Can(Modules.Assets)) { <a asp-page="/Assets">Assets</a> }
                        @if (Can(Modules.Kits)) { <a asp-page="/Kits">Kits</a> }
                        @if (Can(Modules.Loans)) { <a asp-page="/Loans">Loans</a> }
                        @if (Can(Modules.Parts)) { <a asp-page="/Parts">Parts</a> }
                        @if (Can(Modules.Suppliers)) { <a asp-page="/Suppliers">Suppliers</a> }
                    </div>
                </details>
            }
            @* Reports needs the area level AND at least one readable report - the area on its own opens nothing. *@
            @if (firstReport is not null) { <a asp-page="@firstReport" class="@(NavOn("/Reports") ? "active" : null)">Reports</a> }
            @if (Can(Modules.Settings)) { <a asp-page="/Settings" class="@(NavOn("/Settings") ? "active" : null)">Settings</a> }
            @* Somebody given the audit log but not Settings - a DPO, say - gets a link straight to the log, because the
               Settings page itself would refuse them. *@
            else if (Can(Modules.AuditLog)) { <a asp-page="/Settings/Audit" class="@(NavOn("/Settings") ? "active" : null)">Audit log</a> }
        </nav>
        @if (Can(Modules.Tickets, ModulePermission.New)) { <a class="button button-primary header-job-button" asp-page="/NewTicket">＋ Log a ticket</a> }
        <details class="nav-menu user-menu">
            <summary><span class="user-name">@User.Identity!.Name</span><span class="chev" aria-hidden="true">▾</span></summary>
            <div class="nav-panel nav-panel-right">
                <a asp-page="/ChangePassword">Change password</a>
                <a asp-page="/Portal/Index" target="_blank" rel="noopener">Open staff portal ↗</a>
                <form method="post" asp-page="/Logout"><button type="submit">Sign out</button></form>
            </div>
        </details>
    }
    </header>
    <main class="shell">@RenderBody()</main>
    <footer class="footer">EduHelpdesk · Local technician operations</footer>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Only one menu open at a time - header menus and page action menus alike - and clicking away, choosing an
        // item, or pressing Escape closes them.
        (function () {
            const menus = [...document.querySelectorAll("details.nav-menu")];
            menus.forEach(m => m.addEventListener("toggle", () => {
                if (m.open) menus.filter(o => o !== m).forEach(o => o.open = false);
            }));
            document.addEventListener("click", e => {
                menus.forEach(m => { if (!m.contains(e.target) || e.target.closest(".nav-panel button, .nav-panel a")) m.open = false; });
            });
            document.addEventListener("keydown", e => {
                if (e.key === "Escape") menus.forEach(m => m.open = false);
            });
        })();
    </script>
</body>
</html>
