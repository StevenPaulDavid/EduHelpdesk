<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · EduHelpdesk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar"><div class="brand"><span class="brand-mark">EH</span><span>Edu<span>Helpdesk</span></span></div><nav><a asp-page="/Index">Workspace</a><a asp-page="/People">People</a><a asp-page="/Settings">Settings</a></nav><span class="workspace-label">Technician workspace</span></header>
    <main class="shell">@RenderBody()</main>
    <footer class="footer">EduHelpdesk · Local technician operations</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
