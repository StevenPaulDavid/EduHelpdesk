@using System.Security.Claims
@using EduHelpdesk.Services
@inject HelpdeskStore Helpdesk
@inject PortalIdentity Portal
@inject HelpCentre HelpArticles
@{
    // Which top-level nav item is current, so a menu still shows where you are.
    var navPath = Context.Request.Path.Value ?? string.Empty;
    bool NavOn(params string[] prefixes) => prefixes.Any(p =>
        navPath.Equals(p, StringComparison.OrdinalIgnoreCase) || navPath.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
    var onAssets = NavOn("/Assets", "/Asset", "/Kits", "/Loans", "/Parts", "/Suppliers", "/Supplier");
    var onPeople = NavOn("/People");
    var onOnboarding = NavOn("/Onboarding");
    var onReports = NavOn("/Reports", "/Contracts", "/Contract", "/Access", "/Compliance");

    // A link nobody can follow is worse than no link: people click it, get refused, and raise a ticket about it. So the
    // menu is built from what this role can actually reach. The pages enforce the same permissions themselves - this
    // only decides what is worth showing.
    bool Can(string module, ModulePermission action = ModulePermission.Access) => Helpdesk.UserCan(User, module, action);
    // And from what the desks being worked on use (Settings → Desks, Services/DeskAreas.cs): the Site desk can leave
    // Kits and Projects out of its bar. That only ever takes a link away - the role still decides what opens.
    var areas = DeskAreas.All.ToDictionary(x => x.Key, x => Helpdesk.AreaOn(User, x.Key));
    bool On(string area) => areas[area];
    // Assets: the register (kit on IT, plant on Site, as the desk switcher has it) and what goes with it. Like HR and
    // Reports, a menu with two or more, a plain link with one, nothing with none.
    var assetLinks = new List<(string Page, string Label)>();
    if (Can(Modules.Assets) && On(DeskAreas.Assets)) assetLinks.Add(("/Assets", "Assets"));
    if (Can(Modules.Kits) && On(DeskAreas.Kits)) assetLinks.Add(("/Kits", "Kits"));
    if (Can(Modules.Loans) && On(DeskAreas.Loans)) assetLinks.Add(("/Loans", "Loans"));
    if (Can(Modules.Parts) && On(DeskAreas.Parts)) assetLinks.Add(("/Parts", "Parts"));
    if (Can(Modules.Suppliers) && On(DeskAreas.Suppliers)) assetLinks.Add(("/Suppliers", "Suppliers"));
    // People is one page holding requesters, technician accounts and roles, so reaching any one of them is enough.
    var canPeople = (Can(Modules.Requesters) || Can(Modules.StaffAccounts) || Can(Modules.Roles)) && On(DeskAreas.People);
    var canOnboarding = Can(Modules.Onboarding) && On(DeskAreas.People);
    var canRounds = Helpdesk.UserHasFlag(User, Modules.Flags.Rounds) && On(DeskAreas.Rounds);
    // Reports: every report this role can open (ReportMenu - /Reports is the asset report, not an index), then the DfE
    // registers that aren't inventory, the compliance summary first since it is where the three meet.
    var reportLinks = ReportMenu.For(Helpdesk, User).Select(x => (Section: "Reports", x.Page, x.Label)).ToList();
    if (On(DeskAreas.Compliance))
    {
        if (Can(Modules.Contracts) || Can(Modules.Access)) reportLinks.Add(("Compliance", "/Compliance/Index", "Compliance summary"));
        if (Can(Modules.Contracts)) reportLinks.Add(("Compliance", "/Contracts", "Contracts register"));
        if (Can(Modules.Access)) { reportLinks.Add(("Compliance", "/Access/Index", "Access control")); reportLinks.Add(("Compliance", "/Access/Review", "Access review")); }
    }
    // The gear: the Settings index, or for someone who can't open it - a DPO given only the audit log, a site manager
    // given "Set up facilities" - the first settings page they can open, whose own menu lists the rest (_SettingsLayout).
    var settingsHref = Can(Modules.Settings) ? Url.Page("/Settings")
        : SettingsMenu.Sections.SelectMany(x => x.Items).Where(x => x.Need != SettingsMenu.Need.Info && SettingsMenu.CanOpen(Helpdesk, User, x)).Select(x => Url.Content("~" + x.Page)).FirstOrDefault();

    // The desk switcher (HelpdeskStore.DeskSwitch): for whoever can see more than one desk. It goes back to the page it
    // was pressed on without that page's own ?desk=, so the page opens on the desk just chosen. Only a GET's query
    // string is kept, as for the Appearance switch.
    var deskSwitch = User.Identity?.IsAuthenticated == true ? Helpdesk.SwitcherFor(User) : null;
    var deskReturn = Context.Request.Path + (HttpMethods.IsGet(Context.Request.Method)
        ? QueryString.Create(Context.Request.Query.Where(x => !string.Equals(x.Key, "desk", StringComparison.OrdinalIgnoreCase))).ToString() : "");
    string DeskColor(EduHelpdesk.Models.Desk desk) => PortalLook.FindColor(Helpdesk.StyleForDesk(desk).Color)?.Hex ?? "";

    // Pings and pop-ups (wwwroot/js/notifications.js) ask for the notifications of whoever the page is signed in as: the
    // requester on the staff portal's pages, the helpdesk account everywhere else. Nobody signed in, nothing to ask for.
    string? notifyAudience = null;
    Guid? notifyAccount = null;
    if (NavOn("/Portal"))
    {
        if (Portal.Resolve(Context.Request, Helpdesk) is { } portalUserId) { notifyAudience = HelpdeskStore.PortalAudience; notifyAccount = portalUserId; }
    }
    else if (User.Identity?.IsAuthenticated == true && Guid.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var technicianId))
    {
        notifyAudience = HelpdeskStore.StaffAudience;
        notifyAccount = technicianId;
    }
    // The bell: a pop-up that was missed is still waiting under it. For whoever hears about new tickets and replies,
    // while the staff side of notifications is switched on in Settings - whether or not they switched pop-ups on here.
    // Ticket news reaches only those who can see tickets; messages addressed to the account itself - the compliance
    // reminders - reach anyone, so a business manager with no ticket access still has the bell.
    var bell = notifyAudience == HelpdeskStore.StaffAudience && Helpdesk.NotificationsOpenFor(HelpdeskStore.StaffAudience)
        ? Helpdesk.InboxFor(notifyAccount!.Value, broadcast: Can(Modules.Tickets), take: 15, desks: Helpdesk.VisibleDeskIds(User))
        : null;
    string BellLabel(int unread) => unread == 0 ? "Notifications, none unread" : $"Notifications, {unread} unread";

    // Light, dark or "match device", chosen per browser with the footer switch (Services/Themes.cs, site.css).
    var chosenTheme = Themes.Chosen(Context.Request);
    var theme = chosenTheme ?? Helpdesk.Branding.DefaultAppearance;
    // Where the switch returns to. After a form post the address can carry a ?handler= that only answers posts, so
    // only a GET's query string is kept.
    var themeReturn = Context.Request.Path + (HttpMethods.IsGet(Context.Request.Method) ? Context.Request.QueryString.ToString() : "");

    // Lists, queues, reports and the overview set ViewData["Wide"] = true and use the whole screen. Everything else -
    // a ticket, a project, a form - stops at a readable width (.shell in site.css).
    var shellClass = ViewData["Wide"] is true ? "shell shell-wide" : "shell";

    // Help (Pages/Help): for signed-in helpdesk accounts, not the portal. A page with a guide gets a Help link that
    // wwwroot/js/help.js moves beside its heading; a first sign-in gets a welcome note until it's dismissed.
    var helpdeskSignedIn = User.Identity?.IsAuthenticated == true && !NavOn("/Portal");
    var onHelp = NavOn("/Help");
    var pageHelp = helpdeskSignedIn && !onHelp ? HelpArticles.ForPage(navPath) : null;
    // Only on the overview, where someone lands: on every page it pushed the work below the fold.
    var showWelcome = helpdeskSignedIn && navPath == "/"
        && Guid.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var welcomeAccount)
        && Helpdesk.Preference(welcomeAccount, HelpdeskStore.HelpWelcomePreference) is null;
}
<!DOCTYPE html>
<html lang="en" data-theme="@Themes.Key(theme)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="@(theme switch { EduHelpdesk.Models.Appearance.Dark => "dark", EduHelpdesk.Models.Appearance.Device => "light dark", _ => "light" })" />
    <title>@ViewData["Title"] · @Helpdesk.Branding.BrandName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* The school's colours from Settings → Branding & logo. The dark palette in site.css replaces the background and
       accent, and lightens the primary for text. *@
    <style>
        :root {
            --teal: @Helpdesk.Branding.PrimaryColor;
            --teal-dark: @Helpdesk.Branding.PrimaryColor;
            --paper: @Helpdesk.Branding.BackgroundColor;
            --accent: @Helpdesk.Branding.AccentColor;
        }
    </style>
    <script src="~/js/actions.js" asp-append-version="true" defer></script>
    <script src="~/js/layout.js" asp-append-version="true" defer></script>
    <script src="~/js/picker.js" asp-append-version="true" defer></script>
    <script src="~/js/help.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    @* The school's logo when one has been uploaded (Settings → Branding), otherwise the initials badge. The brand name
       stays beside it as text, so the logo's alt text is empty rather than repeating it. *@
    <header class="topbar"><div class="brand">@if (Helpdesk.LogoVersion is { } logoVersion) { <img class="brand-logo" src="@Url.Content("~/branding/logo")?v=@logoVersion" alt="" /> } else { <span class="brand-mark">EH</span> }<span>@Helpdesk.Branding.BrandName</span></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Outside the site menu, so it stays in the bar on a phone. One form, a button per choice, so it works without
           JavaScript. *@
        @if (deskSwitch is not null)
        {
            <details class="nav-menu desk-switch">
                <summary title="The desk you're working on: the ticket list, assets and daily sheet open on it" aria-label="Desk: @deskSwitch.Label">
                    <span class="desk-dot@(deskSwitch.Chosen is null ? " desk-dot-many" : null)" style="@(deskSwitch.Chosen is { } chosenDesk ? $"--desk-color:{DeskColor(chosenDesk)}" : null)" aria-hidden="true"></span><span class="desk-switch-label">@deskSwitch.Label</span><span class="chev" aria-hidden="true">▾</span>
                </summary>
                <div class="nav-panel desk-switch-panel">
                    <form method="post" asp-page="/DeskSwitch" class="desk-switch-form">
                        <input type="hidden" name="returnUrl" value="@deskReturn" />
                        @if (deskSwitch.OffersMine) { <button type="submit" name="desk" value="" aria-current="@(deskSwitch.IsMine ? "true" : null)"><span class="desk-dot desk-dot-many" aria-hidden="true"></span>My desks</button><hr class="nav-rule" /> }
                        @foreach (var desk in deskSwitch.Choices)
                        {
                            <button type="submit" name="desk" value="@desk.Id" aria-current="@(deskSwitch.Chosen?.Id == desk.Id ? "true" : null)"><span class="desk-dot" style="--desk-color:@DeskColor(desk)" aria-hidden="true"></span>@desk.Name</button>
                        }
                        @if (deskSwitch.OffersAll) { <hr class="nav-rule" /><button type="submit" name="desk" value="@HelpdeskStore.AllDesksChoice" aria-current="@(deskSwitch.IsAll ? "true" : null)"><span class="desk-dot desk-dot-many" aria-hidden="true"></span>All desks</button> }
                    </form>
                </div>
            </details>
        }
        @* Below tablet width the nav and the account menu fold behind the Menu button (wwwroot/js/layout.js). On a wider
           screen the wrapper is display:contents, so they sit in the bar as they always have. *@
        <div class="site-menu" id="site-menu">
        <nav>
            <a asp-page="/Index" class="@(navPath == "/" ? "active" : null)">Overview</a>
            @if (Can(Modules.Tickets)) { <a asp-page="/Jobs" class="@(NavOn("/Jobs", "/Job", "/NewTicket", "/QuickLog", "/DailySheet") ? "active" : null)">Tickets</a> }
            @if (canRounds) { <a asp-page="/Rounds" class="@(NavOn("/Rounds", "/RoundSheet") ? "active" : null)">Rounds</a> }
            @if (Can(Modules.Projects) && On(DeskAreas.Projects)) { <a asp-page="/Projects" class="@(NavOn("/Projects", "/Project") ? "active" : null)">Projects</a> }
            @* HR groups People and Onboarding, but only for someone who can reach both. Someone with just one of them - the
               onboarding officer, say - gets a plain link rather than a menu with a single item in it. *@
            @if (canPeople && canOnboarding)
            {
                <details class="nav-menu">
                    <summary class="@(onPeople || onOnboarding ? "active" : null)">HR<span class="chev" aria-hidden="true">▾</span></summary>
                    <div class="nav-panel">
                        <a asp-page="/People">People</a>
                        <a asp-page="/Onboarding/Index">Onboarding</a>
                    </div>
                </details>
            }
            else if (canPeople) { <a asp-page="/People" class="@(onPeople ? "active" : null)">People</a> }
            else if (canOnboarding) { <a asp-page="/Onboarding/Index" class="@(onOnboarding ? "active" : null)">Onboarding</a> }
            @if (assetLinks.Count > 1)
            {
                <details class="nav-menu">
                    <summary class="@(onAssets ? "active" : null)">Assets<span class="chev" aria-hidden="true">▾</span></summary>
                    <div class="nav-panel">@foreach (var link in assetLinks) { <a href="@Url.Page(link.Page)">@link.Label</a> }</div>
                </details>
            }
            else if (assetLinks.Count == 1) { <a href="@Url.Page(assetLinks[0].Page)" class="@(onAssets ? "active" : null)">@assetLinks[0].Label</a> }
            @* In sections only when the registers are there too: Reports, then Compliance. *@
            @if (reportLinks.Count > 1)
            {
                var sectioned = reportLinks.Select(x => x.Section).Distinct().Count() > 1;
                <details class="nav-menu">
                    <summary class="@(onReports ? "active" : null)">Reports<span class="chev" aria-hidden="true">▾</span></summary>
                    <div class="nav-panel@(sectioned ? " nav-panel-sections" : null)">
                        @foreach (var group in reportLinks.GroupBy(x => x.Section))
                        {
                            if (sectioned) { <p class="nav-section">@group.Key</p> }
                            foreach (var link in group) { <a href="@Url.Page(link.Page)">@link.Label</a> }
                        }
                    </div>
                </details>
            }
            else if (reportLinks.Count == 1) { <a href="@Url.Page(reportLinks[0].Page)" class="@(onReports ? "active" : null)">@(reportLinks[0].Section == "Reports" ? "Reports" : reportLinks[0].Label)</a> }
        </nav>
        <details class="nav-menu user-menu">
            <summary><span class="user-name">@User.Identity!.Name</span><span class="chev" aria-hidden="true">▾</span></summary>
            <div class="nav-panel nav-panel-right">
                <a asp-page="/Help/Index">Help</a>
                <a asp-page="/ChangePassword">Change password</a>
                <a asp-page="/TwoFactor">Two-step sign-in</a>
                <a asp-page="/Notifications">Notifications</a>
                @if (Helpdesk.AllowRecoveryKeys) { <a asp-page="/RecoveryKey">Recovery key</a> }
                @* Signs the technician straight into the portal as themselves (Portal/Index OnPostTechnician). *@
                <a asp-page="/Portal/Index" asp-page-handler="Technician" target="_blank" rel="noopener">Open staff portal ↗</a>
                <form method="post" asp-page="/Logout"><button type="submit">Sign out</button></form>
            </div>
        </details>
        </div>
        @* To the desk being worked on: "Log a Site ticket" opens New ticket on Site. On My desks or All desks, a menu of
           those desks to pick from first. With one desk installed, as it always was. *@
        @if (Can(Modules.Tickets, ModulePermission.New))
        {
            var loggingDesks = Helpdesk.LoggingDesks(User);
            if (loggingDesks.Count > 1)
            {
                <details class="nav-menu header-job-menu">
                    <summary class="button button-primary header-job-button" aria-label="Log a ticket">@Icons.Plus<span class="header-job-text"> Log a ticket</span><span class="chev" aria-hidden="true">▾</span></summary>
                    <div class="nav-panel nav-panel-right">
                        @foreach (var desk in loggingDesks) { <a href="@Url.Page("/NewTicket", new { desk = desk.Name })"><span class="desk-dot" style="--desk-color:@DeskColor(desk)" aria-hidden="true"></span>@desk.Name</a> }
                    </div>
                </details>
            }
            else if (loggingDesks.Count == 1)
            {
                // "an IT ticket", "a Site ticket".
                var logLabel = $"Log {("AEIOU".Contains(char.ToUpperInvariant(loggingDesks[0].Name[0])) ? "an" : "a")} {loggingDesks[0].Name} ticket";
                <a class="button button-primary header-job-button" href="@Url.Page("/NewTicket", new { desk = loggingDesks[0].Name })" aria-label="@logLabel">@Icons.Plus<span class="header-job-text"> @logLabel</span></a>
            }
            else { <a class="button button-primary header-job-button" asp-page="/NewTicket" aria-label="Log a ticket">@Icons.Plus<span class="header-job-text"> Log a ticket</span></a> }
        }
        @* Outside the site menu, so it stays in the bar on a phone. The list is drawn here so it opens at once (and works
           without JavaScript); wwwroot/js/notifications.js keeps the badge live and refreshes the list when it opens. *@
        @if (bell is not null)
        {
            <details class="nav-menu notify-bell" id="notify-bell" data-inbox="@NotificationEndpoints.InboxPath" data-unread="@bell.Unread">
                <summary aria-label="@BellLabel(bell.Unread)" title="Notifications">
                    <svg class="notify-bell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
                    <span class="notify-badge" hidden="@(bell.Unread == 0)">@(bell.Unread > 99 ? "99+" : bell.Unread.ToString())</span>
                </summary>
                <div class="nav-panel nav-panel-right notify-panel">
                    <div class="notify-panel-head">
                        <strong>Notifications</strong>
                        <form method="post" asp-page="/Notifications" asp-page-handler="ReadAll" class="notify-readall" hidden="@(bell.Unread == 0)"><input type="hidden" name="returnUrl" value="@themeReturn" /><button type="submit">Mark all as read</button></form>
                    </div>
                    <ul class="notify-list" id="notify-bell-list">
                        @if (bell.Entries.Count == 0) { <li class="notify-empty">Nothing in the last 14 days.</li> }
                        else { <partial name="_NotificationItems" model="bell.Entries" /> }
                    </ul>
                    <a class="notify-panel-foot" asp-page="/Notifications">See all and notification settings</a>
                </div>
            </details>
        }
        @* Outside the site menu too, so help is one tap away on a phone. *@
        @if (NavOn("/Portal")) { <a class="header-help @(NavOn("/Portal/Help") ? "active" : null)" asp-page="/Portal/Help" title="Help with the staff portal" aria-label="Help with the staff portal"><span aria-hidden="true">?</span></a> }
        else { <a class="header-help @(onHelp ? "active" : null)" asp-page="/Help/Index" title="Help" aria-label="Help"><span aria-hidden="true">?</span></a> }
        @* Settings, or whichever settings pages this role can open (audit log, database, facilities setup). *@
        @if (settingsHref is not null && !NavOn("/Portal")) { <a class="header-help header-settings @(NavOn("/Settings") ? "active" : null)" href="@settingsHref" title="Settings" aria-label="Settings">@Icons.Gear</a> }
        <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu"><span aria-hidden="true">☰</span> Menu</button>
    }
    else if (NavOn("/Portal"))
    {
        @* Staff using the portal aren't signed in to the helpdesk; their help is the portal's own (Pages/Portal/Help). *@
        <a class="header-help header-help-portal @(NavOn("/Portal/Help") ? "active" : null)" asp-page="/Portal/Help" title="Help with the staff portal"><span aria-hidden="true">?</span> Help</a>
    }
    </header>
    <main class="@shellClass" id="main" tabindex="-1">
        @if (showWelcome)
        {
            <div class="help-welcome" role="region" aria-label="Welcome">
                <p><strong>New to EduHelpdesk?</strong> Start with <a asp-page="/Help/Index">Help</a>: there's a short Getting started guide for what you do. A <span class="help-tip-mark help-tip-sample" aria-hidden="true">?</span> beside a field explains it, and the one by a page's title opens its guide.</p>
                <form method="post" asp-page="/Help/Index" asp-page-handler="DismissWelcome"><input type="hidden" name="returnUrl" value="@themeReturn" /><button class="button button-secondary" type="submit">Got it</button></form>
            </div>
        }
        @if (pageHelp is not null) { <a class="page-help-link" id="page-help-link" asp-page="/Help/Article" asp-route-slug="@pageHelp.Slug" title="Help with this page: @pageHelp.Title"><span class="help-tip-mark" aria-hidden="true">?</span><span class="page-help-word"> Help</span></a> }
        @RenderBody()
    </main>
    <footer class="footer@(ViewData["Wide"] is true ? " shell-wide" : null)">
        <span>EduHelpdesk</span>
        @* Per browser, so a technician's dark laptop and the staffroom PC can each have their own. Pressing the one
           already chosen goes back to the school's default. *@
        <form method="post" asp-page="/Appearance" class="appearance-switch" aria-label="Appearance">
            <input type="hidden" name="returnUrl" value="@themeReturn" />
            <span>Appearance</span>
            @foreach (var option in Themes.All)
            {
                var pressed = chosenTheme == option;
                var schoolDefault = chosenTheme is null && option == theme;
                <button type="submit" name="theme" value="@(pressed ? "school" : Themes.Key(option))" aria-pressed="@(pressed ? "true" : "false")" class="@(schoolDefault ? "is-default" : null)"
                        title="@(pressed ? "Chosen on this device. Press again to go back to the school's default." : schoolDefault ? "The school's default - press to keep it on this device" : option == EduHelpdesk.Models.Appearance.Device ? "Follow this computer's own light or dark setting" : $"Use {Themes.Label(option).ToLowerInvariant()} on this device")">@Themes.Label(option)</button>
            }
        </form>
    </footer>
    @if (notifyAccount is not null)
    {
        @* Not deferred, so window.EduNotify exists by the time a page's own script (the Notifications page) runs. *@
        @* data-nudge-here: the pages where the "switch notifications on" bar may show (wwwroot/js/notifications.js). *@
        <div id="notify-root" hidden data-audience="@notifyAudience" data-account="@notifyAccount" data-poll="@NotificationEndpoints.PollPath"
             data-nudge-here="@(navPath is "/" or "/Portal" or "/Portal/Index" ? "true" : "false")"
             data-enabled="@(Helpdesk.NotificationsOpenFor(notifyAudience!) ? "true" : "false")" data-prompt="@(Helpdesk.NotificationSettings.Prompt ? "true" : "false")"
             data-settings="@Url.Page(notifyAudience == HelpdeskStore.PortalAudience ? "/Portal/Notifications" : "/Notifications")"
             data-icon="@(Helpdesk.LogoVersion is { } notifyLogo ? Url.Content("~/branding/logo") + "?v=" + notifyLogo : Url.Content("~/favicon.ico"))"></div>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
