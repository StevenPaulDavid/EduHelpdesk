@page
@model UserModel
@{
    ViewData["Title"] = $"Edit {Model.Person?.Name}";
    var linkedTickets = Model.Tickets.Where(x => x.RequesterId == Model.Person!.Id).Select(x => x.Number).ToHashSet();
}

<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / PERSON</p><h1>Edit person</h1><p class="hero-copy">Update the person details and choose which tickets belong to them.</p></div>
    <a class="button button-secondary" asp-page="/People">&lt;- Back to people</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }
@if (Model.Person!.AnonymisedAt is { } anonymisedAt)
{
    <div class="notice">Anonymised on @anonymisedAt.ToLocalTime().ToString("d MMMM yyyy") by the retention rules (Settings → Data retention). Their tickets, loans and history are kept, but under "@EduHelpdesk.Services.HelpdeskStore.AnonymisedName" rather than their name.</div>
}

@{ var held = Model.Holdings!; var leaver = !Model.Person.IsActive; }
<section class="panel leaver-check @(leaver && held.HoldsAnything ? "is-leaver" : "")" id="holdings">
    <div class="panel-heading">
        <div><p class="eyebrow">@(leaver ? "LEAVER CHECK" : "WHAT THEY HOLD")</p><h2>@(held.HoldsAnything ? leaver ? "Still to sort out" : "Held by " + Model.Person.Name : "Nothing outstanding")</h2></div>
        @if (leaver && Model.Person.LeftAt is { } leftAt) { <span class="badge">Left @leftAt.ToLocalTime().ToString("d MMM yyyy")</span> }
    </div>
    @if (!held.HoldsAnything)
    {
        <p class="muted">No assets, loan kits, open tickets or active projects@(leaver ? " - nothing is waiting on them leaving." : ".")</p>
    }
    else
    {
        if (leaver) { <p class="muted">They are marked inactive, so they can no longer use the staff portal. These are still recorded against them.</p> }
        if (held.Assets.Count > 0)
        {
            <h3 class="leaver-heading">Assets <span class="badge">@held.Assets.Count</span></h3>
            <ul class="leaver-list">
                @foreach (var asset in held.Assets)
                {
                    <li>@if (Model.CanOpenAssets) { <a asp-page="/Asset" asp-route-id="@asset.Id"><strong>@asset.AssetTag</strong></a> } else { <strong>@asset.AssetTag</strong> } <span class="muted">@asset.Make @asset.Model · @asset.Type · @asset.Status</span>@if (asset.LoanDueDate is { } due) { <text> </text><span class="badge @(due < EduHelpdesk.Services.AssetInsights.Today ? "badge-warning" : "")">On loan, due back @due.ToString("d MMM")</span> }</li>
                }
            </ul>
        }
        if (held.Kits.Count > 0)
        {
            <h3 class="leaver-heading">Loan kits <span class="badge">@held.Kits.Count</span></h3>
            <ul class="leaver-list">
                @foreach (var (kit, loan) in held.Kits)
                {
                    <li><strong>@kit.Name</strong> <span class="muted">issued @loan.IssuedAt.ToLocalTime().ToString("d MMM yyyy") · @kit.AssetIds.Count item@(kit.AssetIds.Count == 1 ? "" : "s")</span> <span class="badge @(loan.IsOverdue(EduHelpdesk.Services.AssetInsights.Today) ? "badge-warning" : "")">Due back @loan.DueBack.ToString("d MMM")</span></li>
                }
            </ul>
        }
        if (held.EquipmentCount > 0 && Model.CanBookBackIn)
        {
            <form method="post" asp-page-handler="BookBackIn" asp-route-id="@Model.Person.Id" class="leaver-action" data-confirm="Book all @held.EquipmentCount item(s) back in from @Model.Person.Name? Assets in use or on loan go back to stock.">
                <button class="button button-primary" type="submit">Book everything back in</button>
                <span class="muted">Ends their loans and takes the assets off them. Anything in use or on loan goes back to stock; anything marked in repair or lost keeps that status.</span>
            </form>
        }
        if (held.OpenTickets.Count > 0)
        {
            <h3 class="leaver-heading">Open tickets they raised <span class="badge">@held.OpenTickets.Count</span></h3>
            <p class="muted">@(leaver ? "They can't see replies any more. Close these, or pass them to whoever took over." : "")@if (Model.CanSeeTickets) { <text> </text><a asp-page="/Jobs" asp-route-requester="@Model.Person.Id">Open them in the ticket list</a> }</p>
        }
        if (held.ActiveProjects.Count > 0)
        {
            <h3 class="leaver-heading">Active projects they asked for <span class="badge">@held.ActiveProjects.Count</span></h3>
            <ul class="leaver-list">
                @foreach (var project in held.ActiveProjects)
                {
                    <li>@if (Model.CanOpenProjects) { <a asp-page="/Project" asp-route-number="@project.Number"><strong>@project.Reference</strong></a> } else { <strong>@project.Reference</strong> } @project.Title <span class="muted">· @project.Status</span></li>
                }
            </ul>
        }
        if (held.OnlyProjectLead)
        {
            <p class="notice notice-warning leaver-lead"><strong>They are the only project lead.</strong> @(leaver ? "Nobody can assign new projects from the staff portal until someone else is made project lead." : "If they leave, nobody else can assign projects from the staff portal.")</p>
        }
    }
</section>

@if (Model.CanEdit && Model.Person.AnonymisedAt is null)
{
    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">STAFF PORTAL</p><h2>Signing in</h2></div></div>
        <p class="muted">@(Model.Person.PasswordHash is null ? "They have no portal password yet." : Model.Person.RequirePasswordChange ? "They have a temporary password, and will choose their own when they next sign in." : "They sign in with a password they have chosen or been given.") The quick start guide tells them where to go and how to report a problem; printed within an hour of setting a password, it includes it.</p>
        <div class="button-row">
            <a class="button button-secondary" asp-page="/People/QuickStart" asp-route-user="@Model.Person.Id">Print quick start guide</a>
            <form method="post" asp-page-handler="TemporaryPassword" asp-route-id="@Model.Person.Id" data-confirm="@(Model.Person.PasswordHash is null ? $"Give {Model.Person.Name} a temporary password? They'll choose their own when they first sign in." : $"Give {Model.Person.Name} a new temporary password? Their current password stops working, and they'll choose their own when they next sign in.")">
                <button class="button button-secondary">Give them a temporary password</button>
            </form>
        </div>
    </section>
}
@if (Model.CanEdit)
{
    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">THEIR DATA</p><h2>Subject access</h2></div></div>
        <p class="muted">A zip of everything the helpdesk holds about them, for a subject access request: their record, the tickets they raised with every update and internal note, attached files, assets and loans, projects, other tickets that mention their name or email, and the audit log lines about them. A README explains what to check before it is sent. Each download is recorded in the audit log.</p>
        <a class="button button-secondary" asp-page="/User" asp-page-handler="Export" asp-route-id="@Model.Person.Id">Download their data (.zip)</a>
    </section>
}

<form method="post" asp-page-handler="Save">
    <input type="hidden" name="id" value="@Model.Person!.Id" />
    <div class="grid two asset-edit-grid">
        <section class="panel">
            <div class="panel-heading"><div><p class="eyebrow">PERSON DETAILS</p><h2>@Model.Person.Name</h2></div></div>
            <div class="form-grid">
                <label>Name<input name="name" value="@Model.Person.Name" required /></label>
                <label>Email<input name="email" type="email" value="@Model.Person.Email" required /></label>
                <label>Department<select name="department"><option value="">Unassigned</option>@foreach (var department in Model.Departments) { <option value="@department" selected="@(string.Equals(department, Model.Person.Department, StringComparison.OrdinalIgnoreCase))">@department</option> }</select></label>
                <label>Location<select name="location"><option value="">Unassigned</option>@foreach (var location in Model.Locations) { <option value="@location" selected="@(string.Equals(location, Model.Person.Location, StringComparison.OrdinalIgnoreCase))">@location</option> }</select></label>
                <label>Active account?<select name="active"><option value="true" selected="@Model.Person.IsActive">Active - can sign in to the staff portal</option><option value="false" selected="@(!Model.Person.IsActive)">Inactive - blocked from the staff portal</option></select></label>
                <label>Set a password<input name="password" type="password" placeholder="Leave blank to keep the current password" autocomplete="new-password" maxlength="@EduHelpdesk.Services.PasswordRules.MaximumLength" /><small class="muted">For the staff portal. At least @EduHelpdesk.Services.PasswordRules.MinimumLength characters, which they keep until they choose to change it - for one they must change, use Give them a temporary password above.</small></label>
                <label class="toggle-label"><input type="checkbox" name="canRaiseProjects" value="true" checked="@Model.Person.CanRaiseProjects" /> Can raise projects <small class="muted">For line managers and SLT: lets them ask IT to source and quote for purchases from the staff portal.</small></label>
                <label class="toggle-label"><input type="checkbox" name="isProjectLead" value="true" checked="@Model.Person.IsProjectLead" /> Project lead <small class="muted">Confirms each project's priority and assigns the technician, from the staff portal. Can also raise projects.</small></label>
            </div>
        </section>
        <section class="panel">
            <div class="panel-heading"><div><p class="eyebrow">LINKED TICKETS</p><h2>Select tickets</h2></div><span class="badge">@linkedTickets.Count linked</span></div>
            <p class="muted">Selecting a ticket makes this person its requester.</p>
            <div class="asset-job-list">
                @foreach (var ticket in Model.Tickets)
                {
                    <div class="asset-job-option"><input type="checkbox" name="selectedNumbers" value="@ticket.Number" checked="@linkedTickets.Contains(ticket.Number)" /><a href="/Job?number=@ticket.Number"><span><strong>#@ticket.Number - @ticket.Title</strong><small>@ticket.Status - @ticket.Priority - @ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></span></a></div>
                }
                @if (Model.Tickets.Count == 0) { <p class="empty">No tickets have been logged yet.</p> }
            </div>
        </section>
    </div>
    <button class="button button-primary" type="submit">Save person and tickets</button>
</form>
