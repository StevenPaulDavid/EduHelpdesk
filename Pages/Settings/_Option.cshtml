@model EduHelpdesk.Pages.Settings.OptionModel
@{ViewData["Title"]="Manage "+Model.Kind;}<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="button button-secondary" asp-page="/Settings">← Settings</a></div>
@if(TempData["Message"] is string message){<div class="notice">@message</div>}<section class="panel"><form method="post" class="settings-form"><input type="hidden" name="kind" value="@Model.Kind"/><label>Add value<input name="value" required/></label><button class="button button-primary">Add</button></form><div class="directory-list">@foreach(var value in Model.Values){<div class="directory-row"><strong>@value</strong><div class="row-actions"><form method="post"><input type="hidden" name="kind" value="@Model.Kind"/><input type="hidden" name="currentValue" value="@value"/><input name="value" value="@value" required/><button class="button button-secondary">Save</button></form><form method="post" asp-page-handler="Delete"><input type="hidden" name="kind" value="@Model.Kind"/><input type="hidden" name="value" value="@value"/><button class="button button-danger">Delete</button></form></div></div>}</div></section>
