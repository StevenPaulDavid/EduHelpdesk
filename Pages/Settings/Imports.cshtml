@page
@model EduHelpdesk.Pages.Settings.ImportsModel
@{ ViewData["Title"] = "Imports"; }
<div class="page-heading"><div><p class="eyebrow">SETTINGS / PEOPLE &amp; PLACES</p><h1>Imports</h1><p class="hero-copy">Bring requesters, staff accounts and option lists in from CSV files, rather than typing them in one at a time.</p></div><a class="button button-secondary" asp-page="/Settings">← Settings</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<section class="panel">
    <div class="panel-heading"><h2>Requesters and staff accounts</h2></div>
    <p class="muted">Assets are imported on their own page, with column matching and a preview: <a asp-page="/Assets/Import">Import assets from a CSV file</a>.</p>
    <p class="muted">Users CSV columns, in order, with a header row: <code>Name, Email, Department, Location</code></p>
    <form method="post" enctype="multipart/form-data" asp-page-handler="ImportUsers" class="import-row"><label>Users CSV<input asp-for="UserCsv" type="file" accept=".csv" /></label><button class="button button-primary">Import users</button><a class="button button-secondary" asp-page="/Settings/Imports" asp-page-handler="UserImportTemplate">Download template</a></form>
    <p class="muted">Technicians CSV columns, in order, with a header row: <code>Name, Email, Team, Role</code>. Role is optional and defaults to Technician; it must match the name of an existing role (see the Roles tab on the People page). Imported accounts have no password until someone sets one from the People page.</p>
    <form method="post" enctype="multipart/form-data" asp-page-handler="ImportTechnicians" class="import-row"><label>Technicians CSV<input asp-for="TechnicianCsv" type="file" accept=".csv" /></label><button class="button button-primary">Import technicians</button><a class="button button-secondary" asp-page="/Settings/Imports" asp-page-handler="TechnicianImportTemplate">Download template</a></form>
</section>

<section class="panel">
    <div class="panel-heading"><h2>Option lists</h2></div>
    <p class="muted">List CSVs have one column, <code>Name</code>, with a header row and one value per row. Asset models also take an optional second column, <code>Make</code>, to link each model to its make; a make that doesn't exist yet is created, and a model that already exists without a make is linked to it. Blank rows and values that already exist are skipped. Each template includes example rows, so replace them with your own before importing.</p>
    @foreach (var list in ImportsModel.ImportLists)
    {
        <form method="post" enctype="multipart/form-data" asp-page-handler="ImportOptions" class="import-row"><input type="hidden" name="kind" value="@list.Kind" /><label>@list.Label CSV<input type="file" name="optionCsv" accept=".csv" required /></label><button class="button button-primary">Import @list.Label.ToLowerInvariant()</button><a class="button button-secondary" asp-page="/Settings/Imports" asp-page-handler="OptionImportTemplate" asp-route-kind="@list.Kind">Download template</a></form>
    }
</section>
