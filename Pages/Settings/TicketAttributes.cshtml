@page
@model EduHelpdesk.Pages.Settings.TicketAttributesModel
@{ ViewData["Title"] = "Ticket custom attributes"; }
<div class="page-heading"><h1>Ticket custom attributes</h1><a class="button button-secondary" asp-page="/Settings">← Settings</a></div>
@if (TempData["Message"] is string message) { <div class="notice">@message</div> }
<section class="panel">
    <form method="post" class="settings-form">
        <label>Name<input name="name" required /></label>
        <label>Field type<select name="fieldType"><option value="single-line">Single-line text</option><option value="multi-line">Multi-line text</option><option value="dropdown">Dropdown</option><option value="checkbox">Checkbox</option></select></label>
        <label>Dropdown choices<input name="choices" placeholder="One, Two, Three" /></label>
        <div class="checkbox-grid">
            <div><p class="eyebrow">Applies to categories</p>@foreach (var category in Model.Categories) { <label class="toggle-label"><input type="checkbox" name="categories" value="@category" /> @category</label> }@if (Model.Categories.Count == 0) { <p class="empty">No categories configured yet.</p> }</div>
        </div>
        <small class="muted">Tick every category this attribute applies to. Leave all unticked for attributes every ticket should have.</small>
        <button class="button button-primary" type="submit">Add attribute</button>
    </form>
</section>
<section class="panel">
    <div class="directory-list">
        @foreach (var item in Model.Attributes)
        {
            <div class="directory-row">
                <div class="attribute-row-main">
                    <strong>@item.Name</strong>
                    <span class="muted">@(item.Categories.Count > 0 ? string.Join(", ", item.Categories.OrderBy(x => x)) : "All categories") · @item.FieldType</span>
                    <details>
                        <summary>Change categories</summary>
                        <form method="post" asp-page-handler="SaveScope" class="settings-form attribute-scope-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <div class="checkbox-grid">
                                <div>@foreach (var category in Model.Categories) { <label class="toggle-label"><input type="checkbox" name="categories" value="@category" checked="@item.Categories.Contains(category, StringComparer.OrdinalIgnoreCase)" /> @category</label> }</div>
                            </div>
                            <small class="muted">Leave all unticked to apply to every category.</small>
                            <button class="button button-primary" type="submit">Save categories</button>
                        </form>
                    </details>
                </div>
                <form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@item.Id" /><button class="button button-danger">Delete</button></form>
            </div>
        }
        @if (Model.Attributes.Count == 0) { <p class="empty">No ticket custom attributes have been added yet.</p> }
    </div>
</section>
