@page
@model EduHelpdesk.Pages.Settings.AuditModel
@{ ViewData["Title"] = "System audit"; }
<div class="page-heading">
    <div><p class="eyebrow">EDUHELPDESK / SETTINGS</p><h1>System audit</h1><p class="hero-copy">Every change made in the helpdesk, newest first. Filter by area, action, date or search text.</p></div>
    <a class="button button-secondary" asp-page="/Settings">← Settings</a>
</div>
<section class="panel">
    <form method="get" class="audit-filters">
        <label>Area<select name="section"><option value="">All areas</option>@foreach (var area in AuditModel.Areas) { <option value="@area" selected="@string.Equals(area, Model.Section, StringComparison.OrdinalIgnoreCase)">@area</option> }</select></label>
        <label>Action<select name="act"><option value="">Any action</option>@foreach (var action in Model.Actions) { <option value="@action" selected="@string.Equals(action, Model.ActionFilter, StringComparison.OrdinalIgnoreCase)">@action</option> }</select></label>
        <label>From<input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" /></label>
        <label>To<input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" /></label>
        <label class="audit-search">Search<input type="search" name="q" value="@Model.Search" placeholder="Name, ticket number, or anything in the details" /></label>
        <div class="audit-filter-actions"><button class="button button-primary" type="submit">Apply filters</button><a class="button button-secondary" asp-page="/Settings/Audit">Clear</a></div>
    </form>
</section>
<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">AUDIT LOG</p><h2>@(Model.IsFiltered ? $"{Model.MatchCount} of {Model.TotalEvents} events" : $"{Model.TotalEvents} events")</h2></div><span class="badge">Page @Model.PageNumber of @Model.TotalPages</span></div>
    <div class="table-wrap"><table><thead><tr><th>When</th><th>Area</th><th>Item</th><th>Action</th><th>Details</th></tr></thead><tbody>
    @foreach (var entry in Model.Entries)
    {
        var link = Model.LinkFor(entry);
        <tr>
            <td class="audit-when">@entry.At.ToLocalTime().ToString("dd MMM yyyy, HH:mm:ss")</td>
            <td><span class="badge">@entry.Area</span></td>
            <td>@if (link is not null) { <a href="@link">@entry.Entity</a> } else { @entry.Entity }</td>
            <td>@entry.Action</td>
            <td class="audit-details">@entry.Details</td>
        </tr>
    }
    @if (Model.Entries.Count == 0) { <tr><td colspan="5" class="empty">@(Model.IsFiltered ? "No events match these filters." : "Nothing has been recorded yet.")</td></tr> }
    </tbody></table></div>
    @if (Model.TotalPages > 1)
    {
        <div class="audit-pager">
            @if (Model.PageNumber > 1) { <a class="button button-secondary" asp-page="/Settings/Audit" asp-route-section="@Model.Section" asp-route-act="@Model.ActionFilter" asp-route-q="@Model.Search" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-p="@(Model.PageNumber - 1)">← Newer</a> }
            <span class="muted">Showing @((Model.PageNumber - 1) * AuditModel.PageSize + 1)–@Math.Min(Model.PageNumber * AuditModel.PageSize, Model.MatchCount) of @Model.MatchCount</span>
            @if (Model.PageNumber < Model.TotalPages) { <a class="button button-secondary" asp-page="/Settings/Audit" asp-route-section="@Model.Section" asp-route-act="@Model.ActionFilter" asp-route-q="@Model.Search" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-p="@(Model.PageNumber + 1)">Older →</a> }
        </div>
    }
</section>
