@page
@model EduHelpdesk.Pages.Settings.ResetModel
@{ ViewData["Title"] = "Go live & reset"; }
<div class="page-heading"><div><p class="eyebrow">SETTINGS / SYSTEM</p><h1>Go live &amp; reset</h1><p class="hero-copy">Remove the worked example a new install starts with, or put the whole helpdesk back to how a new install starts.</p></div><a class="button button-secondary" asp-page="/Settings">← Settings</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<section class="panel">
    <div class="panel-heading"><h2>Go live</h2>@if (Model.HasDemoData) { <span class="badge">Demo data present</span> } else { <span class="badge">Live</span> }</div>
    @if (Model.HasDemoData)
    {
        <p class="muted">This system started with a worked example so it could be shown to people before it was used for real. Going live removes those records and leaves you with an empty helpdesk to put your own data into. Anything you have added yourself is left alone, and so are the option list values the example needed (departments, makes, part categories) - delete any of those you don't want from their own Settings pages.</p>
        <p class="muted import-hint">Check the list first: if you have renamed one of these into a real record, it will still be removed.</p>
        <div class="table-wrap"><table><thead><tr><th>Type</th><th>Record</th></tr></thead><tbody>
        @foreach (var item in Model.DemoRecords) { <tr><td>@item.Kind</td><td>@item.Name</td></tr> }
        </tbody></table></div>
        <form method="post" asp-page-handler="RemoveDemoData" data-confirm="Remove the demo records and go live? This cannot be undone.">
            <button class="button button-danger" type="submit">Go live - remove demo data</button>
        </form>
    }
    else
    {
        <p class="muted">The demo records have gone, so there is nothing to remove.</p>
    }
</section>

<section class="panel danger-zone">
    <div class="panel-heading"><h2>Reset to factory settings</h2></div>
    <p>This erases <strong>everything</strong> and puts the helpdesk back to how a new install starts: all tickets, comments and history, assets and loans, users, technicians, suppliers and parts, projects, SLAs, custom attributes, every list you added to (teams, departments, locations, asset types, makes, models, statuses, categories and priorities), the print template, attached files, and your branding and review settings. Only the small demo set that a new install comes with is left. <strong>This cannot be undone</strong> unless you keep the backup below.</p>
    <form method="post" asp-page-handler="ResetFactory" class="settings-form" data-confirm="Erase all helpdesk data and reset to factory settings? This cannot be undone.">
        <label class="toggle-label"><input type="checkbox" name="keepBackup" value="true" checked /> Save a backup copy of the current data first</label>
        <p class="muted import-hint">Saved as a backup zip in <code>@Model.BackupFolder</code>, restored the same way as any other backup (see <a asp-page="/Settings/Backups">Backups &amp; data</a>). Untick this to leave no new copy behind - the nightly backups already in that folder are not deleted by a reset, and age out on their own.</p>
        <label class="toggle-label"><input type="checkbox" name="eraseAudit" value="true" /> Also erase the audit log</label>
        <p class="muted import-hint">Off by default: the audit log is kept, and the reset is recorded in it.</p>
        <label class="field-narrow">Type <strong>DELETE</strong> to confirm<input name="confirmation" autocomplete="off" required /></label>
        <button class="button button-danger" type="submit">Erase everything and reset</button>
    </form>
</section>
