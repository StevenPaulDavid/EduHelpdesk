@page
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Settings.SchoolDayModel
@{ ViewData["Title"] = "School day and periods"; }
<div class="page-heading"><div><p class="eyebrow">SETTINGS / TICKETS</p><h1>School day and periods</h1><p class="hero-copy">SLAs measured in work days or periods count against these, so a ticket logged on Friday afternoon isn't overdue by Sunday.</p></div><a class="button button-secondary" asp-page="/Settings">← Settings</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">SCHOOL WEEK</p><h2>School days</h2></div></div>
    <p class="muted">Work-day and period SLAs skip any day that isn't ticked. Holidays and INSET days aren't taken into account yet, so tickets logged just before a break will show as overdue over it.</p>
    <form method="post" asp-page-handler="Days" class="settings-form">
        <div class="school-days">
            @foreach (var day in EduHelpdesk.Pages.Settings.SchoolDayModel.Week)
            {
                <label class="toggle-label"><input type="checkbox" name="days" value="@day" checked="@Model.SchoolDays.Contains(day)" /> @day</label>
            }
        </div>
        <div><button class="button button-primary">Save school days</button></div>
    </form>
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">TIMETABLE</p><h2>Periods</h2></div><span class="badge">@Model.Rows.Count(x => x.Name.Length > 0)</span></div>
    <p class="muted">The same timings are used on every school day. Leave gaps for break, lunch and after school - they don't count. A period SLA starts counting from the next period to begin, so the one already under way when a ticket is logged doesn't count.</p>
    @if (Model.Error is not null) { <div class="notice notice-warning">@Model.Error</div> }
    <form method="post" asp-page-handler="Periods" id="periods-form">
        <div class="table-wrap"><table class="period-table"><thead><tr><th>Name</th><th>Starts</th><th>Ends</th><th><span class="visually-hidden">Remove</span></th></tr></thead>
        <tbody id="period-rows">
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td><input name="name" value="@row.Name" aria-label="Period name" maxlength="40" /></td>
                    <td><input name="start" type="time" value="@row.Start" aria-label="Start time" /></td>
                    <td><input name="end" type="time" value="@row.End" aria-label="End time" /></td>
                    <td><button type="button" class="icon-button delete-icon period-remove" title="Remove period" aria-label="Remove @row.Name">♜</button></td>
                </tr>
            }
            @* A spare row, so a period can be added even without JavaScript. Blank rows are ignored when saving. *@
            <tr class="period-spare">
                <td><input name="name" placeholder="e.g. Period @(Model.Rows.Count + 1)" aria-label="New period name" maxlength="40" /></td>
                <td><input name="start" type="time" aria-label="New period start time" /></td>
                <td><input name="end" type="time" aria-label="New period end time" /></td>
                <td></td>
            </tr>
        </tbody></table></div>
        <div class="heading-actions form-actions period-actions">
            <button type="button" class="button button-secondary" id="period-add">＋ Add another period</button>
            <button class="button button-primary">Save periods</button>
        </div>
    </form>
    @if (Model.PeriodSlas.Count > 0)
    {
        <p class="muted">Used by: @string.Join(", ", Model.PeriodSlas.Select(x => $"{x.Name} ({SlaUnits.Describe(x)})")). Existing tickets keep the due dates they already have.</p>
    }
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">CHECK</p><h2>If a ticket were logged now</h2></div></div>
    <p class="muted">Logged @EduHelpdesk.Pages.Settings.SchoolDayModel.Format(Model.Now), using the saved settings above:</p>
    <dl class="detail-list">
        @foreach (var example in Model.Examples)
        {
            <dt>@example.Rule</dt><dd>@(example.Due is null ? "Can't be worked out - add some periods first" : $"Due {EduHelpdesk.Pages.Settings.SchoolDayModel.Format(example.Due)}")</dd>
        }
    </dl>
</section>

@section Scripts {
<script>
(function () {
    const rows = document.getElementById("period-rows");
    // Removing a row just takes it out of the form; nothing changes until Save periods.
    rows.addEventListener("click", e => {
        const button = e.target.closest(".period-remove");
        if (button) button.closest("tr").remove();
    });
    document.getElementById("period-add").addEventListener("click", () => {
        const spare = rows.querySelector(".period-spare");
        const row = spare.cloneNode(true);
        row.classList.remove("period-spare");
        row.querySelectorAll("input").forEach(input => input.value = "");
        row.lastElementChild.innerHTML = '<button type="button" class="icon-button delete-icon period-remove" title="Remove period" aria-label="Remove period">♜</button>';
        rows.insertBefore(row, spare);
        row.querySelector("input").focus();
    });
})();
</script>
}
