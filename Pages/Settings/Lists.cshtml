@page "{group?}"
@model EduHelpdesk.Pages.Settings.OptionModel
@{
    // Settings → Lists: the plain lists the dropdowns offer (SettingsMenu.Lists). Each group of them sits in its own
    // section of the settings menu - /Settings/Lists/assets is the asset, part and loan lists - with a tab per list
    // when there is more than one. The tab is ?kind=; the add, rename and delete forms are the shared option list's
    // (_Option, OptionModel), which post back to /Settings/Lists?kind=.
    var current = SettingsMenu.FindList(Model.Kind) ?? SettingsMenu.Lists[0];
    var group = SettingsMenu.FindListGroup(current.Group)!;
    var tabs = SettingsMenu.Lists.Where(x => x.Group == group.Key).ToList();
    ViewData["Title"] = tabs.Count == 1 ? group.Title : $"{current.Title} - {group.Title}";
    ViewData["ListTitle"] = current.Title;
    ViewData["ListDescription"] = current.Description;
}
<div class="page-heading">
    <div><h1>@group.Title</h1><p class="hero-copy">@group.Description Rename one with the pencil; the bin takes it off the list.</p></div>
</div>
@if (tabs.Count > 1)
{
    <nav class="queue-tabs list-tabs" aria-label="@group.Title">
        @foreach (var item in tabs) { <a class="queue-tab @(item == current ? "active" : null)" href="@Url.Content("~" + SettingsMenu.ListUrl(item.Kind))" aria-current="@(item == current ? "page" : null)">@item.Title</a> }
    </nav>
}
<partial name="_Option" model="Model" />
