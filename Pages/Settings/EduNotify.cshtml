@page
@model EduHelpdesk.Pages.Settings.EduNotifyModel
@inject EduHelpdesk.Services.HelpdeskStore Helpdesk
@using EduHelpdesk.Services
@{
    ViewData["Title"] = "EduNotify";
    var link = Model.Link;
    var health = Model.Health;
    string When(DateTime? at) => at is { } t ? t.ToLocalTime().ToString("ddd d MMM, HH:mm") : "never";
}
<div class="page-heading"><div><h1>EduNotify</h1><p class="hero-copy">EduNotify puts messages on staff PCs. Linked to it, the helpdesk can show outage notices from tickets, pop up ticket news for the person it's about, alert technicians, and take <strong>Call technician</strong> requests from teachers' PCs as tickets.</p></div></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice@(Model.Problem ? " notice-warning" : "")" style="white-space:pre-line">@Model.Message</div> }

@if (!Model.Linked)
{
    @if (Model.RepairNeeded)
    {
        <div class="notice notice-warning">Linking to EduNotify is now one pairing code. The link set up by hand before this version was cleared: pair again below. Your pop-up, technician call and desk settings were kept.</div>
    }
    <section class="panel" id="link">
        <div class="panel-heading"><h2>Pair with EduNotify</h2><span class="badge">Not linked</span></div>
        <ol class="muted">
            <li>In EduNotify, open <strong>Settings → EduHelpdesk</strong> and press <strong>Pair with EduHelpdesk</strong>. It shows a code such as <code>4F7-K2Q</code>.</li>
            <li>Enter EduNotify's address and that code here, check the other two boxes, and press <strong>Pair</strong>.</li>
        </ol>
        <form method="post" asp-page-handler="Pair" class="settings-form">
            <label>EduNotify's address<input name="notifyAddress" type="text" autocomplete="off" spellcheck="false" maxlength="500" value="@Model.Settings.Address" placeholder="http://edunotify.school.local:5080" required /></label>
            <label>Pairing code<input name="code" type="text" autocomplete="off" spellcheck="false" maxlength="20" placeholder="4F7-K2Q" style="text-transform:uppercase;letter-spacing:.1em" required /></label>
            <label>Staff email domain<input name="emailDomain" type="text" autocomplete="off" spellcheck="false" maxlength="200" value="@Model.GuessedDomain" placeholder="school.org.uk" required /></label>
            <small class="muted">The part after the @@ in staff emails. A person's email there is taken as their Windows login (<code>jsmith@@@(Model.GuessedDomain.Length > 0 ? Model.GuessedDomain : "school.org.uk")</code> is <code>jsmith</code>), so pop-ups find them and the first technician to press On my way is assigned.</small>
            <label>EduNotify reaches the helpdesk at<input name="reachUsAt" type="text" autocomplete="off" spellcheck="false" maxlength="500" value="@Model.ReachUsAt" required /></label>
            <small class="muted">EduNotify's server must be able to open this address. Pairing checks it can, both ways, before anything is saved.</small>
            <div><button class="button button-primary">Pair</button></div>
        </form>
        <p class="muted">Pairing swaps the keys and addresses for you, and EduNotify makes the templates the helpdesk sends with. Technician calls are accepted straight away (to <strong>@(link.FallbackCategory.Length > 0 ? link.FallbackCategory : "the IT desk's general category")</strong>); every pop-up starts off.</p>
    </section>
}
else
{
    <section class="panel" id="link">
        <div class="panel-heading"><h2>Link and tests</h2><span class="badge">Linked</span></div>
        <div class="table-wrap"><table class="stack-table"><tbody>
            <tr><th>Linked to</th><td>@Model.Settings.Address@(health.PairedAt is { } paired ? $", since {When(paired)}" : "")@(health.PairedBy.Length > 0 ? $" by {health.PairedBy}" : "")</td></tr>
            <tr><th>Helpdesk → EduNotify</th><td>@if (health.OutAt is { } outAt) { <span class="badge@(health.OutOk ? "" : " badge-warning")">@(health.OutOk ? "OK" : "Failed")</span> @When(outAt) <span class="muted">· @health.OutMessage</span> } else { <span class="muted">No calls yet</span> }</td></tr>
            <tr><th>EduNotify → Helpdesk</th><td>@if (health.InAt is { } inAt) { <span class="badge">OK</span> @When(inAt) } else { <span class="muted">No calls yet</span> }</td></tr>
        </tbody></table></div>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem">
            <form method="post" asp-page-handler="TestLink"><button class="button button-secondary">Test the link</button></form>
            <form method="post" asp-page-handler="TestPopup"><button class="button button-secondary">Pop-up to my PC</button></form>
            <form method="post" asp-page-handler="TestCall"><button class="button button-secondary">Test technician call</button></form>
            <form method="post" asp-page-handler="TestDesks"><button class="button button-secondary">Desk PCs test</button></form>
        </div>
        <small class="muted"><strong>Pop-up to my PC</strong> shows one on whichever PC you're logged on to. <strong>Test technician call</strong> raises a TEST ticket through EduNotify, assigns it to you, resolves it and removes it; nothing shows on anyone's PC. <strong>Desk PCs test</strong> checks each desk's PCs can be reached, silently (takes a few seconds).</small>
    </section>

    <section class="panel" id="events">
        <div class="panel-heading"><h2>Pop-ups and alerts</h2></div>
        <p class="muted">Each says only the ticket number and what happened (e.g. <em>IT-123: resolved</em>), never the ticket's words, because classroom screens get projected, with an <strong>Open ticket</strong> button once the helpdesk's address is set under Sign-in security. A newer one about the same ticket replaces the older; someone who isn't logged on doesn't get it.</p>
        <form method="post" asp-page-handler="SaveEvents">
            @foreach (var (heading, keys) in new[] { ("To the person who logged the ticket", HelpdeskStore.EduNotifyEvents.Requester), ("To technicians (the desk's PCs when nobody is assigned)", HelpdeskStore.EduNotifyEvents.Technician) })
            {
                <h3>@heading</h3>
                @foreach (var key in keys)
                {
                    var rule = link.RuleFor(key);
                    <div style="margin-bottom:.5rem">
                        <label class="toggle-label"><input type="checkbox" name="on-@key" value="true" checked="@rule.Enabled" /> <strong>@HelpdeskStore.EduNotifyEvents.Label(key)</strong> <span class="muted">- @HelpdeskStore.EduNotifyEvents.When(key)</span></label>
                        @if (HelpdeskStore.EduNotifyEvents.HasMinutes(key)) { <label class="muted" style="margin-left:1.6rem">Minutes before the due time <input name="minutes-@key" type="number" min="5" max="1440" value="@rule.Minutes" style="width:6rem" /></label> }
                        @if (Model.HasSeveralDesks && HelpdeskStore.EduNotifyEvents.HasDesks(key))
                        {
                            <div style="margin-left:1.6rem" class="muted">Desks: @foreach (var desk in Model.Desks) { <label class="toggle-label" style="display:inline-flex;margin-right:.75rem"><input type="checkbox" name="desks-@key" value="@desk.Id" checked="@rule.DeskIds.Contains(desk.Id)" /> @desk.Name</label> } <small>(none ticked: every desk)</small></div>
                        }
                    </div>
                }
            }
            <label>Take pop-ups down after (hours) <input name="takeDownHours" type="number" min="1" max="@HelpdeskStore.MaxTakeDownHours" value="@link.TakeDownHours" style="width:6rem" /></label>
            <div><button class="button button-primary">Save the pop-ups</button></div>
        </form>
    </section>

    <section class="panel" id="calls">
        <div class="panel-heading"><h2>Technician calls</h2>@if (link.AcceptCalls) { <span class="badge">Accepting</span> } else { <span class="badge">Off</span> }</div>
        <p class="muted">A teacher's <strong>Call technician</strong> in EduNotify alerts the technicians' PCs and raises a ticket here. These tickets never send the ping or the <em>Ticket logged</em> pop-up.</p>
        <form method="post" asp-page-handler="SaveCalls" class="settings-form">
            <label class="toggle-label"><input type="checkbox" name="acceptCalls" value="true" checked="@link.AcceptCalls" /> Accept calls from EduNotify (off: calls still alert the technicians, but make no ticket)</label>
            <label class="toggle-label"><input type="checkbox" name="assignOnMyWay" value="true" checked="@link.AssignOnMyWay" /> Assign the ticket to whoever presses On my way first</label>
            <label class="toggle-label"><input type="checkbox" name="closeOnResolve" value="true" checked="@link.CloseOnResolve" /> Take the call's alert down when the ticket is resolved</label>
            <label>Category<select name="fallbackCategory"><option value="">Choose…</option>@foreach (var c in Model.Categories) { <option selected="@(c == link.FallbackCategory)">@c</option> }</select></label>
            <label>Priority<select name="fallbackPriority"><option value="">Choose…</option>@foreach (var p in Model.Priorities) { <option selected="@(p == link.FallbackPriority)">@p</option> }</select></label>
            <label>Urgent priority<select name="fallbackUrgentPriority"><option value="">Same as priority</option>@foreach (var p in Model.Priorities) { <option selected="@(p == link.FallbackUrgentPriority)">@p</option> }</select></label>
            <details @(link.Reasons.Count > 0 ? "open" : null)>
                <summary>Give reasons their own category…</summary>
                @if (Model.ReasonRows.Count == 0) { <p class="muted">No reasons yet: in EduNotify, tick a technician call template under Settings → EduHelpdesk, then open this page again.</p> }
                else
                {
                    <p class="muted">Blank uses the category and priorities above.</p>
                    <div class="table-wrap"><table class="stack-table"><thead><tr><th data-stack="head">Reason</th><th>Category</th><th>Priority</th><th>Urgent priority</th></tr></thead><tbody>
                    @foreach (var (row, listed) in Model.ReasonRows)
                    {
                        <tr class="@(listed ? "" : "muted")">
                            <td><input type="hidden" name="reason-template" value="@row.Template" /><input type="hidden" name="reason-reason" value="@row.Reason" />
                                <strong>@(row.Reason.Length > 0 ? row.Reason : "(no reason)")</strong><br /><span class="muted">@row.Template@(listed ? "" : " · no longer in EduNotify")</span></td>
                            <td><select name="reason-category"><option value="">As above</option>@foreach (var c in Model.Categories) { <option selected="@(c == row.Category)">@c</option> }</select></td>
                            <td><select name="reason-priority"><option value="">As above</option>@foreach (var p in Model.Priorities) { <option selected="@(p == row.Priority)">@p</option> }</select></td>
                            <td><select name="reason-urgent"><option value="">As above</option>@foreach (var p in Model.Priorities) { <option selected="@(p == row.UrgentPriority)">@p</option> }</select></td>
                        </tr>
                    }
                    </tbody></table></div>
                }
            </details>
            <div><button class="button button-primary">Save technician calls</button></div>
        </form>
        @if (link.Calls.Count > 0)
        {
            <details><summary>Recent calls</summary>
                <div class="table-wrap"><table class="stack-table"><thead><tr><th data-stack="head">Ticket</th><th>Raised</th><th>By</th></tr></thead><tbody>
                @foreach (var call in link.Calls) { <tr><td><a asp-page="/Job" asp-route-number="@call.TicketNumber">@Helpdesk.Ref(call.TicketNumber)</a></td><td>@call.RaisedAt.ToLocalTime().ToString("ddd d MMM, HH:mm")</td><td>@call.RaisedBy</td></tr> }
                </tbody></table></div>
            </details>
        }
    </section>

    <section class="panel" id="desks">
        <div class="panel-heading"><h2>Desk PCs</h2></div>
        <p class="muted">Each desk's technicians' PCs, as EduNotify groups: the technician ping, and alerts about unassigned tickets, go to these.</p>
        <form method="post" asp-page-handler="SaveDesks" class="settings-form">
            <div class="checkbox-grid">
                @foreach (var desk in Model.Desks)
                {
                    var chosen = Model.Ping.DeskGroups.GetValueOrDefault(desk.Id) ?? [];
                    <div><p class="eyebrow">@desk.Name</p>@foreach (var group in Model.GroupChoices) { <label class="toggle-label"><input type="checkbox" name="deskpcs-@desk.Id" value="@group" checked="@chosen.Contains(group, StringComparer.OrdinalIgnoreCase)" /> @group</label> }@if (Model.GroupChoices.Count == 0) { <p class="empty">No groups yet. Make them in EduNotify under Groups, then use Test the link.</p> }</div>
                }
            </div>
            <div><button class="button button-primary">Save desk PCs</button></div>
        </form>
    </section>

    <section class="panel" id="ping">
        <div class="panel-heading"><h2>Technician ping</h2>@if (Model.Ping.Active) { <span class="badge">On</span> } else { <span class="badge">Off</span> }</div>
        <p class="muted">When a ticket comes in at a ticked priority with nobody assigned, its desk's PCs get a notice saying only the priority and ticket number. It comes down once someone is assigned, the ticket closes, or its priority drops.</p>
        <form method="post" asp-page-handler="SavePing" class="settings-form">
            <label class="toggle-label"><input type="checkbox" name="enabled" value="true" checked="@Model.Ping.Enabled" /> Ping the desk's PCs about new tickets at these priorities</label>
            <div>@foreach (var priority in Model.Priorities) { <label class="toggle-label"><input type="checkbox" name="priorities" value="@priority" checked="@Model.Ping.Priorities.Contains(priority, StringComparer.OrdinalIgnoreCase)" /> @priority</label> }</div>
            <div><button class="button button-primary">Save the ping</button></div>
        </form>
    </section>
}

<section class="panel" id="notices">
    <div class="panel-heading"><h2>Notices showing now</h2><span class="badge">@Model.Notices.Count</span></div>
    @if (Model.Notices.Count == 0)
    {
        <p class="muted">No ticket has a notice on staff PCs. A ticket's <strong>Tell staff</strong> puts one up; it comes down by itself when the ticket closes.</p>
    }
    else
    {
        <div class="table-wrap"><table class="stack-table"><thead><tr><th data-stack="head">Ticket</th><th>Notice</th><th>Sent to</th><th>Sent</th><th></th></tr></thead><tbody>
        @foreach (var notice in Model.Notices)
        {
            <tr>
                <td><a asp-page="/Job" asp-route-number="@notice.TicketNumber">@Helpdesk.Ref(notice.TicketNumber)</a></td>
                <td>@notice.Title<br /><span class="muted">@notice.TemplateName</span></td>
                <td>@notice.Recipients<br /><span class="muted">@notice.Online of @notice.Targeted PCs at first</span></td>
                <td>@notice.SentAt.ToLocalTime().ToString("ddd d MMM, HH:mm")<br /><span class="muted">@notice.SentBy</span></td>
                <td><form method="post" asp-page-handler="Recall" data-confirm="Take the notice for @Helpdesk.Ref(notice.TicketNumber) off staff PCs now?"><input type="hidden" name="number" value="@notice.TicketNumber" /><button class="button button-secondary" disabled="@(!Model.Settings.HasKey)">Recall</button></form></td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

@if (Model.Linked)
{
    <section class="panel" id="advanced">
        <details>
            <summary><strong>Advanced</strong></summary>
            <form method="post" asp-page-handler="SaveAdvanced" class="settings-form" style="margin-top:.75rem">
                <label>Staff email domain<input name="emailDomain" type="text" value="@link.EmailDomain" spellcheck="false" autocomplete="off" maxlength="200" /></label>
                <label>Template for pop-ups and alerts
                    <select name="popupTemplateId">@foreach (var (id, name) in Model.TemplateChoices) { <option value="@id" selected="@(id == link.PopupTemplateId || (link.Events.Values.FirstOrDefault()?.TemplateId == id))">@name</option> }</select>
                </label>
                <label>Template for the technician ping
                    <select name="pingTemplateId">@foreach (var (id, name) in Model.TemplateChoices) { <option value="@id" selected="@(id == Model.Ping.TemplateId)">@name</option> }</select>
                </label>
                <small class="muted">EduNotify made <em>Helpdesk pop-up</em> and <em>Helpdesk ping</em> when pairing; restyle them in EduNotify's Templates, or choose others here (editable ones, so the title and message can be set).</small>
                <div><button class="button button-primary">Save</button></div>
            </form>
            <p class="muted">EduNotify's address: @Model.Settings.Address · the helpdesk's key there was last used @When(health.InAt).</p>
            <form method="post" asp-page-handler="Unlink" data-confirm="Unlink from EduNotify? Notices, pop-ups and technician-call tickets stop until the two are paired again."><button class="button button-secondary">Unlink from EduNotify</button></form>
        </details>
    </section>
}
