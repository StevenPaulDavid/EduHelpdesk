@page
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Settings.RetentionModel
@{
    ViewData["Title"] = "Data retention";
    var rules = Model.Rules;
    var preview = Model.Preview;
    string When(DateTime? cutoff) => cutoff is { } c ? c.ToLocalTime().ToString("d MMM yyyy") : "";
}
<div class="page-heading"><div><p class="eyebrow">SETTINGS / SYSTEM</p><h1>Data retention</h1><p class="hero-copy">How long the helpdesk keeps personal data it no longer needs. Your school's retention schedule sets the numbers; this applies them every night.</p></div><a class="button button-secondary" asp-page="/Settings">← Settings</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="notice">@Model.Message</div> }

<section class="panel">
    <div class="panel-heading"><div><h2>Rules</h2></div><span class="badge">@(rules.AnyOn ? "On" : "Everything is kept")</span></div>
    <p class="muted">Each rule is in months, and 0 switches it off. Rules run each night after the backup, and only once a backup has worked in the last day, so nothing is removed that no backup holds. Backups keep their own copies until they age out (Backups &amp; data), so removed data is gone for good only after that.</p>
    <form method="post" asp-page-handler="Save" class="retention-rules">
        <div class="retention-rule">
            <div>
                <h3>Delete closed tickets</h3>
                <p class="muted">Tickets closed more than this many months ago are deleted: their updates, internal notes, history, attached files and custom fields, and their lines in the audit log. Open tickets are never touched. Ticket numbers are never reused, and reports covering those months will no longer count them.</p>
                <p class="retention-now">@(rules.TicketMonths == 0 ? "Off." : preview.Tickets == 0 ? $"Nothing to delete now (nothing closed before {When(preview.TicketCutoff)})." : $"Would delete {preview.Tickets} ticket{(preview.Tickets == 1 ? "" : "s")} now - closed before {When(preview.TicketCutoff)}.")</p>
            </div>
            <label>Months after closing<input name="ticketMonths" type="number" min="0" max="@HelpdeskStore.MaxRetentionMonths" step="1" value="@rules.TicketMonths" required /></label>
        </div>
        <div class="retention-rule">
            <div>
                <h3>Anonymise people who have left</h3>
                <p class="muted">Requesters marked inactive more than this many months ago lose their name, email, department and location - they become "@HelpdeskStore.AnonymisedName" on their record, their tickets and projects, loans and asset history, and in the audit log. Their tickets and loans stay, so counts and history still add up. Anyone who still holds an asset or kit, or has an open ticket or active project, is left alone until that is sorted out. What other people typed about them in free text on other tickets isn't rewritten.</p>
                <p class="retention-now">@(rules.LeaverMonths == 0 ? "Off." : (preview.People == 0 ? $"Nobody to anonymise now (nobody left before {When(preview.LeaverCutoff)})." : $"Would anonymise {preview.People} {(preview.People == 1 ? "person" : "people")} now - left before {When(preview.LeaverCutoff)}.") + (preview.LeaversWaiting > 0 ? $" {preview.LeaversWaiting} more left that long ago but still hold something - see People, Status: Left, still holding equipment." : ""))</p>
            </div>
            <label>Months after leaving<input name="leaverMonths" type="number" min="0" max="@HelpdeskStore.MaxRetentionMonths" step="1" value="@rules.LeaverMonths" required /></label>
        </div>
        <div class="retention-rule">
            <div>
                <h3>Delete old audit log entries</h3>
                <p class="muted">Audit entries older than this are deleted. At least @HelpdeskStore.MinAuditRetentionMonths months, because the log is how the school shows who changed what. Ticket, asset and project history is kept with the records themselves and isn't affected.</p>
                <p class="retention-now">@(rules.AuditMonths == 0 ? "Off." : preview.AuditEntries == 0 ? $"Nothing to delete now (nothing from before {When(preview.AuditCutoff)})." : $"Would delete {preview.AuditEntries} entr{(preview.AuditEntries == 1 ? "y" : "ies")} now - from before {When(preview.AuditCutoff)}.")</p>
            </div>
            <label>Months to keep<input name="auditMonths" type="number" min="0" max="@HelpdeskStore.MaxRetentionMonths" step="1" value="@rules.AuditMonths" required /></label>
        </div>
        <div><button class="button button-primary" type="submit">Save rules</button></div>
    </form>
</section>

<section class="panel">
    <div class="panel-heading"><div><h2>Last run</h2></div>@if (rules.LastRunAt is { } lastRun) { <span class="badge">@lastRun.ToLocalTime().ToString("ddd d MMM, HH:mm")</span> }</div>
    <p class="muted">@(rules.LastRunAt is null ? "The rules haven't run yet." : rules.LastSummary)</p>
    @if (rules.AnyOn && Model.WaitingForBackup)
    {
        <div class="notice notice-warning">No backup has worked in the last day, so the nightly run is waiting. <a asp-page="/Settings/Backups">Backups &amp; data</a></div>
    }
    @if (rules.AnyOn)
    {
        <form method="post" asp-page-handler="Apply" data-confirm="Apply the retention rules now? A backup is taken first. What the rules remove cannot be undone except by restoring a backup.">
            <button class="button button-secondary" type="submit">Back up, then apply now</button>
        </form>
    }
</section>
