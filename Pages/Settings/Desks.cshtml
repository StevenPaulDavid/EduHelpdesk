@page
@using EduHelpdesk.Services
@model EduHelpdesk.Pages.Settings.DesksModel
@{
    ViewData["Title"] = "Desks";
}
<div class="page-heading"><div><h1>Desks</h1><p class="hero-copy">A desk is a part of the school the helpdesk serves. IT and Facilities are built in - Facilities is the site team's repairs, premises checks and cleaning - and either can be renamed or switched off; you can add desks of your own too. Each has its own categories, teams and people, and its own ticket numbers with their own prefix (FAC-1, FAC-2…). A ticket is on the desk its category belongs to. With more than one desk, the staff portal asks which desk first and the ticket list opens on your own desks.</p></div></div>
@if (TempData["Message"] is string message) { <div class="notice">@message</div> }

@* Asked once, on an install from before Facilities was built in (HelpdeskStore.BuiltInDesks). *@
@if (Model.FacilitiesChoicePending)
{
    <section class="panel facilities-choice">
        <h2>Facilities is now built in</h2>
        <p>The Facilities desk is the site team's: repairs, premises checks and cleaning, with a Facilities menu in the top bar for checks, cleaning rounds, job spend and contractors. Is one of your desks already that?</p>
        <div class="button-row">
            @foreach (var desk in Model.OwnDesks)
            {
                <form method="post" asp-page-handler="Facilities"><input type="hidden" name="choice" value="make" /><input type="hidden" name="id" value="@desk.Id" /><button class="button button-primary" type="submit">Make @desk.Name the Facilities desk</button></form>
            }
            <form method="post" asp-page-handler="Facilities"><input type="hidden" name="choice" value="add" /><button class="button @(Model.OwnDesks.Count == 0 ? "button-primary" : "button-secondary")" type="submit">@Icons.Plus Add a Facilities desk</button></form>
            <form method="post" asp-page-handler="Facilities"><input type="hidden" name="choice" value="later" /><button class="button button-secondary" type="submit">Not now</button></form>
        </div>
        <p class="muted">Making one of your desks Facilities keeps its name, tickets and setup. A new one starts with categories such as Heating &amp; hot water and Plumbing &amp; leaks, a button for each in the staff portal, and the @HelpdeskStore.FacilitiesTeam. Not now leaves it switched off below, ready whenever.</p>
    </section>
}

<section class="panel">
    <div class="panel-heading"><h2>The desks</h2><span class="badge">@Model.Desks.Count</span></div>
    <p class="muted">In the order of the portal's tiles and the ticket list's filter. The first desk is also where a new category starts if nobody chooses one.</p>
    @for (var i = 0; i < Model.Desks.Count; i++)
    {
        var desk = Model.Desks[i];
        var style = Model.StyleFor(desk);
        var icon = PortalLook.FindIcon(style.Icon)!;
        var color = PortalLook.FindColor(style.Color)!;
        var categories = Model.CategoriesOn(desk);
        var teams = Model.TeamsOn(desk);
        <div class="order-row">
            <div class="order-controls">
                @foreach (var (direction, arrow, word, disabled) in new[] { (-1, "↑", "up", i == 0), (1, "↓", "down", i == Model.Desks.Count - 1) })
                {
                    <form method="post" asp-page-handler="Move">
                        <input type="hidden" name="id" value="@desk.Id" /><input type="hidden" name="direction" value="@direction" />
                        <button class="order-button" type="submit" disabled="@disabled" title="Move @word" aria-label="Move @desk.Name @word">@arrow</button>
                    </form>
                }
            </div>
            <details class="template-item">
                <summary>
                    <span class="tile-swatch" style="--tile-color:@color.Hex">@PortalLook.Svg(style.Icon)</span>
                    <strong>@desk.Name</strong>
                    @if (desk.IsBuiltIn) { <span class="badge">@DesksModel.KindLabel(desk)</span> }
                    <span class="badge" title="The number its next ticket gets">Next: @HelpdeskStore.RefFor(desk, desk.NextNumber)</span>
                    <span class="muted">@(categories.Count == 1 ? "1 category" : $"{categories.Count} categories") · @(teams.Count == 1 ? "1 team" : $"{teams.Count} teams") · @(Model.PeopleOn(desk) == 1 ? "1 person" : $"{Model.PeopleOn(desk)} people") · @Model.OpenTicketsOn(desk) open@(desk.ShowInPortal ? "" : " · not in the portal")</span>
                </summary>
                <p class="muted">@(categories.Count == 0 ? "No categories yet." : "Categories: " + string.Join(", ", categories) + ".") @(teams.Count == 0 ? "" : "Teams: " + string.Join(", ", teams) + ".")</p>
                <form method="post" asp-page-handler="Save" class="settings-form">
                    <input type="hidden" name="id" value="@desk.Id" />
                    <div class="template-fields">
                        <label>Name<input name="name" value="@desk.Name" required maxlength="@HelpdeskStore.MaxDeskNameLength" /></label>
                        <label><span>Ticket number prefix <help-tip key="desk.prefix" /></span><input name="prefix" value="@desk.Prefix" maxlength="@HelpdeskStore.MaxDeskPrefixLength" autocapitalize="characters" /><small class="muted">Changing it changes how every ticket on this desk is shown, old ones included.</small></label>
                        <label class="full">Helper line<input name="helperLine" value="@desk.HelperLine" maxlength="@HelpdeskStore.MaxHelperLineLength" /></label>
                        <label class="toggle-label full"><input type="checkbox" name="showInPortal" value="true" checked="@desk.ShowInPortal" /> Offer this desk in the staff portal<small class="muted">Untick for a desk that only takes work logged by its own staff.</small></label>
                    </div>
                    <button class="button button-primary" type="submit">Save desk</button>
                </form>
                <form method="post" asp-page-handler="NextNumber" class="settings-form">
                    <input type="hidden" name="id" value="@desk.Id" />
                    <label>Next ticket number<input name="next" type="number" min="1" step="1" value="@desk.NextNumber" /><small class="muted">The next @desk.Name ticket will be @HelpdeskStore.RefFor(desk, desk.NextNumber). It can be moved on, but not back below a number already used.</small></label>
                    <button class="button button-secondary" type="submit">Save next number</button>
                </form>
                <form method="post" asp-page-handler="Hours" class="settings-form">
                    <input type="hidden" name="id" value="@desk.Id" />
                    <fieldset class="desk-choices"><legend>Working hours for its SLAs <help-tip key="desk.hours" /></legend>
                        <label class="toggle-label"><input type="radio" name="useOwn" value="false" checked="@(!desk.HasOwnHours)" /> The school day (Settings → School day and periods)</label>
                        <label class="toggle-label"><input type="radio" name="useOwn" value="true" checked="@desk.HasOwnHours" /> Its own hours</label>
                    </fieldset>
                    <fieldset class="desk-choices"><legend>Days it works</legend>
                        @foreach (var day in EduHelpdesk.Pages.Settings.DesksModel.Week)
                        {
                            <label class="toggle-label"><input type="checkbox" name="days" value="@day" checked="@(desk.HasOwnHours ? desk.WorkDays.Contains(day) : day is not DayOfWeek.Saturday and not DayOfWeek.Sunday)" /> @day.ToString()[..3]</label>
                        }
                    </fieldset>
                    <label>Times it works<input name="windows" value="@HelpdeskStore.DescribeWindows(desk.WorkWindows)" placeholder="e.g. 06:00-09:00, 15:00-18:00" autocomplete="off" /><small class="muted">With its own hours, minute and hour SLAs count only inside these times, so a spill reported at 17:55 with a 30-minute SLA is due by 06:25 the next working morning. Work-day SLAs use these days, and period SLAs count these times as its periods. Tickets already logged keep their due dates.</small></label>
                    <button class="button button-secondary" type="submit">Save working hours</button>
                </form>
                @* With one desk the whole bar is that desk's, so there is nothing to choose. *@
                @if (Model.Desks.Count > 1)
                {
                    <form method="post" asp-page-handler="Areas" class="settings-form">
                        <input type="hidden" name="id" value="@desk.Id" />
                        <fieldset class="desk-choices"><legend>In the top bar <help-tip key="desk.areas" /></legend>
                            @foreach (var area in DeskAreas.All.Where(x => x.Feature is null || Model.FeatureOn(x.Feature)))
                            {
                                <label class="toggle-label" title="@area.Description"><input type="checkbox" name="areas" value="@area.Key" checked="@HelpdeskStore.DeskUses(desk, area.Key)" /> @area.Label</label>
                            }
                        </fieldset>
                        <p class="muted">What the top bar shows while someone is working on the @desk.Name desk. Tickets, Reports and Settings are always there. Nobody gets a page their role can't open, and nothing is locked away: an unticked area is only out of the bar.</p>
                        <button class="button button-secondary" type="submit">Save top bar</button>
                    </form>
                }
                <form method="post" asp-page-handler="Style" class="tile-style-form">
                    <input type="hidden" name="id" value="@desk.Id" />
                    <fieldset><legend>Portal tile icon</legend>
                        <div class="choice-grid">
                            @foreach (var choice in PortalLook.Icons)
                            {
                                <label class="icon-choice" title="@choice.Label"><input type="radio" name="icon" value="@choice.Key" checked="@(choice.Key == icon.Key)" /><span>@PortalLook.Svg(choice.Key)<span class="visually-hidden">@choice.Label</span></span></label>
                            }
                        </div>
                    </fieldset>
                    <fieldset><legend>Colour</legend>
                        <div class="choice-grid">
                            @foreach (var choice in PortalLook.Colors)
                            {
                                <label class="color-choice" title="@choice.Label"><input type="radio" name="color" value="@choice.Key" checked="@(choice.Key == color.Key)" /><span style="background:@choice.Hex"><span class="visually-hidden">@choice.Label</span></span></label>
                            }
                        </div>
                    </fieldset>
                    <button class="button button-secondary" type="submit">Save tile</button>
                </form>
                @if (desk.IsBuiltIn && Model.Desks.Count > 1)
                {
                    <form method="post" asp-page-handler="SwitchOff" data-confirm="Switch the @desk.Name desk off? Its categories, teams and setup are set aside until you switch it on again.">
                        <input type="hidden" name="id" value="@desk.Id" />
                        <button class="button button-secondary" type="submit">Switch @desk.Name off</button>
                        <small class="muted">For a school that doesn't need it. Only while it has no tickets; everything else is kept for switching it on again.</small>
                    </form>
                }
                else if (!desk.IsBuiltIn && Model.Desks.Count > 1)
                {
                    <form method="post" asp-page-handler="Delete" data-confirm="Delete the @desk.Name desk?">
                        <input type="hidden" name="id" value="@desk.Id" />
                        <button class="button button-danger" type="submit">Delete desk</button>
                        <small class="muted">Only once its categories, teams and own statuses are on another desk.</small>
                    </form>
                }
            </details>
        </div>
    }
</section>

@if (Model.OffDesks.Count > 0)
{
    <section class="panel">
        <div class="panel-heading"><h2>Switched off</h2></div>
        <p class="muted">Built-in desks this school doesn't use. Nothing about them shows anywhere until one is switched on again, with everything it had.</p>
        @foreach (var desk in Model.OffDesks)
        {
            <div class="directory-row">
                <div class="directory-text"><strong>@desk.Name</strong> <span class="badge">@DesksModel.KindLabel(desk)</span><span>@(desk.Kind == DeskKinds.Facilities ? "Repairs, premises checks and cleaning, with the Facilities menu." : "IT support: devices, accounts, network and classroom tech.")</span></div>
                <form method="post" asp-page-handler="SwitchOn"><input type="hidden" name="id" value="@desk.Id" /><button class="button button-secondary" type="submit">Switch @desk.Name on</button></form>
            </div>
        }
    </section>
}

<section class="panel">
    <div class="panel-heading"><h2>Add a desk of your own</h2></div>
    <form method="post" asp-page-handler="Add" class="settings-form">
        <div class="template-fields">
            <label>Name<input name="name" required maxlength="@HelpdeskStore.MaxDeskNameLength" placeholder="e.g. Reprographics" /></label>
            <label><span>Ticket number prefix <help-tip key="desk.prefix" /></span><input name="prefix" maxlength="@HelpdeskStore.MaxDeskPrefixLength" placeholder="e.g. REPRO" autocapitalize="characters" /><small class="muted">Its tickets show as REPRO-1, REPRO-2… Leave blank for #1.</small></label>
            <label>First ticket number<input name="firstNumber" type="number" min="1" step="1" value="1" /><small class="muted">Each desk counts its own tickets. Start higher (1001, say) to keep numbers the same length.</small></label>
            <label class="full">Helper line<input name="helperLine" maxlength="@HelpdeskStore.MaxHelperLineLength" placeholder="A few words under its portal tile, e.g. Printing, copying and binding" /></label>
        </div>
        <button class="button button-primary" type="submit">@Icons.Plus Add desk</button>
    </form>
    <p class="muted">Then give it its categories in <a asp-page="/Settings/Categories">Categories</a> and its teams in <a asp-page="/Settings/Teams">Teams</a>, and add people to it on their technician account in People.</p>
</section>
